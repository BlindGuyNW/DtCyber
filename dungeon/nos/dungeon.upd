     434,0,512, 12,17526,25091,-1,-1,16502,25098,-1,-1,16525,9734,32,0, 
     511,17531,31232,64,0,24713,25088,64,0,22530,8,0, 7,24668,8192,-1,-1
     6,30722,4,0, 31,119,16504,24579,-1,-1,16537,25096,-1,-1,16536,24581
     7,-1,-1,16536,24590,-1,-1,24676,24579,-1,-1,25090,-1,-1,24676,24579
     8,-1,-1,25102,-1,-1, 4,28773,25090,8,0, 4,16506,8192,-1,-1, 8,17530
     9,8704,-1,-1,16506,8714,-1,-1, 5,21642,28810,18434,-1,-1, 11,17533,
     125088,4224,0,24701,25088,4224,0,22530,4,512, 4,16516,25095,8192,32
     2, 4,28778,25090,-1,-1/
C
      DATA (VWORD(I),I=173,212) /
     1 '*BREAK','JAB','*POUR','SPILL',
     2 'PUMP','*PUT','*INSERT','*STUFF',
     3 'PLACE','*RAISE','LIFT','*READ',
     4 'SKIM','*STRIKE','BLIND','*SWING',
     5 'THRUST','*TAKE','*HOLD','*CARRY',
     6 'REMOVE','*TELL','*COMMAND','REQUEST',
     7 '*THROW','*HURL','CHUCK','*TIE',
     8 'FASTEN','*TURN','SET','UNLOCK',
     9 '*WAKE','*ALARM','*STARTLE','SURPRISE',
     1 '*WAVE','*FLAUNT','BRANDISH','WIND'/
C
      DATA (VVOC(I),I=451,654) / 7,24714,8704,0,128,18434,0,512, 25,1755
     15,16896,-1,-1,24723,16896,-1,-1,25093,-1,-1,24723,16896,-1,-1,2510
     22,-1,-1,24736,16896,-1,-1,25098,-1,-1, 4,24730,24583,-1,-1, 16,298
     340,25093,-1,-1,28816,25102,-1,-1,16529,25094,-1,-1,28833,25096,-1,
     4-1, 5,21613,16493,25095,-1,-1, 18,17508,29184,16384,0,24676,29184,
     516384,0,25090,-1,-1,24676,29184,16384,0,25102,-1,-1, 12,24717,9728
     6,32,0,18434,0,512,17549,9728,32,0,20603, 7,24716,18432,0,512,8707,
     70,128, 11,17540,25088,8192,32,24708,25088,8192,0,25101,-1,-1, 4,16
     8527,8192,0,1024, 21,25748,18432,-1,-1,8707,32,0,24724,18432,-1,-1,
     98718,32,0,24720,18432,-1,-1,25093,-1,-1, 11,28786,25092,-1,-1,2469
     11,8711,32,0,27138,4,0, 22,25716,25088,2,0,26626,4,0,16507,31242,64
     2,0,16508,31243,64,0,24735,25088,2,0,8196,-1,-1, 7,24669,8704,-1,-1
     3,30722,4,0, 8,17512,8192,32,0,16488,8199,32,0, 4,16492,16384,-1,-1
     4, 5,20635,16539,25095,-1,-1/
C
      DATA (VWORD(I),I=213,240)/
     1 'ENTER','LEAVE','*MAKE','BUILD',
     2 '*OIL','*GREASE','LUBRICAT','PLAY',
     3 'SEND','SLIDE','*SMELL','SNIFF',
     4 'SQUEEZE','GET',14*' '/
C
      DATA (VVOC(I),I=655,721) /
     1 2,167,20566,2,168,20624,1,20643,
     2 4,28836,16898,-1,-1,
     3 5,20645,28837,31232,4,0,
     4 4,16550,25100,-1,-1,
     5 4,28833,25096,-1,-1,1,20549,
     6 1,20548,19,17540,25088,8192,32,
     716514,8709,0,2,16515,8717,0,2,
     824708,25088,8192,32,25101,-1,-1,
     9 14*0/
C SPARSE, PAGE 7
C
C SET UP FOR PARSING
C
      SPARSE=-1
      ADJ=0
      ACT=0
      PREP=0
      PPTR=0
      OBJ1=0
      OBJ2=0
      PREP1=0
      PREP2=0
      LOBJ=0
      ANDFLG=.FALSE.
      BUNFLG=.FALSE.
      DFLAG=(PRSFLG.AND.4).NE.0
C SPARSE, PAGE 8
C
C NOW LOOP OVER INPUT BUFFER OF LEXICAL TOKENS.
C
      I=0
   10 I=I+1
        WORD=LBUF(I)
        ERRVOC=0
        IF(WORD.EQ.' ') GO TO 1000
        IF(WORD.EQ.'AND') GO TO 1500
        IF((WORD.EQ.'EXCEPT').OR.(WORD.EQ.'BUT')) GO TO 2500
C
C CHECK FOR BUZZ WORD
C
        DO 50 J=1,BWMAX
          IF(WORD.EQ.BWORD(J)) GO TO 1000
   50   CONTINUE
C
C CHECK FOR ACTION OR DIRECTION
C
        J=1
        DO 70 K=1,VWMAX
          IF(VWORD(K)(1:1).EQ.'*') GO TO 65
          IF(WORD.EQ.VWORD(K)) GO TO 2000
          J=J+VVOC(J)+1
          GO TO 70
   65     IF(WORD.EQ.VWORD(K)(2:WRDLNT)) GO TO 2000
   70   CONTINUE
C
   75   IF((ADJ.NE.0).OR.(PREP.NE.0).OR.(OBJ1.NE.0)) GO TO 200
        IF(ACT.EQ.0) GO TO 80
        IF((VVOC(ACT+1).AND.SVMASK).NE.WALKW) GO TO 200
   80   DO 100 J=1,DWMAX
          IF(WORD.EQ.DWORD(J)) GO TO 3000
  100   CONTINUE
C
C NOT AN ACTION, CHECK FOR PREPOSITION, ADJECTIVE, OR OBJECT.
C
  200   DO 250 J=1,PWMAX
          IF(WORD.EQ.PWORD(J)) GO TO 4000
  250   CONTINUE
C
        J=1
        DO 350 K=1,AWMAX
          IF(WORD.EQ.AWORD(K)) GO TO 5000
  300     J=J+1
          IF(AVOC(J).LT.0) GO TO 300
  350   CONTINUE
C
  400   J=1
        DO 550 K=1,OWMAX
          IF(WORD.EQ.OWORD(K)) GO TO 6000
  500     J=J+1
          IF(OVOC(J).LT.0) GO TO 500
  550   CONTINUE
C
C NOT RECOGNIZABLE
C
        IF(.NOT.VBFLAG) RETURN
        LCWORD=LCIFY(WORD,1)
        WRITE(OUTCH,600) LCWORD(1:NBLEN(LCWORD))
  600   FORMAT(' I DON''T UNDERSTAND "',A,'".')
        CALL RSPEAK(ERRVOC)
  800   TELFLG=.TRUE.
        BUNSUB=0
        RETURN
C SPARSE, PAGE 9
C
 1000 IF(I.LT.LLNT) GO TO 10
C
C AT END OF PARSE, CHECK FOR:
C 1. DANGLING ADJECTIVE
C 2. BUNCHED OBJECT
C 3. SIMPLE DIRECTIONS
C 4. ORPHAN PREPOSITION
C 5. DANGLING PREPOSITION
C
      IF(ADJ.NE.0) GO TO 4500
      IF(BUNFLG) OBJ1=BUNOBJ
      IF(BUNFLG.AND.(BUNSUB.NE.0).AND.(BUNLNT.EQ.0))
     1GO TO 13200
      IF(ACT.EQ.0) ACT=OFLAG.AND.OACT
      IF(ACT.EQ.0) GO TO 10000
      IF(((VVOC(ACT+1).AND.SVMASK).NE.WALKW).OR.(OBJ1.LT.XMIN))
     1GO TO 1100
      IF ((OBJ2.NE.0).OR.(PREP1.NE.0).OR.(PREP2.NE.0))
     1GO TO 1050
      PRSA=WALKW
      PRSO=OBJ1
      SPARSE=1
      RETURN
C
 1050 IF(VBFLAG) CALL RSPEAK(618)
      GO TO 800
C
 1100 IF((OFLAG.NE.0).AND.(OPREP.NE.0).AND.(PREP.EQ.0).AND.
     1(OBJ1.NE.0).AND.(OBJ2.EQ.0).AND.(ACT.EQ.OACT))
     2GO TO 11000
C
      IF(PREP.EQ.0) GO TO 1200
      IF(PPTR.EQ.0) GO TO 12000
      IF(PRPVEC(PPTR).NE.0) GO TO 12000
      PRPVEC(PPTR)=PREP
 1200 SPARSE=0
      IF(DFLAG) PRINT 1310,ACT,OBJ1,OBJ2,PREP1,PREP2
 1310 FORMAT(' SPARSE RESULTS- ',5I7)
      RETURN
C SPARSE, PAGE 10
C
C 1500-- AND
C
 1500 IF(ADJ.NE.0) GO TO 4100
      IF((PREP.NE.0).OR.(PPTR.NE.1)) GO TO 8000
      ANDFLG=.TRUE.
      GO TO 1000
C
C 2000-- ACTION
C
 2000 IF(ACT.EQ.0) GO TO 2100
      ERRVOC=624
      GO TO 75
C
 2100 ACT=J
      OACT=0
      ANDFLG=.FALSE.
      IF(DFLAG) PRINT 2020,J
 2020 FORMAT(' SPARSE- ACT AT ',I6)
      GO TO 1000
C
C 2500-- EXCEPT/BUT
C
 2500 IF(ANDFLG.OR.BUNFLG.OR.(PPTR.NE.1).OR.(ADJ.NE.0).OR.
     1(I.GE.LLNT)) GO TO 13000
      IF(LBUF(I+1).NE.'FOR') GO TO 2600
      I=I+1
      IF(I.GE.LLNT) GO TO 13000
 2600 IF((OBJ1.NE.EVERY).AND.(OBJ1.NE.VALUA).AND.
     1  (OBJ1.NE.POSSE)) GO TO 13100
      ANDFLG=.TRUE.
      BUNFLG=.TRUE.
      BUNLNT=0
      BUNSUB=OBJ1
      GO TO 1000
C
C 3000-- DIRECTION
C   DON'T NEED TO CHECK FOR AMBIGUOUS USE AS ADJECTIVE;
C  ONLY POSSIBLE OVERLAP IS NORTH/SOUTH/EAST/WEST WALL;
C  AND GLOBAL WALL TAKES IS FOUND IF NO ADJECTIVE GIVEN.
C
 3000 OBJ=DVOC(J)
      ACT=1
 3600 IF(VVOC(ACT).EQ.0) CALL BUG(310,ACT)
      IF((VVOC(ACT+1).AND.SVMASK).EQ.WALKW) GO TO 6300
      ACT=ACT+VVOC(ACT)+1
      GO TO 3600
C
C 4000-- PREPOSITION (OR DANGLING ADJECTIVE AT END OF PARSE)
C
 4000 IF(ADJ.EQ.0) GO TO 4600
 4100 I=I-1
 4500 WORD=AWORD(ADJPTR)
      ADJ=0
      GO TO 400
C
 4600 IF(ANDFLG) GO TO 8000
      IF(PREP.NE.0) GO TO 1000
      PREP=PVOC(J)
      IF(DFLAG) PRINT 4030,J
 4030 FORMAT(' SPARSE- PREP AT ',I6)
      GO TO 1000
C
C 5000-- ADJECTIVE
C
 5000 ADJ=J
      ADJPTR=K
      IF((I.LT.LLNT).OR.(OFLAG.EQ.0).OR.(ONAME.EQ.' '))
     1GO TO 1000
      IF(DFLAG) PRINT 5040,ADJ,ONAME
 5040 FORMAT(' SPARSE- ADJ AT ',I6,' ORPHAN= ',A)
      WORD=ONAME
      GO TO 400
C
C 6000-- OBJECT
C
 6000 OBJ=GETOBJ(J,ADJ,0)
      IF(DFLAG) PRINT 6010,J,OBJ
 6010 FORMAT(' SPARSE- OBJ AT ',I6,'  OBJ= ',I6)
      IF(OBJ.LE.0) GO TO 7000
      IF(OBJ.NE.ITOBJ) GO TO 6100
      OBJ=GETOBJ(0,0,LASTIT)
      IF(OBJ.LE.0) GO TO 7000
C
 6100 IF(PREP.NE.9) GO TO 6200
      IF((LOBJ.EQ.OBJ).OR.(LOBJ.EQ.OCAN(OBJ))) GO TO 6500
      IF((LOBJ.EQ.EVERY).AND.((OBJ.EQ.VALUA).OR.(OBJ.EQ.POSSE)))
     1GO TO 6350
 6150 IF(VBFLAG) CALL RSPEAK(601)
      GO TO 800
C
 6200 IF(.NOT.ANDFLG) GO TO 6300
      IF(BUNFLG) GO TO 6250
      BUNVEC(1)=OBJVEC(PPTR)
      BUNLNT=1
      BUNFLG=.TRUE.
      BUNSUB=0
 6250 BUNLNT=BUNLNT+1
      IF(BUNLNT.GT.BUNMAX) GO TO 9000
      BUNVEC(BUNLNT)=OBJ
      GO TO 6500
C
 6300 IF(PPTR.EQ.2) GO TO 9000
      PPTR=PPTR+1
      PRPVEC(PPTR)=PREP
 6350 OBJVEC(PPTR)=OBJ
 6500 PREP=0
      ADJ=0
      ANDFLG=.FALSE.
      LOBJ=OBJ
      GO TO 1000
C SPARSE, PAGE 11
C
C 7000-- UNIDENTIFIABLE OBJECT (INDEX INTO OVOC IS J)
C
 7000 LCWORD=LCIFY(WORD,1)
      LCWRD1=' '
      IF(ADJ.NE.0) LCWRD1=' '//LCIFY(AWORD(ADJPTR),1)//' '
      IF(OBJ.LT.0) GO TO 7200
      IF(LIT(HERE)) GO TO 7100
      IF(VBFLAG) CALL RSPEAK(579)
      GO TO 800
C
 7100 IF(VBFLAG) WRITE(OUTCH,7110)
     1LCWRD1(1:NBLEN(LCWRD1)+1),LCWORD(1:NBLEN(LCWORD))
 7110 FORMAT(' I CAN''T SEE ANY',A,A,' HERE.')
      GO TO 800
C
 7200 IF(OBJ.NE.-10000) GO TO 7300
      IF(VBFLAG) CALL RSPSUB(620,ODESC2(AVEHIC(WINNER)))
      GO TO 800
C
 7300 IF(ACT.EQ.0) ACT=OFLAG.AND.OACT
      CALL ORPHAN(-1,ACT,PREP1,OBJ1,PREP,WORD,0,0)
      IF(VBFLAG) WRITE(OUTCH,7310)
     1LCWRD1(1:NBLEN(LCWRD1)+1),LCWORD(1:NBLEN(LCWORD))
 7310 FORMAT(' WHICH',A,A,' DO YOU MEAN?')
      GO TO 800
C
C 8000-- MISPLACED 'AND'.
C
 8000 IF(VBFLAG) CALL RSPEAK(1049)
      GO TO 800
C
C 9000-- TOO MANY OBJECTS.
C
 9000 IF(VBFLAG) CALL RSPEAK(617)
      GO TO 800
C
C 10000-- NO ACTION, PUNT.
C
10000 IF(OBJ1.EQ.0) GO TO 10100
      IF(VBFLAG) CALL RSPSUB(621,ODESC2(OBJ1))
      CALL ORPHAN(-1,0,PREP1,OBJ1,0,' ',0,0)
      RETURN
C
10100 IF(VBFLAG) CALL RSPEAK(622)
      GO TO 800
C
C 11000-- ORPHAN PREPOSITION.  CONDITIONS ARE
C  OBJ1.NE.0, OBJ2=0, PREP=0, ACT=OACT
C
11000 IF(OOBJ1.NE.0) GO TO 11500
      PREP1=OPREP
      GO TO 1200
C
11500 OBJ2=OBJ1
      PREP2=OPREP
      OBJ1=OOBJ1
      PREP1=OPREP1
      GO TO 1200
C
C 12000-- TRUE HANGING PREPOSITION, NO OBJECTS YET.
C
12000 CALL ORPHAN(-1,ACT,0,0,PREP,' ',0,0)
      GO TO 1200
C
C 13000-- EXCEPT/BUT ERRORS.
C
13000 LCWORD=LCIFY(WORD,1)
      IF(VBFLAG) WRITE(OUTCH,13010) LCWORD(1:NBLEN(LCWORD))
13010 FORMAT(' MISPLACED "',A,'".')
      GO TO 800
C
13100 LCWORD=LCIFY(WORD,2)
      IF(VBFLAG) WRITE(OUTCH,13110) LCWORD(1:NBLEN(LCWORD))
13110 FORMAT(' "',A,'" CAN ONLY BE USED WITH "EVERYTHING", "VALUABLES",
     1OR "POSSESSIONS".')
      GO TO 800
C
13200 IF(VBFLAG) CALL RSPEAK(619)
      GO TO 800
C
      END
C GETOBJ-- FIND OBJ DESCRIBED BY ADJ, NAME PAIR
C
C DECLARATIONS
C
C THIS ROUTINE DETAILS ON BIT 3 OF PRSFLG
C
      INTEGER FUNCTION GETOBJ(OIDX,AIDX,SPCOBJ)
      IMPLICIT INTEGER(A-Z)
*CALL DPARAM
      LOGICAL THISIT,GHERE,LIT,CHOMP,DFLAG,NOADJS
C
      DFLAG=(PRSFLG.AND.8).NE.0
      CHOMP=.FALSE.
      AV=AVEHIC(WINNER)
      OBJ=0
      IF(.NOT.LIT(HERE)) GO TO 200
C
      OBJ=SCHLST(OIDX,AIDX,HERE,0,0,SPCOBJ)
      IF(DFLAG) PRINT 10,OBJ
   10 FORMAT(' SCHLST- ROOM SCH ',I6)
      IF(OBJ) 1000,200,100
  100 IF((AV.EQ.0).OR.(AV.EQ.OBJ).OR.(OCAN(OBJ).EQ.AV).OR.
     1((OFLAG2(OBJ).AND.FINDBT).NE.0)) GO TO 200
      CHOMP=.TRUE.
C
  200 IF(AV.EQ.0) GO TO 400
      NOBJ=SCHLST(OIDX,AIDX,0,AV,0,SPCOBJ)
      IF(DFLAG) PRINT 220,NOBJ
  220 FORMAT(' SCHLST- VEH SCH  ',I6)
      IF(NOBJ) 800,400,300
  300 CHOMP=.FALSE.
      IF(OBJ.EQ.NOBJ) GO TO 400
      IF(OBJ.NE.0) NOBJ=-NOBJ
      OBJ=NOBJ
C
  400 NOBJ=SCHLST(OIDX,AIDX,0,0,WINNER,SPCOBJ)
      IF(DFLAG) PRINT 430,NOBJ
  430 FORMAT(' SCHLST- ADV SCH  ',I6)
      IF(NOBJ) 800,900,500
  500 IF(OBJ.EQ.0) GO TO 800
      IF(AIDX.NE.0) GO TO 600
      IF(NOADJS(OBJ).NEQV.NOADJS(NOBJ)) GO TO 700
  600 OBJ=-NOBJ
      GO TO 900
  700 IF(NOADJS(OBJ)) GO TO 900
  800 OBJ=NOBJ
  900 IF(CHOMP) OBJ=-10000
 1000 GETOBJ=OBJ
C
      IF(GETOBJ.NE.0) GO TO 1500
      DO 1200 I=STRBIT+1,OLNT
        IF(.NOT.THISIT(OIDX,AIDX,I,SPCOBJ)) GO TO 1200
        IF(.NOT.GHERE(I,HERE)) GO TO 1200
        IF(GETOBJ.EQ.0) GO TO 1150
        IF(AIDX.NE.0) GO TO 1050
        IF(NOADJS(GETOBJ).NEQV.NOADJS(I)) GO TO 1100
 1050   GETOBJ=-I
        GO TO 1200
 1100   IF(NOADJS(GETOBJ)) GO TO 1200
 1150   GETOBJ=I
 1200 CONTINUE
C
 1500 CONTINUE
      IF(DFLAG) PRINT 1540,GETOBJ
 1540 FORMAT(' SCHLST- RESULT   ',I6)
      RETURN
      END
C SCHLST-- SEARCH FOR OBJECT
C
C DECLARATIONS
C
      INTEGER FUNCTION SCHLST(OIDX,AIDX,RM,CN,AD,SPCOBJ)
      IMPLICIT INTEGER(A-Z)
*CALL DPARAM
      LOGICAL THISIT,QHERE,NOTRAN,NOVIS,AEMPTY,NOADJS
C
C FUNCTIONS AND DATA
C
      NOTRAN(O)=((OFLAG1(O).AND.TRANBT).EQ.0).AND.
     1((OFLAG2(O).AND.OPENBT).EQ.0)
      NOVIS(O)=((OFLAG1(O).AND.VISIBT).EQ.0)
C
      SCHLST=0
      AEMPTY=.FALSE.
      DO 1000 I=1,OLNT
        IF(NOVIS(I).OR.
     1(((RM.EQ.0).OR.(.NOT.QHERE(I,RM))).AND.
     2 ((CN.EQ.0).OR.(OCAN(I).NE.CN)).AND.
     3 ((AD.EQ.0).OR.(OADV(I).NE.AD)))) GO TO 1000
        IF(.NOT.THISIT(OIDX,AIDX,I,SPCOBJ)) GO TO 200
        IF(SCHLST.EQ.0) GO TO 150
        IF(AIDX.NE.0) GO TO 2000
        IF(NOADJS(I)) GO TO 100
        AEMPTY=.TRUE.
        GO TO 200
  100   IF(NOADJS(SCHLST)) GO TO 2000
  150   SCHLST=I
C
C IF OPEN OR TRANSPARENT, SEARCH THE OBJECT ITSELF.
C
  200   IF(NOTRAN(I)) GO TO 1000
C
C SEARCH IS CONDUCTED IN REVERSE.  ALL OBJECTS ARE CHECKED TO
C SEE IF THEY ARE AT SOME LEVEL OF CONTAINMENT INSIDE OBJECT 'I'.
C IF THEY ARE AT LEVEL 1, OR IF ALL LINKS IN THE CONTAINMENT
C CHAIN ARE OPEN, VISIBLE, AND HAVE SEARCHME SET, THEY CAN QUALIFY
C AS A POTENTIAL MATCH.
C
        DO 500 J=1,OLNT
          IF(NOVIS(J).OR. (.NOT.THISIT(OIDX,AIDX,J,SPCOBJ)))
     1GO TO 500
          X=OCAN(J)
  300     IF(X.EQ.I) GO TO 400
          IF(X.EQ.0) GO TO 500
          IF(NOVIS(X).OR.NOTRAN(X).OR.
     1((OFLAG2(X).AND.SCHBT).EQ.0)) GO TO 500
          X=OCAN(X)
          GO TO 300
C
  400     IF(SCHLST.EQ.0) GO TO 450
          IF(AIDX.NE.0) GO TO 2000
          IF(NOADJS(J)) GO TO 425
          AEMPTY=.TRUE.
          GO TO 500
  425     IF(NOADJS(SCHLST)) GO TO 2000
  450     SCHLST=J
  500   CONTINUE
C
 1000 CONTINUE
      IF(.NOT.AEMPTY.OR.(SCHLST.EQ.0)) RETURN
      IF(NOADJS(SCHLST)) RETURN
 2000 SCHLST=-SCHLST
      RETURN
C
      END
C THISIT-- VALIDATE OBJECT VS DESCRIPTION
C
C DECLARATIONS
C
      LOGICAL FUNCTION THISIT(OIDX,AIDX,OBJ,SPCOBJ)
      IMPLICIT INTEGER(A-Z)
*CALL DPARAM
C
      THISIT=.FALSE.
      IF((SPCOBJ.NE.0).AND.(OBJ.EQ.SPCOBJ)) GO TO 500
C
C CHECK FOR OBJECT NAMES
C
      I=OIDX
  100 IF(IABS(OVOC(I)).EQ.OBJ) GO TO 200
      I=I+1
      IF(OVOC(I).LT.0) GO TO 100
      RETURN
C
  200 IF(AIDX.EQ.0) GO TO 500
      I=AIDX
  300 IF(IABS(AVOC(I)).EQ.OBJ) GO TO 500
      I=I+1
      IF(AVOC(I).LT.0) GO TO 300
      RETURN
C
  500 THISIT=.TRUE.
      RETURN
      END
C SYNMCH-- SYNTAX MATCHER
C
C DECLARATIONS
C
C THIS ROUTINE DETAILS ON BIT 4 OF PRSFLG
C
      LOGICAL FUNCTION SYNMCH(X)
      IMPLICIT INTEGER(A-Z)
*CALL DPARAM
      LOGICAL SYNEQL,TAKEIT,DFLAG
      CHARACTER*(TEXLNT) STR
      CHARACTER*(WRDLNT) FINDVB,FINDPR,LCIFY,LCWORD
      CHARACTER*(WRDLNT+2) LCPRP1,LCPRP2
C
      SYNMCH=.FALSE.
      DFLAG=(PRSFLG.AND.16).NE.0
      J=ACT
      DRIVE=0
      DFORCE=0
      QPREP=OFLAG.AND.OPREP
      LIMIT=J+VVOC(J)+1
      J=J+1
C
  200 CALL UNPACK(J,NEWJ)
      IF(DFLAG) PRINT 260,OBJ1,PREP1,DOBJ,DFL1,DFL2
  260 FORMAT(' SYNMCH INPUTS TO SYNEQL- ',5I7)
      SPREP=DOBJ.AND.VPMASK
      IF(SYNEQL(PREP1,OBJ1,DOBJ,DFL1,DFL2)) GO TO 1000
C
C DIRECT SYNTAX MATCH FAILS.
C
      IF((OBJ2.NE.0).OR.(.NOT.SYNEQL(PREP1,OBJ1,IOBJ,IFL1,IFL2)))
     1GO TO 500
      OBJ2=OBJ1
      PREP2=PREP1
      OBJ1=0
      PREP1=0
  500 IF(OBJ1.NE.0) GO TO 3000
      GO TO 2500
C
 1000 IF(DFLAG) PRINT 260,OBJ2,PREP2,IOBJ,IFL1,IFL2
      SPREP=IOBJ.AND.VPMASK
      IF(SYNEQL(PREP2,OBJ2,IOBJ,IFL1,IFL2)) GO TO 6000
C
C INDIRECT SYNTAX MATCH FAILS.
C
      IF(OBJ2.NE.0) GO TO 3000
 2500 IF((QPREP.EQ.0).OR.(QPREP.EQ.SPREP)) DFORCE=J
      IF((VFLAG.AND.SDRIV).NE.0) DRIVE=J
 3000 J=NEWJ
      IF(J.LT.LIMIT) GO TO 200
C SYNMCH, PAGE 2
C
C MATCH HAS FAILED.  IF DEFAULT SYNTAX EXISTS, TRY TO SNARF
C ORPHANS OR GWIMS, OR MAKE NEW ORPHANS.
C
      IF(DFLAG) PRINT 3020,DRIVE,DFORCE,OBJ1,OBJ2
 3020 FORMAT(' SYNMCH, DRIVE=',2I6,'  OBJECTS =',2I6)
      IF(DRIVE.EQ.0) DRIVE=DFORCE
      IF(DRIVE.EQ.0) GO TO 10000
      CALL UNPACK(DRIVE,DFORCE)
      LCWORD=LCIFY(FINDVB(DRIVE),2)
      LCPRP1=' '//LCIFY(FINDPR(DOBJ.AND.VPMASK),1)//' '
      LCPRP2=' '//LCIFY(FINDPR(IOBJ.AND.VPMASK),1)//' '
C
C TRY TO FILL DIRECT OBJECT SLOT IF THAT WAS THE PROBLEM.
C
      IF(((VFLAG.AND.SDIR).EQ.0).OR.(OBJ1.NE.0)) GO TO 4000
      OBJ1=OFLAG.AND.OOBJ1
      IF(OBJ1.EQ.0) GO TO 3500
      IF(SYNEQL(OPREP1,OBJ1,DOBJ,DFL1,DFL2)) GO TO 4000
C
C ORPHAN FAILS, TRY GWIM.
C
 3500 OBJ1=GWIM(DOBJ,DFW1,DFW2)
      IF(DFLAG) PRINT 3530,OBJ1
 3530 FORMAT(' SYNMCH- DO GWIM= ',I6)
      IF(OBJ1.GT.0) GO TO 4000
      CALL ORPHAN(-1,ACT,0,0,DOBJ.AND.VPMASK,' ',PREP2,OBJ2)
      BUNSUB=0
      IF(OBJ2.GT.0) GO TO 3800
 3700 WRITE(OUTCH,3750)
     1LCWORD(1:NBLEN(LCWORD)),LCPRP1(1:NBLEN(LCPRP1)+1)
 3750 FORMAT(1X,A,A,'WHAT?')
      TELFLG=.TRUE.
      RETURN
C
 3800 X=IABS(ODESC2(OBJ2))
      STR=' '
      IF(X.LE.TXLNT) STR=TXLINE(X)
      WRITE(OUTCH,3880) LCWORD(1:NBLEN(LCWORD)),
     1LCPRP1(1:NBLEN(LCPRP1)+1),
     2LCPRP2(1:NBLEN(LCPRP2)+1),STR(1:NBLEN(STR))
 3880 FORMAT(1X,A,A,'WHAT',A,'THE ',A,'?')
      TELFLG=.TRUE.
      RETURN
C SYNMCH, PAGE 3
C
C TRY TO FILL INDIRECT OBJECT SLOT IF THAT WAS THE PROBLEM.
C
 4000 IF(((VFLAG.AND.SIND).EQ.0).OR.(OBJ2.NE.0)) GO TO 6000
      OBJ2=OFLAG.AND.OOBJ2
      IF(OBJ2.EQ.0) GO TO 4500
      IF(SYNEQL(OPREP2,OBJ2,IOBJ,IFL1,IFL2)) GO TO 6000
C
C ORPHAN FAILS, TRY GWIM.
C
 4500 OBJ2=GWIM(IOBJ,IFW1,IFW2)
      IF(DFLAG) PRINT 4550,OBJ2
 4550 FORMAT(' SYNMCH- IO GWIM= ',I6)
      IF(OBJ2.GT.0) GO TO 6000
      IF(OBJ1.GT.0) GO TO 4600
      CALL ORPHAN(-1,ACT,OFLAG.AND.OPREP1,
     1OFLAG.AND.OOBJ1,IOBJ.AND.VPMASK,' ',0,0)
      GO TO 3700
C
C ERROR WITH DIRECT OBJECT AVAILABLE.
C
 4600 CALL ORPHAN(-1,ACT,PREP1,OBJ1,IOBJ.AND.VPMASK,' ',0,0)
      X=IABS(ODESC2(OBJ1))
      STR=' '
      IF(X.LE.TXLNT) STR=TXLINE(X)
      WRITE(OUTCH,4660) LCWORD(1:NBLEN(LCWORD)),
     1LCPRP1(1:NBLEN(LCPRP1)+1),
     2STR(1:NBLEN(STR)),LCPRP2(1:NBLEN(LCPRP2)+1)
 4660 FORMAT(1X,A,A,'THE ',A,A,'WHAT?')
      TELFLG=.TRUE.
      RETURN
C
C TOTAL CHOMP.
C
10000 CALL RSPEAK(601)
      BUNSUB=0
      RETURN
C SYNMCH, PAGE 3
C
C NOW TRY TO TAKE INDIVIDUAL OBJECTS AND
C IN GENERAL CLEAN UP THE PARSE VECTOR.
C
 6000 IF((VFLAG.AND.SFLIP).EQ.0) GO TO 7000
      J=OBJ1
      OBJ1=OBJ2
      OBJ2=J
C
 7000 PRSA=VFLAG.AND.SVMASK
      PRSO=OBJ1
      PRSI=OBJ2
      IF(.NOT.TAKEIT(PRSO,DOBJ)) RETURN
      IF(.NOT.TAKEIT(PRSI,IOBJ)) RETURN
      SYNMCH=.TRUE.
      IF(DFLAG) PRINT 7050,SYNMCH,PRSA,PRSO,PRSI,ACT,OBJ1,OBJ2
 7050 FORMAT(' SYNMCH- RESULTS ',L1,6I7)
      RETURN
C
      END
C UNPACK- UNPACK SYNTAX SPECIFICATION, ADV POINTER
C
C DECLARATIONS
C
      SUBROUTINE UNPACK(OLDJ,J)
      IMPLICIT INTEGER(A-Z)
*CALL DPARAM
C
      DO 10 I=1,11
        SYN(I)=0
   10 CONTINUE
C
      VFLAG=VVOC(OLDJ)
      J=OLDJ+1
      IF((VFLAG.AND.SDIR).EQ.0) RETURN
      DFL1=-1
      DFL2=-1
      IF((VFLAG.AND.SSTD).EQ.0) GO TO 100
      DFW1=-1
      DFW2=-1
      DOBJ=VABIT+VRBIT+VFBIT
      GO TO 200
C
  100 DOBJ=VVOC(J)
      DFW1=VVOC(J+1)
      DFW2=VVOC(J+2)
      J=J+3
      IF((DOBJ.AND.VEBIT).EQ.0) GO TO 200
      DFL1=DFW1
      DFL2=DFW2
C
  200 IF((VFLAG.AND.SIND).EQ.0) RETURN
      IFL1=-1
      IFL2=-1
      IOBJ=VVOC(J)
      IFW1=VVOC(J+1)
      IFW2=VVOC(J+2)
      J=J+3
      IF((IOBJ.AND.VEBIT).EQ.0) RETURN
      IFL1=IFW1
      IFL2=IFW2
      RETURN
C
      END
C SYNEQL- TEST FOR SYNTAX EQUALITY
C
C DECLARATIONS
C
      LOGICAL FUNCTION SYNEQL(PREP,OBJ,SPREP,SFL1,SFL2)
      IMPLICIT INTEGER(A-Z)
*CALL DPARAM
C
      IF(OBJ.EQ.0) GO TO 100
      SYNEQL=(PREP.EQ.(SPREP.AND.VPMASK)).AND.
     1(((SFL1.AND.OFLAG1(OBJ)).OR.
     2  (SFL2.AND.OFLAG2(OBJ))).NE.0)
      RETURN
C
  100 SYNEQL=(PREP.EQ.0).AND.(SFL1.EQ.0).AND.(SFL2.EQ.0)
      RETURN
C
      END
C TAKEIT- PARSER BASED TAKE OF OBJECT
C
C DECLARATIONS
C
      LOGICAL FUNCTION TAKEIT(OBJ,SFLAG)
      IMPLICIT INTEGER(A-Z)
*CALL DPARAM
      LOGICAL TAKE,LIT
C
      TAKEIT=.FALSE.
      IF((OBJ.EQ.0).OR.(OBJ.GT.STRBIT).OR.DEADF)
     1GO TO 4000
      ODO2=ODESC2(OBJ)
      X=OCAN(OBJ)
      IF((X.EQ.0).OR.((SFLAG.AND.VFBIT).EQ.0)) GO TO 500
      IF((OFLAG2(X).AND.OPENBT).NE.0) GO TO 500
      CALL RSPSUB(566,ODO2)
      RETURN
C
  500 IF((SFLAG.AND.VRBIT).EQ.0) GO TO 1000
      IF((SFLAG.AND.VTBIT).EQ.0) GO TO 2000
C
C SHOULD BE IN ROOM (VRBIT NE 0) AND CAN BE TAKEN (VTBIT NE 0)
C
      IF(SCHLST(0,0,HERE,0,0,OBJ).LE.0) GO TO 4000
C
C ITS IN THE ROOM AND CAN BE TAKEN.
C
      IF((OFLAG1(OBJ).AND.TAKEBT).NE.0) GO TO 3000
C
C NOT TAKEABLE.  IF WE CARE, FAIL.
C
      IF((SFLAG.AND.VCBIT).EQ.0) GO TO 4000
      CALL RSPSUB(445,ODO2)
      RETURN
C
C 1000-- IT SHOULD NOT BE IN THE ROOM.
C 2000-- IT CANT BE TAKEN.
C
 2000 IF((SFLAG.AND.VCBIT).EQ.0) GO TO 4000
 1000 IF(SCHLST(0,0,HERE,0,0,OBJ).LE.0) GO TO 4000
      CALL RSPSUB(665,ODO2)
      RETURN
C
C 3000-- TAKE OBJECT.
C
 3000 IF(LIT(HERE)) GO TO 3500
      CALL RSPEAK(579)
      RETURN
C
 3500 SVA=PRSA
      SVO=PRSO
      SVI=PRSI
      PRSA=TAKEW
      PRSO=OBJ
      PRSI=0
      TAKEIT=TAKE(.TRUE.)
      PRSA=SVA
      PRSO=SVO
      PRSI=SVI
      RETURN
C
C 4000-- WIN ON GENERAL PRINCIPLES.
C
 4000 TAKEIT=.TRUE.
      RETURN
C
      END
C GWIM- GET WHAT I MEAN IN AMBIGUOUS SITUATIONS
C
C DECLARATIONS
C
      INTEGER FUNCTION GWIM(SFLAG,SFW1,SFW2)
      IMPLICIT INTEGER(A-Z)
*CALL DPARAM
      LOGICAL TAKEIT,NOCARE,LIT
C
      IF(DEADF) GO TO 700
      AV=AVEHIC(WINNER)
      NOBJ=0
      NOCARE=(SFLAG.AND.VCBIT).EQ.0
C
C FIRST SEARCH ADVENTURER
C
      IF((SFLAG.AND.VABIT).NE.0)
     1GWIM=FWIM(SFW1,SFW2,0,0,WINNER,NOCARE)
      IF((GWIM.LT.0).OR..NOT.LIT(HERE).OR.
     1  ((SFLAG.AND.VRBIT).EQ.0)) RETURN
C
C ALSO SEARCH ROOM
C
  100 ROBJ=FWIM(SFW1,SFW2,HERE,0,0,NOCARE)
      IF(ROBJ) 500,600,200
C
C ROBJ > 0
C
  200 IF((AV.EQ.0).OR.(ROBJ.EQ.AV).OR.
     1((OFLAG2(ROBJ).AND.FINDBT).NE.0)) GO TO 300
      IF(OCAN(ROBJ).NE.AV) RETURN
C
  300 IF(GWIM.EQ.0) GO TO 400
      GWIM=-GWIM
      RETURN
C
  400 IF(.NOT.TAKEIT(ROBJ,SFLAG)) RETURN
  500 GWIM=ROBJ
  600 RETURN
C
  700 GWIM=-1
      RETURN
C
      END
C NOADJS- SEE IF ANY ADJECTIVES FOR OBJECT
C
C DECLARATIONS
C
      LOGICAL FUNCTION NOADJS(OBJ)
      IMPLICIT INTEGER(A-Z)
*CALL DPARAM
C
      NOADJS=.FALSE.
      DO 100 I=1,AVMAX
        IF(IABS(AVOC(I)).EQ.OBJ) RETURN
        IF(AVOC(I).EQ.0) GO TO 200
  100 CONTINUE
  200 NOADJS=.TRUE.
      RETURN
C
      END
C LCIFY- "LOWER CASE"-IFY A STRING FOR PRINTING
C
C DECLARATIONS
C
      CHARACTER*(*) FUNCTION LCIFY(STRING,START)
      IMPLICIT INTEGER(A-Z)
      CHARACTER*(*) STRING
C
      LCIFY=STRING
      K=LEN(STRING)
      IF(START.GT.K) RETURN
C
      ULCVT=ICHAR('A')-ICHAR('A')
      DO 100 I=START,K
        IF((STRING(I:I).GE.'A').AND.(STRING(I:I).LE.'Z'))
     1LCIFY(I:I)=CHAR(ICHAR(STRING(I:I))+ULCVT)
  100 CONTINUE
      RETURN
C
      END
C FINDVB- FIND VERB STRING CORRESPONDING TO SYNTAX.
C
C DECLARATIONS
C
      CHARACTER*(*) FUNCTION FINDVB(SYNTAX)
      IMPLICIT INTEGER(A-Z)
*CALL DPARAM
C
      J=1
      DO 100 K=1,VWMAX
        NEWJ=J+VVOC(J)+1
        IF((J.LE.SYNTAX).AND.(SYNTAX.LT.NEWJ)) GO TO 200
        IF(VWORD(K)(1:1).NE.'*') J=NEWJ
  100 CONTINUE
      FINDVB=' '
      RETURN
C
  200 FINDVB=VWORD(K)
      IF(VWORD(K)(1:1).EQ.'*') FINDVB=VWORD(K)(2:WRDLNT)
      RETURN
C
      END
C FINDPR- FIND PREPOSITION STRING CORRESPONDING TO INDEX.
C
C DECLARATIONS
C
      CHARACTER*(*) FUNCTION FINDPR(PREPNO)
      IMPLICIT INTEGER(A-Z)
*CALL DPARAM
C
      DO 100 I=1,PWMAX
        IF(PVOC(I).EQ.PREPNO) GO TO 200
  100 CONTINUE
      FINDPR=' '
      RETURN
C
  200 FINDPR=PWORD(I)
      RETURN
C
      END
*DECK ROOMS
C ROOM PROCESSORS FOR DUNGEON
C
C COPYRIGHT 1980, 1990, INFOCOM COMPUTERS AND COMMUNICATIONS, CAMBRIDGE 
C ALL RIGHTS RESERVED, COMMERCIAL USAGE STRICTLY PROHIBITED
C WRITTEN BY R. M. SUPNIK
C
C RAPPLI- ROOM ROUTINES
C
C DECLARATIONS
C
      SUBROUTINE RAPPLI(RI)
      IMPLICIT INTEGER (A-Z)
*CALL DPARAM
      LOGICAL QOPEN,QON,QHERE,PROB,F
      LOGICAL MOVETO,LIT,RMDESC,QEMPTY
C
C FUNCTIONS AND DATA
C
      QOPEN(R)=(OFLAG2(R).AND.OPENBT).NE.0
      QON(R)=(OFLAG1(R).AND.ONBT).NE.0
C
      IF(RI.EQ.0) RETURN
      GO TO (  1000, 2000, 3000, 4000, 5000, 6000, 7000, 8000, 9000,
     1 10000,11000,12000,13000,14000,15000,16000,17000,18000,19000,
     2 20000,21000,22000,23000,24000,25000,26000,27000,28000,29000,
     3 30000,31000,32000,33000,34000,35000,36000,37000,38000,39000,
     4 40000,41000,42000,43000,44000,45000,46000,47000,48000,49000,
     5 50000,51000,52000,53000,54000,55000,56000,57000,58000,59000,
     6 60000,61000,62000,63000),RI
      CALL BUG(1,RI)
C RAPPLI, PAGE 2
C
C R1-- EAST OF HOUSE
C
 1000 IF(PRSA.NE.LOOKW) RETURN
      I=13
      IF(QOPEN(WINDO)) I=12
      CALL RSPSUB(11,I)
      RETURN
C
C R2-- KITCHEN
C
 2000 IF(PRSA.NE.LOOKW) GO TO 2100
      I=13
      IF(QOPEN(WINDO)) I=12
      CALL RSPSUB(14,I)
      RETURN
C
 2100 IF((PRSA.NE.WALKIW).OR.DEADF.OR..NOT.BROC1F.OR.BROC2F) RETURN
      CFLAG(CEVBRO)=.TRUE.
      CTICK(CEVBRO)=3
      RETURN
C
C R3-- LIVING ROOM
C
 3000 IF(PRSA.NE.LOOKW) GO TO 3500
      I=15
      IF(MAGICF) I=16
      CALL RSPEAK(I)
      I=17+ORRUG
      IF(QOPEN(DOOR)) I=I+2
      CALL RSPEAK(I)
      RETURN
C
C NOT A LOOK WORD, REEVALUATE TROPHY CASE.
C
 3500 IF((PRSA.NE.TAKEW).AND.((PRSA.NE.PUTW).OR.(PRSI.NE.TCASE)))
     1RETURN
      ASCORE(WINNER)=RWSCOR
      DO 3600 I=1,OLNT
        J=I
 3550   J=OCAN(J)
        IF(J.EQ.0) GO TO 3600
        IF(J.NE.TCASE) GO TO 3550
        ASCORE(WINNER)=ASCORE(WINNER)+OTVAL(I)
 3600 CONTINUE
      CALL SCRUPD(0)
      RETURN
C RAPPLI, PAGE 3
C
C R4-- CELLAR
C
 4000 IF(PRSA.NE.LOOKW) GO TO 4500
      CALL RSPEAK(21)
      IF(QOPEN(DOOR)) CALL RSPEAK(623)
      RETURN
C
 4500 IF(PRSA.NE.WALKIW) RETURN
      IF((OFLAG2(DOOR).AND.(OPENBT+TCHBT)).NE.OPENBT) RETURN
      OFLAG2(DOOR)=(OFLAG2(DOOR).OR.TCHBT).AND. .NOT.OPENBT
      CALL RSPEAK(22)
      RETURN
C
C R5-- GRATING ROOM
C
 5000 IF(PRSA.NE.LOOKW) RETURN
      CALL RSPEAK(23)
      I=24
      IF(GRUNLF) I=26
      IF(QOPEN(GRATE)) I=25
      CALL RSPEAK(I)
      RETURN
C
C R6-- CLEARING
C
 6000 IF(PRSA.NE.LOOKW) RETURN
      CALL RSPEAK(27)
      I=0
      IF(RVCLR.NE.0) I=28
      IF(QOPEN(GRATE)) I=29
      CALL RSPEAK(I)
      RETURN
C RAPPLI, PAGE 4
C
C R7-- RESERVOIR SOUTH
C
 7000 IF(PRSA.NE.LOOKW) RETURN
      I=31
      IF(LWTIDF) I=32
      CALL RSPEAK(I)
      CALL RSPEAK(33)
      RETURN
C
C R8-- RESERVOIR
C
 8000 IF(PRSA.NE.LOOKW) RETURN
      I=34
      IF(LWTIDF) I=35
      CALL RSPEAK(I)
      RETURN
C
C R9-- RESERVOIR NORTH
C
 9000 IF(PRSA.NE.LOOKW) RETURN
      I=36
      IF(LWTIDF) I=37
      CALL RSPEAK(I)
      CALL RSPEAK(38)
      RETURN
C
C R10-- GLACIER ROOM
C
10000 IF(PRSA.NE.LOOKW) RETURN
      CALL RSPEAK(39)
      I=0
      IF(GLACMF) I=40
      IF(GLACRF) I=41
      CALL RSPEAK(I)
      RETURN
C
C R11-- FOREST ROOM
C
11000 IF(PRSA.NE.WALKIW) RETURN
      CFLAG(CEVFOR)=.TRUE.
      CTICK(CEVFOR)=-1
      RETURN
C
C R12-- MIRROR ROOM
C
12000 IF(PRSA.NE.LOOKW) RETURN
      CALL RSPEAK(42)
      IF(MIRRMF) CALL RSPEAK(43)
      RETURN
C RAPPLI, PAGE 5
C
C R13-- CAVE2
C
13000 IF(PRSA.NE.WALKIW) RETURN
      IF(PROB(50,50).OR.(OADV(CANDL).NE.WINNER).OR.
     1.NOT.QON(CANDL)) RETURN
      OFLAG1(CANDL)=OFLAG1(CANDL).AND. .NOT. ONBT
      CALL RSPEAK(47)
      CFLAG(CEVCND)=.FALSE.
      IF(.NOT.LIT(HERE)) CALL RSPEAK(406)
      RETURN
C
C R14-- BOOM ROOM
C
14000 J=ODESC2(CANDL)
      IF((OADV(CANDL).EQ.WINNER).AND.QON(CANDL)) GO TO 14100
      J=ODESC2(TORCH)
      IF((OADV(TORCH).EQ.WINNER).AND.QON(TORCH)) GO TO 14100
      J=ODESC2(MATCH)
      IF((OADV(MATCH).EQ.WINNER).AND.QON(MATCH)) GO TO 14100
      RETURN
C
14100 IF((PRSA.NE.TRNONW).AND.(PRSA.NE.BURNW))
     1GO TO 14200
      CALL RSPSUB(294,J)
      CALL JIGSUP(44)
      RETURN
C
14200 IF(PRSA.NE.WALKIW) RETURN
      CALL RSPSUB(295,J)
      CALL JIGSUP(44)
      RETURN
C
C R15-- NO-OBJS
C
15000 EMPTHF=.TRUE.
      DO 15100 I=1,OLNT
        IF(OADV(I).EQ.WINNER) EMPTHF=.FALSE.
15100 CONTINUE
C
      IF((HERE.NE.BSHAF).OR.(.NOT.LIT(HERE))) RETURN
      CALL SCRUPD(LTSHFT)
      LTSHFT=0
      RETURN
C RAPPLI, PAGE 6
C
C R16-- MACHINE ROOM
C
16000 IF(PRSA.NE.LOOKW) RETURN
      I=46
      IF(QOPEN(MACHI)) I=12
      CALL RSPSUB(45,I)
      RETURN
C
C R17-- BAT ROOM
C
17000 IF(PRSA.NE.LOOKW) GO TO 17500
      CALL RSPEAK(48)
      IF(OADV(GARLI).EQ.WINNER) CALL RSPEAK(49)
      RETURN
C
17500 IF((PRSA.NE.WALKIW).OR.(OADV(GARLI).EQ.WINNER)
     1.OR.DEADF) RETURN
      CALL RSPEAK(50)
      F=MOVETO(BATDRP(RND(9)+1),WINNER)
      F=RMDESC(0)
      RETURN
C
C R18-- DOME ROOM
C
18000 IF(PRSA.NE.LOOKW) GO TO 18500
      CALL RSPEAK(51)
      IF(DOMEF) CALL RSPEAK(52)
      RETURN
C
18500 IF(PRSA.EQ.LEAPW) CALL JIGSUP(53)
      RETURN
C
C R19-- TORCH ROOM
C
19000 IF(PRSA.NE.LOOKW) RETURN
      CALL RSPEAK(54)
      IF(DOMEF) CALL RSPEAK(55)
      RETURN
C
C R20-- CAROUSEL ROOM
C
20000 IF(PRSA.NE.LOOKW) GO TO 20500
      CALL RSPEAK(56)
      IF(.NOT.(CAROFF.OR.DEADF)) CALL RSPEAK(57)
      RETURN
C
20500 IF((PRSA.EQ.WALKIW).AND.CAROZF.AND..NOT.DEADF)
     1CALL JIGSUP(58)
      RETURN
C RAPPLI, PAGE 7
C
C R21-- LAND OF THE LIVING DEAD
C
21000 IF(PRSA.NE.LOOKW) GO TO 21100
      CALL RSPEAK(59)
      IF(.NOT.LLDF) CALL RSPEAK(60)
      RETURN
C
21100 IF(LLDF.OR.(PRSA.NE.RINGW).OR.(PRSO.NE.BELL))
     1GO TO 21200
      EXORBF=.TRUE.
      CALL NEWSTA(BELL,0,0,0,0)
      CALL NEWSTA(HBELL,967,HERE,0,0)
      LASTIT=HBELL
      IF(.NOT.QON(CANDL).OR.(OADV(CANDL).NE.WINNER))
     1GO TO 21150
      CALL NEWSTA(CANDL,968,HERE,0,0)
      OFLAG1(CANDL)=OFLAG1(CANDL).AND..NOT.ONBT
      CFLAG(CEVCND)=.FALSE.
21150 CFLAG(CEVXB)=.TRUE.
      CTICK(CEVXB)=6
      CFLAG(CEVXBH)=.TRUE.
      CTICK(CEVXBH)=20
      RETURN
C
21200 IF(.NOT.EXORBF.OR.EXORCF.OR.(OADV(CANDL).NE.WINNER).OR.
     1((OFLAG1(CANDL).AND.ONBT).EQ.0)) GO TO 21300
      EXORCF=.TRUE.
      CALL RSPEAK(969)
      CFLAG(CEVXB)=.FALSE.
      CFLAG(CEVXC)=.TRUE.
      CTICK(CEVXC)=3
      RETURN
C
21300 IF(.NOT.EXORCF.OR.(PRSA.NE.READW).OR.(PRSO.NE.BOOK))
     1GO TO 21400
      CALL NEWSTA(GHOST,63,0,0,0)
      LLDF=.TRUE.
      CFLAG(CEVXC)=.FALSE.
      RETURN
C
21400 IF(PRSA.NE.EXORCW) RETURN
      IF((OADV(BELL).EQ.WINNER).AND.(OADV(BOOK).EQ.WINNER).AND.
     1(OADV(CANDL).EQ.WINNER).AND.QON(CANDL)) GO TO 21500
      CALL RSPEAK(62)
      RETURN
C
21500 IF(LLDF) GO TO 21600
      CALL RSPEAK(1044)
      RETURN
C
21600 CALL JIGSUP(61)
      RETURN
C RAPPLI, PAGE 7A
C
C R22-- LAND OF THE LIVING DEAD INTERIOR
C
22000 IF(PRSA.NE.LOOKW) RETURN
      CALL RSPEAK(64)
      IF(ONPOLF) CALL RSPEAK(65)
      RETURN
C
C R23-- DAM ROOM
C
23000 IF(PRSA.NE.LOOKW) RETURN
      CALL RSPEAK(66)
      I=67
      IF(LWTIDF) I=68
      CALL RSPEAK(I)
      CALL RSPEAK(69)
      IF(GATEF) CALL RSPEAK(70)
      RETURN
C
C R24-- TREE ROOM
C
24000 IF(PRSA.NE.LOOKW) GO TO 24300
      CALL RSPEAK(660)
      I=661
      DO 24200 J=1,OLNT
        IF(.NOT.QHERE(J,FORE3).OR.(J.EQ.FTREE)) GO TO 24200
        CALL RSPEAK(I)
        I=0
        CALL RSPSUB(502,ODESC2(J))
24200 CONTINUE
      RETURN
C
24300 IF(PRSA.NE.WALKIW) GO TO 24400
      CFLAG(CEVFOR)=.TRUE.
      CTICK(CEVFOR)=-1
      RETURN
C
24400 IF(PRSA.NE.DROPW) RETURN
      DO 24600 I=1,OLNT
        IF((I.EQ.TTREE).OR.(I.EQ.NEST).OR.
     1.NOT.QHERE(I,HERE)) GO TO 24600
        IF(I.EQ.EGG) GO TO 24500
        CALL NEWSTA(I,0,FORE3,0,0)
        CALL RSPSUB(659,ODESC2(I))
        GO TO 24600
C
24500   CALL NEWSTA(EGG,0,0,0,0)
        CALL NEWSTA(BEGG,658,FORE3,0,0)
        OTVAL(BEGG)=2
        IF(OCAN(CANAR).NE.EGG) GO TO 24550
        OTVAL(BCANA)=1
        GO TO 24600
24550   CALL NEWSTA(BCANA,0,0,0,0)
24600 CONTINUE
      RETURN
C RAPPLI, PAGE 8
C
C R25-- CYCLOPS ROOM
C
25000 IF(PRSA.NE.LOOKW) GO TO 25100
      CALL RSPEAK(606)
      I=607
      IF(RVCYC.GT.0) I=608
      IF(RVCYC.LT.0) I=609
      IF(CYCLOF) I=610
      IF(MAGICF) I=611
      CALL RSPEAK(I)
      RETURN
C
25100 IF((PRSA.NE.WALKIW).OR.(RVCYC.EQ.0).OR.DEADF) RETURN
      CFLAG(CEVCYC)=.TRUE.
      CTICK(CEVCYC)=-1
      RETURN
C
C R26-- BANK BOX ROOM
C
26000 IF(PRSA.NE.WALKIW) RETURN
      DO 26100 I=1,8,2
        IF(FROMDR.EQ.SCOLDR(I)) SCOLRM=SCOLDR(I+1)
26100 CONTINUE
      RETURN
C
C R27-- TREASURE ROOM
C
27000 IF((PRSA.NE.WALKIW).OR.DEADF.OR..NOT.THFACT)
     1RETURN
      IF(OROOM(THIEF).NE.HERE)
     1CALL NEWSTA(THIEF,82,HERE,0,0)
      THFPOS=HERE
      OFLAG2(THIEF)=OFLAG2(THIEF).OR.FITEBT
C
C VANISH EVERYTHING IN ROOM.
C
      J=0
      DO 27200 I=1,OLNT
        IF((I.EQ.CHALI).OR.(I.EQ.THIEF).OR..NOT.QHERE(I,HERE))
     1GO TO 27200
        J=83
        OFLAG1(I)=OFLAG1(I).AND..NOT.VISIBT
27200 CONTINUE
      CALL RSPEAK(J)
      RETURN
C
C R28-- CLIFF ROOM
C
28000 DEFLAF=OADV(RBOAT).NE.WINNER
      RETURN
C RAPPLI, PAGE 9
C
C R29-- RIVR4 ROOM
C
29000 IF(BUOYF.OR.(OADV(BUOY).NE.WINNER)) RETURN
      CALL RSPEAK(84)
      BUOYF=.TRUE.
      RETURN
C
C R30-- OVERFALLS
C
30000 IF(PRSA.NE.LOOKW) CALL JIGSUP(85)
      RETURN
C
C R31-- SLIDE LEDGE
C
31000 IF(PRSA.NE.WALKIW) RETURN
      CFLAG(CEVSLI)=.FALSE.
      RETURN
C
C R32-- SLIDE
C
32000 IF(PRSA.NE.LOOKW) RETURN
      CALL RSPEAK(1012)
      IF(TTIE.EQ.0) RETURN
      IF(OROOM(TTIE).EQ.HERE) CALL RSPSUB(1013,ODESC2(TTIE))
      RETURN
C
C R33-- ARAGAIN FALLS
C
33000 IF(PRSA.NE.LOOKW) RETURN
      CALL RSPEAK(96)
      I=97
      IF(RAINBF) I=98
      CALL RSPEAK(I)
      RETURN
C RAPPLI, PAGE 10
C
C R34-- LEDGE ROOM
C
34000 IF(PRSA.NE.LOOKW) RETURN
      CALL RSPEAK(100)
      I=102
      IF((RFLAG(MSAFE).AND.RMUNG).NE.0) I=101
      CALL RSPEAK(I)
      RETURN
C
C R35-- SAFE ROOM
C
35000 IF(PRSA.NE.LOOKW) RETURN
      CALL RSPEAK(104)
      I=105
      IF(SAFEF) I=106
      CALL RSPEAK(I)
      RETURN
C
C R36-- MAGNET ROOM
C
36000 IF(PRSA.NE.LOOKW) GO TO 36500
      CALL RSPEAK(107)
      RETURN
C
36500 IF((PRSA.NE.WALKIW).OR.DEADF.OR..NOT.CAROFF) RETURN
      IF(CAROZF) GO TO 36600
      CALL RSPEAK(108)
      RETURN
C
36600 I=58
      IF(WINNER.NE.PLAYER) I=99
      CALL JIGSUP(I)
      RETURN
C
C R37-- CAGE ROOM
C
37000 IF(CAGESF) F=MOVETO(CAGER,WINNER)
      RETURN
C RAPPLI, PAGE 11
C
C R38-- MIRROR D ROOM
C
38000 IF(PRSA.EQ.LOOKW) CALL LOOKTO(FDOOR,MRG,0,682,681)
      RETURN
C
C R39-- MIRROR G ROOM
C
39000 IF(PRSA.EQ.WALKIW) CALL JIGSUP(685)
      RETURN
C
C R40-- MIRROR C ROOM
C
40000 IF(PRSA.EQ.LOOKW) CALL LOOKTO(MRG,MRB,683,0,681)
      RETURN
C
C R41-- MIRROR B ROOM
C
41000 IF(PRSA.EQ.LOOKW) CALL LOOKTO(MRC,MRA,0,0,681)
      RETURN
C
C R42-- MIRROR A ROOM
C
42000 IF(PRSA.EQ.LOOKW) CALL LOOKTO(MRB,0,0,684,681)
      RETURN
C RAPPLI, PAGE 12
C
C R43-- MIRROR C EAST/WEST
C
43000 IF(PRSA.EQ.LOOKW) CALL EWTELL(HERE,683)
      RETURN
C
C R44-- MIRROR B EAST/WEST
C
44000 IF(PRSA.EQ.LOOKW) CALL EWTELL(HERE,686)
      RETURN
C
C R45-- MIRROR A EAST/WEST
C
45000 IF(PRSA.EQ.LOOKW) CALL EWTELL(HERE,687)
      RETURN
C
C R46-- INSIDE MIRROR
C
46000 IF(PRSA.NE.LOOKW) RETURN
      CALL RSPEAK(688)
C
C NOW DESCRIBE POLE STATE.
C
C CASES 1,2-- MDIR=270 & MLOC=MRB, POLE IS UP OR IN HOLE
C CASES 3,4-- MDIR=0 V MDIR=180, POLE IS UP OR IN CHANNEL
C CASE 5-- POLE IS UP
C
      I=689
      IF((MDIR.EQ.270).AND.(MLOC.EQ.MRB))
     1I=690+MIN0(POLEUF,1)
      IF(MOD(MDIR,180).EQ.0)
     1I=692+MIN0(POLEUF,1)
      CALL RSPEAK(I)
      CALL RSPSUB(694,695+(MDIR/45))
      RETURN
C RAPPLI, PAGE 13
C
C R47-- MIRROR EYE ROOM
C
47000 IF(PRSA.NE.LOOKW) RETURN
      I=704
      DO 47100 J=1,OLNT
        IF(QHERE(J,HERE).AND.(J.NE.RBEAM)) GO TO 47200
47100 CONTINUE
      I=703
47200 CALL RSPSUB(I,ODESC2(J))
      CALL LOOKTO(MRA,0,0,0,0)
      RETURN
C
C R48-- INSIDE CRYPT
C
48000 IF(PRSA.NE.LOOKW) RETURN
      I=46
      IF(QOPEN(TOMB)) I=12
      CALL RSPSUB(705,I)
      RETURN
C
C R49-- SOUTH CORRIDOR
C
49000 IF(PRSA.NE.LOOKW) RETURN
      CALL RSPEAK(706)
      I=46
      IF(QOPEN(ODOOR)) I=12
      IF(LCELL.EQ.4) CALL RSPSUB(707,I)
      RETURN
C
C R50-- BEHIND DOOR
C
50000 IF(PRSA.NE.WALKIW) GO TO 50100
      CFLAG(CEVFOL)=.TRUE.
      CTICK(CEVFOL)=-1
      RETURN
C
50100 IF(PRSA.NE.LOOKW) RETURN
      I=46
      IF(QOPEN(QDOOR)) I=12
      CALL RSPSUB(708,I)
      RETURN
C RAPPLI, PAGE 14
C
C R51-- FRONT DOOR
C
51000 IF(PRSA.EQ.WALKIW) CTICK(CEVFOL)=0
      IF(PRSA.NE.LOOKW) RETURN
      CALL LOOKTO(0,MRD,709,0,0)
      I=46
      IF(CFLAG(CEVINQ).AND.(CTICK(CEVINQ).NE.0)) I=12
      J=46
      IF(QOPEN(QDOOR)) J=12
      CALL RSPSB2(710,I,J)
      RETURN
C
C R52-- NORTH CORRIDOR
C
52000 IF(PRSA.NE.LOOKW) RETURN
      I=46
      IF(QOPEN(CDOOR)) I=12
      CALL RSPSUB(711,I)
      RETURN
C
C R53-- PARAPET
C
53000 IF(PRSA.EQ.LOOKW) CALL RSPSUB(712,712+PNUMB)
      RETURN
C
C R54-- CELL
C
54000 IF(PRSA.NE.LOOKW) RETURN
      I=721
      IF(QOPEN(CDOOR)) I=722
      CALL RSPEAK(I)
      I=46
      IF(QOPEN(ODOOR)) I=12
      IF(LCELL.EQ.4) CALL RSPSUB(723,I)
      RETURN
C
C R55-- PRISON CELL
C
55000 IF(PRSA.EQ.LOOKW) CALL RSPEAK(724)
      RETURN
C
C R56-- NIRVANA CELL
C
56000 IF(PRSA.NE.LOOKW) RETURN
      I=46
      IF(QOPEN(ODOOR)) I=12
      CALL RSPSUB(725,I)
      RETURN
C RAPPLI, PAGE 15
C
C R57-- NIRVANA AND END OF GAME
C
57000 IF(PRSA.NE.WALKIW) RETURN
      CALL RSPEAK(726)
      CALL SCORE(.FALSE.)
      CLOSE(UNIT=DBCH)
      CALL EXIT
C
C R58-- TOMB ROOM
C
58000 IF(PRSA.NE.LOOKW) RETURN
      I=46
      IF(QOPEN(TOMB)) I=12
      CALL RSPSUB(792,I)
      RETURN
C
C R59-- PUZZLE SIDE ROOM
C
59000 IF(PRSA.NE.LOOKW) RETURN
      I=861
      IF(CPOUTF) I=862
      CALL RSPEAK(I)
      RETURN
C
C R60-- PUZZLE ROOM
C
60000 IF(PRSA.NE.LOOKW) RETURN
      IF(CPUSHF) GO TO 60100
      CALL RSPEAK(868)
      IF((OFLAG2(WARNI).AND.TCHBT).NE.0) CALL RSPEAK(869)
      RETURN
C
60100 CALL CPINFO(880,CPHERE)
      RETURN
C RAPPLI, PAGE 16
C
C R61-- PALANTIR ROOM
C
61000 IF(PRSA.NE.LOOKW) GO TO 62400
      CALL RSPEAK(1015)
      I=699
      GO TO 62100
C
C R62-- PRM ROOM
C
62000 IF(PRSA.NE.LOOKW) GO TO 62400
      CALL RSPEAK(1016)
      I=695
C
62100 IF(PLOOKF) GO TO 62400
      CALL RSPSUB(1017,I)
      I=1018
      IF(.NOT.QOPEN(HERE-PRM+PLID1)) I=1019
      CALL RSPEAK(I)
      DO 62200 I=1,OLNT
        IF(OCAN(I).NE.(HERE-PRM+PKH1)) GO TO 62200
        CALL RSPSUB(1020,ODESC2(I))
        GO TO 62300
62200 CONTINUE
C
62300 IF(QOPEN(PDOOR)) CALL RSPEAK(1042)
      IF(.NOT.MATF) GO TO 62400
      CALL RSPEAK(1021)
      IF((MATOBJ.NE.0).AND.((HERE.EQ.PALRM).OR.QOPEN(PDOOR)))
     1CALL RSPSUB(1022,ODESC2(MATOBJ))
      GO TO 62400
C
62400 PLOOKF=.FALSE.
      IF(PRSO.EQ.0) RETURN
      IF((PRSA.NE.TAKEW).OR..NOT.QEMPTY(HERE-PRM+PKH1).OR.
     1  ((PRSO.NE.SCREW).AND.(PRSO.NE.STICK).AND.
     2   (PRSO.NE.PKEY).AND.(PRSO.NE.KEYS))) GO TO 62500
      IF(.NOT.PTOUCF) GO TO 62450
      IF(QOPEN(HERE-PRM+PLID1)) CALL RSPEAK(1043)
      OFLAG2(HERE-PRM+PLID1)=OFLAG2(HERE-PRM+PLID1).AND..NOT.OPENBT
62450 PTOUCF=.TRUE.
C
62500 OFLAG1(SCREW)=OFLAG1(SCREW).AND..NOT.NDSCBT
      IF((OCAN(SCREW).EQ.PKH1).OR.(OCAN(SCREW).EQ.PKH2))
     1OFLAG1(SCREW)=OFLAG1(SCREW).OR.NDSCBT
      OFLAG1(STICK)=OFLAG1(STICK).AND..NOT.NDSCBT
      IF((OCAN(STICK).EQ.PKH1).OR.(OCAN(STICK).EQ.PKH2))
     1OFLAG1(STICK)=OFLAG1(STICK).OR.NDSCBT
      OFLAG1(PKEY)=OFLAG1(PKEY).AND..NOT.NDSCBT
      IF((OCAN(PKEY).EQ.PKH1).OR.(OCAN(PKEY).EQ.PKH2))
     1OFLAG1(PKEY)=OFLAG1(PKEY).OR.NDSCBT
      OFLAG1(KEYS)=OFLAG1(KEYS).AND..NOT.NDSCBT
      IF((OCAN(KEYS).EQ.PKH1).OR.(OCAN(KEYS).EQ.PKH2))
     1OFLAG1(KEYS)=OFLAG1(KEYS).OR.NDSCBT
      IF((OROOM(MAT).NE.PRM).AND.(OROOM(MAT).NE.PALRM)) MATF=.FALSE.
      OFLAG1(MAT)=OFLAG1(MAT).AND..NOT.NDSCBT
      IF(.NOT.MATF) RETURN
      OFLAG1(MAT)=OFLAG1(MAT).OR.NDSCBT
      CALL NEWSTA(MAT,0,HERE,0,0)
      RETURN
C
C R63-- INSLIDE
C
63000 DO 63100 I=1,OLNT
        IF(.NOT.QHERE(I,HERE).OR.
     1((OFLAG1(I).AND.TAKEBT).EQ.0)) GO TO 63100
        CALL NEWSTA(I,0,CELLA,0,0)
        CALL RSPSUB(1011,ODESC2(I))
63100 CONTINUE
      RETURN
C
      END
C LOOKTO-- DESCRIBE VIEW IN MIRROR HALLWAY
C
C DECLARATIONS
C
      SUBROUTINE LOOKTO(NRM,SRM,NT,ST,HT)
      IMPLICIT INTEGER(A-Z)
*CALL DPARAM
C
      CALL RSPEAK(HT)
      CALL RSPEAK(NT)
      CALL RSPEAK(ST)
      DIR=0
      IF(IABS(MLOC-HERE).NE.1) GO TO 200
      IF(MLOC.EQ.NRM) DIR=695
      IF(MLOC.EQ.SRM) DIR=699
      IF(MOD(MDIR,180).NE.0) GO TO 100
      CALL RSPSUB(847,DIR)
      CALL RSPSB2(848,DIR,DIR)
      GO TO 200
C
  100 M1=MRHERE(HERE)
      MRBF=0
      IF(((M1.EQ.1).AND..NOT.MR1F).OR.
     1  ((M1.EQ.2).AND..NOT.MR2F)) MRBF=1
      CALL RSPSUB(849+MRBF,DIR)
      IF((M1.EQ.1).AND.MROPNF) CALL RSPEAK(823+MRBF)
      IF(MRBF.NE.0) CALL RSPEAK(851)
C
  200 I=0
      IF((NT.EQ.0).AND.((DIR.EQ.0).OR.(DIR.EQ.699))) I=852
      IF((ST.EQ.0).AND.((DIR.EQ.0).OR.(DIR.EQ.695))) I=853
      IF((NT+ST+DIR).EQ.0) I=854
      IF(HT.NE.0) CALL RSPEAK(I)
      RETURN
C
      END
C EWTELL-- DESCRIBE E/W NARROW ROOMS
C
C DECLARATIONS
C
      SUBROUTINE EWTELL(RM,ST)
      IMPLICIT INTEGER(A-Z)
*CALL DPARAM
      LOGICAL M1
C
C NOTE THAT WE ARE EAST OR WEST OF MIRROR, AND
C MIRROR MUST BE N-S.
C
      M1=(MDIR+(MOD(RM-MRAE,2)*180)).EQ.180
      I=MOD(RM-MRAE,2)
      IF((M1.AND..NOT.MR1F).OR.(.NOT.M1.AND..NOT.MR2F))
     1I=I+2
      CALL RSPEAK(819+I)
      IF(M1.AND.MROPNF) CALL RSPEAK(823+(I/2))
      CALL RSPEAK(825)
      CALL RSPEAK(ST)
      RETURN
C
      END
*DECK SUBR
C SUBROUTINES FOR DUNGEON
C
C COPYRIGHT 1980, 1990, INFOCOM COMPUTERS AND COMMUNICATIONS, CAMBRIDGE 
C ALL RIGHTS RESERVED, COMMERCIAL USAGE STRICTLY PROHIBITED
C WRITTEN BY R. M. SUPNIK
C
C RSPEAK-- OUTPUT RANDOM MESSAGE ROUTINE
C
C CALLED BY--
C
C CALL RSPEAK(MSGNUM)
C
      SUBROUTINE RSPEAK(N)
      IMPLICIT INTEGER(A-Z)
C
      CALL RSPSB2(N,0,0)
      RETURN
C
      END
C
C RSPSUB-- OUTPUT RANDOM MESSAGE WITH SUBSTITUTABLE ARGUMENT
C
C CALLED BY--
C
C CALL RSPSUB(MSGNUM,SUBNUM)
C
      SUBROUTINE RSPSUB(N,S1)
      IMPLICIT INTEGER(A-Z)
C
      CALL RSPSB2(N,S1,0)
      RETURN
C
      END
C RSPSB2-- OUTPUT RANDOM MESSAGE WITH SUBSTITUTABLE ARGUMENTS
C
C CALLED BY--
C
C CALL RSPSB2(MSGNUM,S1,S2)
C
      SUBROUTINE RSPSB2(A,B,C)
      IMPLICIT INTEGER(A-Z)
*CALL DPARAM
      CHARACTER*(TEXLNT) B1,B2
C
C CONVERT ALL ARGUMENTS FROM DICTIONARY NUMBERS (IF POSITIVE)
C TO ABSOLUTE RECORD NUMBERS.
C
      X=A
      Y=B
      Z=C
      IF(X.GT.0) X=RTEXT(X)
      IF(Y.GT.0) Y=RTEXT(Y)
      IF(Z.GT.0) Z=RTEXT(Z)
      X=IABS(X)
      Y=IABS(Y)
      Z=IABS(Z)
      IF(X.EQ.0) RETURN
      IF(X.GT.TXLNT) RETURN
      TELFLG=.TRUE.
C
C NOS: THE TEXT LIVES IN MEMORY (TXREC/TXLINE) INSTEAD OF A DIRECT
C ACCESS FILE, AND IS STORED DECRYPTED.
C
      OLDREC=TXREC(X)
  100 B1=TXLINE(X)
C
  200 IF(Y.EQ.0) GO TO 400
      I=INDEX(B1,'#')
      IF(I.GT.0) GO TO 1000
C
  400 WRITE(OUTCH,650) B1(1:MAX0(1,NBLEN(B1)))
  650 FORMAT(1X,A)
      X=X+1
      IF(X.GT.TXLNT) RETURN
      IF(OLDREC.EQ.TXREC(X)) GO TO 100
      RETURN
C RSPSB2, PAGE 2
C
C SUBSTITUTION WITH SUBSTITUTABLE AVAILABLE.
C I IS INDEX OF # IN B1.
C Y IS NUMBER OF RECORD TO SUBSTITUTE.
C
C PROCEDURE:
C   1) COPY REST OF B1 TO B2
C   2) READ SUBSTITUTABLE OVER B1
C   3) RESTORE TAIL OF ORIGINAL B1
C
C THE IMPLICIT ASSUMPTION HERE IS THAT THE SUBSTITUTABLE STRING
C IS VERY SHORT.
C
 1000 B2(1:(TEXLNT-I))=B1(I+1:TEXLNT)
C
      IF(Y.LE.TXLNT) B1(I:TEXLNT)=TXLINE(Y)
      J=NBLEN(B1)
      B1(J+1:TEXLNT)=B2(1:TEXLNT-J)
C
      Y=Z
      Z=0
      GO TO 200
C
      END
C OBJACT-- APPLY OBJECTS FROM PARSE VECTOR
C
C DECLARATIONS
C
      LOGICAL FUNCTION OBJACT(X)
      IMPLICIT INTEGER (A-Z)
*CALL DPARAM
      LOGICAL OAPPLI
C
      OBJACT=.TRUE.
      IF(PRSI.EQ.0) GO TO 100
      IF(OAPPLI(OACTIO(PRSI),0)) RETURN
C
  100 IF(PRSO.EQ.0) GO TO 200
      IF(OAPPLI(OACTIO(PRSO),0)) RETURN
C
  200 OBJACT=.FALSE.
      RETURN
C
      END
C BUG-- REPORT FATAL SYSTEM ERROR
C
C DECLARATIONS
C
      SUBROUTINE BUG(A,B)
      IMPLICIT INTEGER(A-Z)
*CALL DPARAM
C
      PRINT 100,A,B
      IF(DBGFLG.NE.0) RETURN
      SUBBUF='CRASH'
      SUBLNT=NBLEN(SUBBUF)
      CALL SAVEGM
      PRINT 200
      CALL EXIT
C
  100 FORMAT(' PROGRAM ERROR ',I2,', PARAMETER =',I6)
  200 FORMAT(' GAME STATE SAVED IN "CRASH.DAT".')
C
      END
C NEWSTA-- SET NEW STATUS FOR OBJECT
C
C CALLED BY--
C
C CALL NEWSTA(OBJECT,STRING,NEWROOM,NEWCON,NEWADV)
C
      SUBROUTINE NEWSTA(O,R,RM,CN,AD)
      IMPLICIT INTEGER(A-Z)
*CALL DPARAM
C
      CALL RSPEAK(R)
      OROOM(O)=RM
      OCAN(O)=CN
      OADV(O)=AD
      RETURN
C
      END
C QHERE-- TEST FOR OBJECT IN ROOM
C
C DECLARATIONS
C
      LOGICAL FUNCTION QHERE(OBJ,RM)
      IMPLICIT INTEGER (A-Z)
*CALL DPARAM
C
      QHERE=.TRUE.
      IF(OROOM(OBJ).EQ.RM) RETURN
      DO 100 I=1,R2LNT
        IF((O2(I).EQ.OBJ).AND.(R2(I).EQ.RM)) RETURN
  100 CONTINUE
      QHERE=.FALSE.
      RETURN
C
      END
C QEMPTY-- TEST FOR OBJECT EMPTY
C
C DECLARATIONS
C
      LOGICAL FUNCTION QEMPTY(OBJ)
      IMPLICIT INTEGER (A-Z)
*CALL DPARAM
C
      QEMPTY=.FALSE.
      DO 100 I=1,OLNT
        IF(OCAN(I).EQ.OBJ) RETURN
  100 CONTINUE
      QEMPTY=.TRUE.
      RETURN
C
      END
C JIGSUP- YOU ARE DEAD
C
C DECLARATIONS
C
      SUBROUTINE JIGSUP(DESC)
      IMPLICIT INTEGER (A-Z)
*CALL DPARAM
      LOGICAL MOVETO,QHERE,F
      INTEGER RLIST(8)
C
C FUNCTIONS AND DATA
C
      DATA RLIST/6,36,35,34,4,34,6,5/
C
      CALL RSPEAK(DESC)
      PRSCON=0
      IF(DBGFLG.NE.0) RETURN
      AVEHIC(WINNER)=0
      IF(WINNER.EQ.PLAYER) GO TO 10
      CALL RSPSUB(432,ODESC2(AOBJ(WINNER)))
      CALL NEWSTA(AOBJ(WINNER),0,0,0,0)
      RETURN
C
   10 CALL SCRUPD(-10)
      IF(ENDGMF) GO TO 900
      IF(DEATHS.GE.2) GO TO 1000
      DEATHS=DEATHS+1
      DEADF=.TRUE.
      CALL RSPEAK(8)
      AACTIO(PLAYER)=PLAYER
C
      DO 50 J=1,OLNT
        IF(QHERE(J,HERE)) OFLAG2(J)=OFLAG2(J).AND. .NOT.FITEBT
   50 CONTINUE
C
      F=MOVETO(LLD1,WINNER)
      EGYPTF=.TRUE.
      IF(OADV(COFFI).EQ.WINNER) CALL NEWSTA(COFFI,0,EGYPT,0,0)
      OFLAG2(DOOR)=OFLAG2(DOOR).AND. .NOT.TCHBT
      OFLAG1(ROBOT)=(OFLAG1(ROBOT).OR.VISIBT) .AND. .NOT.NDSCBT
      CALL NEWSTA(LAMP,0,LROOM,0,0)
      OFLAG1(LAMP)=OFLAG1(LAMP).OR.VISIBT
      DO 100 I=1,CLNT
        IF(CCNCEL(I)) CFLAG(I)=.FALSE.
  100 CONTINUE
C JIGSUP, PAGE 2
C
C NOW REDISTRIBUTE HIS VALUABLES AND OTHER BELONGINGS.
C
C THE LAMP HAS BEEN PLACED IN THE LIVING ROOM.
C THE FIRST 8 NON-VALUABLES ARE PLACED IN LOCATIONS AROUND THE HOUSE.
C HIS VALUABLES ARE PLACED START AT MAZE.
C REMAINING NON-VALUABLES ARE AFTER THAT.
C
      I=0
      DO 200 J=1,OLNT
        IF((OADV(J).NE.WINNER).OR.(OTVAL(J).NE.0))
     1GO TO 200
        I=I+1
        IF(I.GT.8) GO TO 400
        CALL NEWSTA(J,0,RLIST(I),0,0)
  200 CONTINUE
C
  400 I=MTROL
      NONOFL=RAIR+RWATER+REND
      DO 300 J=1,OLNT
        IF((OADV(J).NE.WINNER).OR.(OTVAL(J).EQ.0))
     1GO TO 300
  250   I=I+1
        IF((RFLAG(I).AND.NONOFL).NE.0) GO TO 250
        CALL NEWSTA(J,0,I,0,0)
  300 CONTINUE
C
      DO 500 J=1,OLNT
        IF(OADV(J).NE.WINNER) GO TO 500
  450   I=I+1
        IF((RFLAG(I).AND.NONOFL).NE.0) GO TO 450
        CALL NEWSTA(J,0,I,0,0)
  500 CONTINUE
      RETURN
C
C CANT OR WONT CONTINUE, CLEAN UP AND EXIT.
C
  900 CALL RSPEAK(625)
      GO TO 1100
C
 1000 CALL RSPEAK(7)
 1100 CALL SCORE(.FALSE.)
      CALL EXIT
C
      END
C OACTOR- GET ACTOR ASSOCIATED WITH OBJECT
C
C DECLARATIONS
C
      INTEGER FUNCTION OACTOR(OBJ)
      IMPLICIT INTEGER(A-Z)
*CALL DPARAM
C
      DO 100 OACTOR=1,ALNT
        IF(AOBJ(OACTOR).EQ.OBJ) RETURN
  100 CONTINUE
      CALL BUG(40,OBJ)
      RETURN
C
      END
C PROB-  COMPUTE PROBABILITY
C
C DECLARATIONS
C
      LOGICAL FUNCTION PROB(G,B)
      IMPLICIT INTEGER(A-Z)
*CALL DPARAM
C
      I=G
      IF(BADLKF) I=B
      PROB=RND(100).LT.I
      RETURN
C
      END
C RMDESC-- PRINT ROOM DESCRIPTION
C
C RMDESC PRINTS A DESCRIPTION OF THE CURRENT ROOM.
C IT IS ALSO THE PROCESSOR FOR VERBS 'LOOK' AND 'EXAMINE'
C WHEN THERE IS NO DIRECT OBJECT.
C
      LOGICAL FUNCTION RMDESC(FULL)
C
C FULL= 0/1/2/3= FULL/OBJ/ROOM/FULL BUT NO APPLICABLE
C
C DECLARATIONS
C
      IMPLICIT INTEGER (A-Z)
      LOGICAL PROB,LIT,OBJACT
*CALL DPARAM
C
      RMDESC=.TRUE.
      RA=RACTIO(HERE)
      IF(PRSO.LT.XMIN) GO TO 50
      FROMDR=PRSO
      PRSO=0
   50 IF(FULL.EQ.1) GO TO 600
      IF(HERE.EQ.AROOM(PLAYER)) GO TO 100
      CALL RSPEAK(2)
      PRSA=WALKIW
      RETURN
C
  100 IF(LIT(HERE)) GO TO 300
      CALL RSPEAK(430)
      RMDESC=.FALSE.
      RETURN
C
  300 I=RDESC2-HERE
      IF((FULL.EQ.0)
     1.AND. (SUPERF.OR.(((RFLAG(HERE).AND.RSEEN).NE.0)
     2.AND. (BRIEFF.OR.PROB(80,80))))) GO TO 400
      I=RDESC1(HERE)
      IF((I.NE.0).OR.(RA.EQ.0)) GO TO 400
      PRSA=LOOKW
      PRSO=0
      CALL RAPPLI(RA)
      PRSA=FOOW
      GO TO 500
C
  400 CALL RSPEAK(I)
  500 IF(AVEHIC(WINNER).NE.0) CALL RSPSUB(431,ODESC2(AVEHIC(WINNER)))
      RFLAG(HERE)=RFLAG(HERE).OR.RSEEN
C
  600 IF(LIT(HERE)) GO TO 700
      CALL RSPEAK(1036)
      RETURN
C
  700 IF(FULL.NE.2) CALL PRINCR(FULL,HERE)
      IF((FULL.NE.0).OR.(RA.EQ.0)) RETURN
      PRSA=WALKIW
      CALL RAPPLI(RA)
      PRSA=FOOW
      RETURN
C
      END
C PRINCR- PRINT CONTENTS OF ROOM
C
C DECLARATIONS
C
      SUBROUTINE PRINCR(FULL,RM)
      IMPLICIT INTEGER (A-Z)
*CALL DPARAM
      LOGICAL QEMPTY,QHERE
C
      J=329
      DO 500 I=1,OLNT
        IF(.NOT.QHERE(I,RM).OR.((OFLAG1(I).AND.VISIBT).EQ.0).OR.
     1(((OFLAG1(I).AND.NDSCBT).NE.0).AND.(FULL.NE.1)).OR.
     2(I.EQ.AVEHIC(WINNER))) GO TO 500
        IF((FULL.EQ.0).AND.(SUPERF.OR.(BRIEFF.AND.
     1((RFLAG(HERE).AND.RSEEN).NE.0)))) GO TO 200
C
C DO LONG DESCRIPTION OF OBJECT.
C
        K=ODESCO(I)
        IF((K.EQ.0).OR.((OFLAG2(I).AND.TCHBT).NE.0)) K=ODESC1(I)
        IF((K.EQ.0).AND.(FULL.EQ.1)) CALL RSPSUB(936,ODESC2(I))
        CALL RSPEAK(K)
        GO TO 500
C
C DO SHORT DESCRIPTION OF OBJECT.
C
  200   CALL RSPSUB(J,ODESC2(I))
        J=502
C
  500 CONTINUE
C
C NOW LOOP TO PRINT CONTENTS OF OBJECTS IN ROOM.
C
      DO 1000 I=1,OLNT
        IF(.NOT.QHERE(I,RM).OR.((OFLAG1(I).AND.VISIBT).EQ.0).OR.
     1(((OFLAG1(I).AND.NDSCBT).NE.0).AND.(FULL.NE.1)))
     2GO TO 1000
        IF((OFLAG2(I).AND.ACTRBT).NE.0) CALL INVENT(OACTOR(I))
        IF((((OFLAG1(I).AND.TRANBT).EQ.0).AND.((OFLAG2(I).AND.OPENBT)
     1.EQ.0)).OR.QEMPTY(I)) GO TO 1000
C
C OBJECT IS NOT EMPTY AND IS OPEN OR TRANSPARENT.
C
        IF(I.NE.TCASE) GO TO 600
        IF((.NOT.(BRIEFF.OR.SUPERF)).OR.(FULL.EQ.1))
     1CALL PRINCO(I,1053,.FALSE.)
        GO TO 1000
  600   CALL PRINCO(I,573,.TRUE.)
 1000 CONTINUE
      RETURN
C
      END
C INVENT- PRINT CONTENTS OF ADVENTURER
C
C DECLARATIONS
C
      SUBROUTINE INVENT(ADV)
      IMPLICIT INTEGER (A-Z)
*CALL DPARAM
      LOGICAL QEMPTY
C
      I=575
      IF(ADV.NE.PLAYER) I=576
      DO 10 J=1,OLNT
        IF((OADV(J).NE.ADV).OR.((OFLAG1(J).AND.VISIBT).EQ.0))
     1GO TO 10
        CALL RSPSUB(I,ODESC2(AOBJ(ADV)))
        I=0
        CALL RSPSUB(502,ODESC2(J))
   10 CONTINUE
C
      IF(I.EQ.0) GO TO 25
      IF(ADV.EQ.PLAYER) CALL RSPEAK(578)
      RETURN
C
   25 DO 100 J=1,OLNT
        IF((OADV(J).NE.ADV).OR.((OFLAG1(J).AND.VISIBT).EQ.0).OR.
     1(((OFLAG1(J).AND.TRANBT).EQ.0).AND.
     2((OFLAG2(J).AND.OPENBT).EQ.0))) GO TO 100
        IF(.NOT.QEMPTY(J)) CALL PRINCO(J,573,.TRUE.)
  100 CONTINUE
      RETURN
C
      END
C PRINCO- PRINT CONTENTS OF OBJECT
C
C DECLARATIONS
C
      SUBROUTINE PRINCO(OBJ,DESC,LDESCF)
      IMPLICIT INTEGER(A-Z)
*CALL DPARAM
      LOGICAL QEMPTY,LDESCF,MOREF,QSEEIN,QUAL
C
C FUNCTIONS AND DATA
C
      QSEEIN(X)=((OFLAG1(X).AND.TRANBT).NE.0).OR.
     1  ((OFLAG2(X).AND.OPENBT).NE.0)
      QUAL(X,Y)=((OFLAG1(X).AND.VISIBT).NE.0).AND.
     1   (OCAN(X).EQ.Y).AND.(X.NE.AOBJ(WINNER))
C
      MOREF=.FALSE.
      ALSO=0
      IF(SUPERF.OR..NOT.LDESCF) GO TO 2000
      DO 1000 I=1,OLNT
        IF(.NOT.QUAL(I,OBJ)) GO TO 1000
        IF((ODESCO(I).EQ.0).OR.
     1   ((OFLAG2(I).AND.TCHBT).NE.0)) GO TO 700
        CALL RSPEAK(ODESCO(I))
        ALSO=1
        IF(.NOT.QSEEIN(I).OR.QEMPTY(I)) GO TO 1000
        CALL RSPSUB(573,ODESC2(I))
        DO 500 J=1,OLNT
          IF(QUAL(J,I)) CALL RSPSUB(502,ODESC2(J))
  500   CONTINUE
        GO TO 1000
  700   MOREF=.TRUE.
 1000 CONTINUE
      IF(.NOT.MOREF) RETURN
C
 2000 CALL RSPSUB(DESC+ALSO,ODESC2(OBJ))
      DO 3000 I=1,OLNT
        IF(.NOT.QUAL(I,OBJ)) GO TO 3000
        IF((ALSO.NE.0).AND.(ODESCO(I).NE.0).AND.
     1    ((OFLAG2(I).AND.TCHBT).EQ.0)) GO TO 3000
        IF(.NOT.QSEEIN(I).OR.QEMPTY(I)) GO TO 2700
        CALL RSPSUB(1050,ODESC2(I))
        DO 2500 J=1,OLNT
          IF(QUAL(J,I)) CALL RSPSUB(1051,ODESC2(J))
 2500   CONTINUE
        GO TO 3000
 2700   CALL RSPSUB(502,ODESC2(I))
 3000 CONTINUE
      RETURN
C
      END
C MOVETO- MOVE PLAYER TO NEW ROOM
C
C DECLARATIONS
C
      LOGICAL FUNCTION MOVETO(NR,WHO)
      IMPLICIT INTEGER (A-Z)
*CALL DPARAM
      LOGICAL NLV,LHR,LNR
C
      MOVETO=.FALSE.
      LHR=(RFLAG(HERE).AND.RLAND).NE.0
      LNR=(RFLAG(NR).AND.RLAND).NE.0
      J=AVEHIC(WHO)
C
      IF(J.NE.0) GO TO 100
      IF(LNR) GO TO 500
      CALL RSPEAK(427)
      RETURN
C
  100 BITS=0
      IF(J.EQ.RBOAT) BITS=RWATER
      IF(J.EQ.BALLO) BITS=RAIR
      IF(J.EQ.BUCKE) BITS=RBUCK
      NLV=(RFLAG(NR).AND.BITS).EQ.0
      IF((.NOT.LNR .AND.NLV) .OR.
     1(LNR.AND.LHR.AND.NLV.AND.(BITS.NE.RLAND)))
     2GO TO 800
C
  500 MOVETO=.TRUE.
      IF((RFLAG(NR).AND.RMUNG).EQ.0) GO TO 600
      CALL RSPEAK(RDESC1(NR))
      RETURN
C
  600 IF(WHO.NE.PLAYER) CALL NEWSTA(AOBJ(WHO),0,NR,0,0)
      IF(J.NE.0) CALL NEWSTA(J,0,NR,0,0)
      HERE=NR
      AROOM(WHO)=HERE
      CALL SCRUPD(RVAL(NR))
      RVAL(NR)=0
      RETURN
C
  800 CALL RSPSUB(428,ODESC2(J))
      RETURN
C
      END
C SCORE-- PRINT OUT CURRENT SCORE
C
C DECLARATIONS
C
      SUBROUTINE SCORE(FLG)
      IMPLICIT INTEGER (A-Z)
*CALL DPARAM
      LOGICAL FLG
      INTEGER RANK(10),ERANK(5)
      CHARACTER*36 PFX
      CHARACTER*6 MVS
C
C FUNCTIONS AND DATA
C
      DATA RANK/20,19,18,16,12,8,4,2,1,0/
      DATA ERANK/20,15,10,5,0/
C
C NOS: THE SCORE LINE IS ASSEMBLED IN ONE WRITE, SINCE FTN5 HAS NO
C "$" EDIT DESCRIPTOR AND "+" OVERPRINT MEANS NOTHING ON A TERMINAL.
C
      MVS='MOVES.'
      IF(MOVES.EQ.1) MVS='MOVE.'
      AS=ASCORE(WINNER)
      IF(ENDGMF) GO TO 60
      PFX='YOUR SCORE IS'
      IF(FLG) PFX='YOUR SCORE WOULD BE'
      WRITE(OUTCH,120) PFX(1:NBLEN(PFX)),AS,MXSCOR,MOVES,
     1MVS(1:NBLEN(MVS))
      DO 10 I=1,10
        IF((AS*20/MXSCOR).GE.RANK(I)) GO TO 50
   10 CONTINUE
      CALL RSPEAK(886)
      RETURN
C
   50 CALL RSPEAK(484+I)
      RETURN
C
   60 PFX='YOUR SCORE IN THE ENDGAME IS'
      IF(FLG) PFX='YOUR SCORE IN THE ENDGAME WOULD BE'
      WRITE(OUTCH,120) PFX(1:NBLEN(PFX)),EGSCOR,EGMXSC,MOVES,
     1MVS(1:NBLEN(MVS))
      DO 70 I=1,5
        IF((EGSCOR*20/EGMXSC).GE.ERANK(I)) GO TO 80
   70 CONTINUE
      CALL RSPEAK(886)
      RETURN
C
   80 CALL RSPEAK(786+I)
      RETURN
C
  120 FORMAT(1X,A,I4,' [TOTAL OF',I4,' POINTS], IN',I5,1X,A)
C
      END
C SCRUPD- UPDATE WINNER'S SCORE
C
C DECLARATIONS
C
      SUBROUTINE SCRUPD(N)
      IMPLICIT INTEGER (A-Z)
*CALL DPARAM
C
      IF(ENDGMF) GO TO 100
      ASCORE(WINNER)=ASCORE(WINNER)+N
      RWSCOR=RWSCOR+N
      IF(ASCORE(WINNER).LT.(MXSCOR-(10*MIN0(1,DEATHS)))) RETURN
      CFLAG(CEVEGH)=.TRUE.
      CTICK(CEVEGH)=15
      RETURN
C
  100 EGSCOR=EGSCOR+N
      RETURN
C
      END
C FINDXT- FIND EXIT FROM ROOM
C
C DECLARATIONS
C
      LOGICAL FUNCTION FINDXT(DIR,RM)
      IMPLICIT INTEGER (A-Z)
*CALL DPARAM
C
      FINDXT=.TRUE.
      XI=REXIT(RM)
      IF(XI.EQ.0) GO TO 1000
C
  100 I=TRAVEL(XI)
      XROOM1=I.AND.XRMASK
      XTYPE=(((I.AND..NOT.XLFLAG)/XFSHFT).AND.XFMASK)+1
      GO TO (110,120,130,130),XTYPE
      CALL BUG(10,XTYPE)
C
  130 XOBJ=TRAVEL(XI+2).AND.XRMASK
      XACTIO=TRAVEL(XI+2)/XASHFT
  120 XSTRNG=TRAVEL(XI+1)
  110 XI=XI+XELNT(XTYPE)
      IF((I.AND.XDMASK).EQ.DIR) RETURN
      IF((I.AND.XLFLAG).EQ.0) GO TO 100
 1000 FINDXT=.FALSE.
      RETURN
C
      END
C FWIM- FIND WHAT I MEAN
C
C DECLARATIONS
C
      INTEGER FUNCTION FWIM(F1,F2,RM,CON,ADV,NOCARE)
      IMPLICIT INTEGER (A-Z)
*CALL DPARAM
      LOGICAL NOCARE
C
      FWIM=0
      DO 1000 I=1,OLNT
        IF(((RM.EQ.0).OR.(OROOM(I).NE.RM)) .AND.
     1((ADV.EQ.0).OR.(OADV(I).NE.ADV)) .AND.
     2((CON.EQ.0).OR.(OCAN(I).NE.CON)))
     3GO TO 1000
C
C OBJECT IS ON LIST... IS IT A MATCH?
C
        IF((OFLAG1(I).AND.VISIBT).EQ.0) GO TO 1000
        IF((.NOT.NOCARE .AND.((OFLAG1(I).AND.TAKEBT).EQ.0)) .OR.
     1(((OFLAG1(I).AND.F1).EQ.0).AND.
     2 ((OFLAG2(I).AND.F2).EQ.0))) GO TO 500
        IF(FWIM.EQ.0) GO TO 400
        FWIM=-FWIM
        RETURN
C
  400   FWIM=I
C
C DOES OBJECT CONTAIN A MATCH?
C
  500   IF((OFLAG2(I).AND.OPENBT).EQ.0) GO TO 1000
        DO 700 J=1,OLNT
          IF((OCAN(J).NE.I).OR.((OFLAG1(J).AND.VISIBT).EQ.0) .OR.
     1(((OFLAG1(J).AND.F1).EQ.0).AND.
     2 ((OFLAG2(J).AND.F2).EQ.0))) GO TO 700
          IF(FWIM.EQ.0) GO TO 600
          FWIM=-FWIM
          RETURN
C
  600     FWIM=J
  700   CONTINUE
 1000 CONTINUE
      RETURN
C
      END
C ORPHAN- SET UP ORPHANS FOR PARSER
C
C DECLARATIONS
C
      SUBROUTINE ORPHAN(OR1,OR2,OR3,OR4,OR5,OR6,OR7,OR8)
      IMPLICIT INTEGER(A-Z)
*CALL DPARAM
      CHARACTER*(*) OR6
C
      OFLAG=OR1
      OACT=OR2
      OPREP1=OR3
      OOBJ1=OR4
      OPREP=OR5
      ONAME=OR6
      OPREP2=OR7
      OOBJ2=OR8
      RETURN
C
      END
C YESNO- OBTAIN YES/NO ANSWER
C
C CALLED BY-
C
C YES-IS-TRUE=YESNO(QUESTION,YES-STRING,NO-STRING)
C
      LOGICAL FUNCTION YESNO(Q,Y,N)
      IMPLICIT INTEGER(A-Z)
*CALL DPARAM
      CHARACTER*1 ANS
C
  100 CALL RSPEAK(Q)
      READ(INPCH,110,END=120) ANS
  110 FORMAT(A)
      IF((ANS.EQ.'Y').OR.(ANS.EQ.'Y')) GO TO 200
      IF((ANS.EQ.'N').OR.(ANS.EQ.'N')) GO TO 300
  120 CALL RSPEAK(6)
      GO TO 100
C
  200 YESNO=.TRUE.
      CALL RSPEAK(Y)
      RETURN
C
  300 YESNO=.FALSE.
      CALL RSPEAK(N)
      RETURN
C
      END
C ROBADV-- STEAL WINNER'S VALUABLES
C
C DECLARATIONS
C
      INTEGER FUNCTION ROBADV(ADV,NR,NC,NA)
      IMPLICIT INTEGER (A-Z)
*CALL DPARAM
C
      ROBADV=0
      DO 100 I=1,OLNT
        IF((OADV(I).NE.ADV).OR.(OTVAL(I).LE.0).OR.
     1((OFLAG2(I).AND.SCRDBT).NE.0)) GO TO 100
        CALL NEWSTA(I,0,NR,NC,NA)
        ROBADV=ROBADV+1
  100 CONTINUE
      RETURN
C
      END
C ROBRM-- STEAL ROOM VALUABLES
C
C DECLARATIONS
C
      INTEGER FUNCTION ROBRM(RM,PR,NR,NC,NA)
      IMPLICIT INTEGER (A-Z)
*CALL DPARAM
      LOGICAL PROB,QHERE
C
      ROBRM=0
      DO 100 I=1,OLNT
        IF(.NOT. QHERE(I,RM)) GO TO 100
        IF((OTVAL(I).LE.0).OR.((OFLAG2(I).AND.SCRDBT).NE.0).OR.
     1((OFLAG1(I).AND.VISIBT).EQ.0).OR.(.NOT.PROB(PR,PR)))
     2GO TO 50
        CALL NEWSTA(I,0,NR,NC,NA)
        ROBRM=ROBRM+1
        OFLAG2(I)=OFLAG2(I).OR.TCHBT
        GO TO 100
   50   IF((OFLAG2(I).AND.ACTRBT).NE.0)
     1ROBRM=ROBRM+ROBADV(OACTOR(I),NR,NC,NA)
  100 CONTINUE
      RETURN
C
      END
C WINNIN-- SEE IF VILLAIN IS WINNING
C
C DECLARATIONS
C
      LOGICAL FUNCTION WINNIN(VL,HR)
      IMPLICIT INTEGER (A-Z)
*CALL DPARAM
      LOGICAL PROB
C
      VS=OCAPAC(VL)
      PS=VS-FIGHTS(HR,.TRUE.)
      WINNIN=PROB(90,100)
      IF(PS.GT.3) RETURN
      WINNIN=PROB(75,85)
      IF(PS.GT.0) RETURN
      WINNIN=PROB(50,30)
      IF(PS.EQ.0) RETURN
      WINNIN=PROB(25,25)
      IF(VS.GT.1) RETURN
      WINNIN=PROB(10,0)
      RETURN
C
      END
C FIGHTS-- COMPUTE FIGHT STRENGTH
C
C DECLARATIONS
C
      INTEGER FUNCTION FIGHTS(H,FLG)
      IMPLICIT INTEGER (A-Z)
*CALL DPARAM
      PARAMETER (STRMAX=7)
      PARAMETER (STRMIN=2)
      LOGICAL FLG
C
      FIGHTS=STRMIN+((((STRMAX-STRMIN)*ASCORE(H))+(MXSCOR/2))/MXSCOR)
      IF(FLG) FIGHTS=FIGHTS+ASTREN(H)
      RETURN
C
      END
C VILSTR- COMPUTE VILLAIN STRENGTH
C
C DECLARATIONS
C
      INTEGER FUNCTION VILSTR(V)
      IMPLICIT INTEGER (A-Z)
*CALL DPARAM
C
      VILSTR=OCAPAC(V)
      IF(VILSTR.LE.0) RETURN
      IF((V.NE.THIEF).OR..NOT.THFENF) GO TO 100
      THFENF=.FALSE.
      VILSTR=MIN0(VILSTR,2)
C
  100 DO 200 I=1,VLNT
        IF((VILLNS(I).EQ.V).AND.(PRSI.EQ.VBEST(I)))
     1VILSTR=MAX0(1,VILSTR-1)
  200 CONTINUE
      RETURN
C
      END
C GTTIME-- GET TOTAL TIME PLAYED
C
C DECLARATIONS
C
      SUBROUTINE GTTIME(T)
      IMPLICIT INTEGER(A-Z)
*CALL DPARAM
C
      CALL ITIME(H,M,S)
      T=((H*60)+M)-((SHOUR*60)+SMIN)
      IF(T.LT.0) T=T+1440
      T=T+PLTIME
      RETURN
C
      END
C OPNCLS-- PROCESS OPEN/CLOSE FOR DOORS
C
C DECLARATIONS
C
      LOGICAL FUNCTION OPNCLS(OBJ,SO,SC)
      IMPLICIT INTEGER (A-Z)
*CALL DPARAM
      LOGICAL QOPEN
C
C FUNCTIONS AND DATA
C
      QOPEN(O)=(OFLAG2(O).AND.OPENBT).NE.0
C
      OPNCLS=.TRUE.
      IF(PRSA.EQ.CLOSEW) GO TO 100
      IF(PRSA.EQ.OPENW) GO TO 50
      OPNCLS=.FALSE.
      RETURN
C
   50 IF(QOPEN(OBJ)) GO TO 200
      CALL RSPEAK(SO)
      OFLAG2(OBJ)=OFLAG2(OBJ).OR.OPENBT
      RETURN
C
  100 IF(.NOT.QOPEN(OBJ)) GO TO 200
      CALL RSPEAK(SC)
      OFLAG2(OBJ)=OFLAG2(OBJ).AND..NOT.OPENBT
      RETURN
C
  200 CALL RSPEAK(125+RND(3))
      RETURN
C
      END
C LIT-- IS ROOM LIT?
C
C DECLARATIONS
C
      LOGICAL FUNCTION LIT(RM)
      IMPLICIT INTEGER (A-Z)
*CALL DPARAM
      LOGICAL QHERE
C
      LIT=.TRUE.
      IF(DEADF.OR.((RFLAG(RM).AND.RLIGHT).NE.0)) RETURN
C
      DO 1000 I=1,OLNT
        IF(QHERE(I,RM)) GO TO 100
        OA=OADV(I)
        IF(OA.LE.0) GO TO 1000
        IF(AROOM(OA).NE.RM) GO TO 1000
C
C OBJ IN ROOM OR ON ADV IN ROOM
C
  100   IF((OFLAG1(I).AND.ONBT).NE.0) RETURN
        IF(((OFLAG1(I).AND.VISIBT).EQ.0).OR.
     1(((OFLAG1(I).AND.TRANBT).EQ.0).AND.
     2((OFLAG2(I).AND.OPENBT).EQ.0))) GO TO 1000
C
C OBJ IS VISIBLE AND OPEN OR TRANSPARENT
C
        DO 500 J=1,OLNT
          IF((OCAN(J).EQ.I).AND.((OFLAG1(J).AND.ONBT).NE.0))
     1RETURN
  500   CONTINUE
 1000 CONTINUE
      LIT=.FALSE.
      RETURN
C
      END
C WEIGHT- RETURNS SUM OF WEIGHT OF QUALIFYING OBJECTS
C
C DECLARATIONS
C
      INTEGER FUNCTION WEIGHT(RM,CN,AD)
      IMPLICIT INTEGER (A-Z)
*CALL DPARAM
      LOGICAL QHERE
C
      WEIGHT=0
      DO 100 I=1,OLNT
        IF(OSIZE(I).GE.10000) GO TO 100
        IF((QHERE(I,RM).AND.(RM.NE.0)).OR.
     1((OADV(I).EQ.AD).AND.(AD.NE.0))) GO TO 50
        J=I
   25   J=OCAN(J)
        IF(J.EQ.0) GO TO 100
        IF(J.NE.CN) GO TO 25
   50   WEIGHT=WEIGHT+OSIZE(I)
  100 CONTINUE
      RETURN
C
      END
C GHERE-- IS GLOBAL ACTUALLY IN THIS ROOM?
C
C DECLARATIONS
C
      LOGICAL FUNCTION GHERE(OBJ,RM)
      IMPLICIT INTEGER(A-Z)
*CALL DPARAM
C
      GHERE=.TRUE.
      IF(OBJ.LE.GLOBAL) RETURN
      GO TO ( 1000,2000,3000,4000,5000,5000,5000,6000,
     17000,8000,9000,9100,8000,10000,11000,
     212000,13000,14000,15000),OBJ-GLOBAL
      CALL BUG(60,OBJ)
C
C 1000-- HOUSE
C
 1000 GHERE=((RM.GE.WHOUS).AND.(RM.LE.EHOUS)).OR.
     1((RM.GE.FORE1).AND.(RM.LE.CLEAR)).OR.(RM.EQ.MTREE)
      RETURN
C
C 2000-- BIRD
C
 2000 GHERE=((RM.GE.FORE1).AND.(RM.LT.CLEAR)).OR.(RM.EQ.MTREE)
      RETURN
C
C 3000-- TREE
C
 3000 GHERE=((RM.GE.FORE1).AND.(RM.LT.CLEAR)).AND.(RM.NE.FORE3)
      RETURN
C
C 4000-- NORTH WALL
C
 4000 GHERE=((RM.GE.BKVW).AND.(RM.LE.BKBOX)).OR.(RM.EQ.CPUZZ)
      RETURN
C
C 5000-- EAST, SOUTH, WEST WALLS
C
 5000 GHERE=((RM.GE.BKVW).AND.(RM.LT.BKBOX)).OR.(RM.EQ.CPUZZ)
      RETURN
C
C 6000-- GLOBAL WATER
C
 6000 GHERE=(RFLAG(RM).AND.(RWATER+RFILL)).NE.0
      RETURN
C
C 7000-- GLOBAL GUARDIANS
C
 7000 GHERE=((RM.GE.MRC).AND.(RM.LE.MRD)).OR.
     1((RM.GE.MRCE).AND.(RM.LE.MRDW)).OR.(RM.EQ.INMIR)
      RETURN
C
C 8000-- ROSE/CHANNEL
C
 8000 GHERE=((RM.GE.MRA).AND.(RM.LE.MRD)).OR.(RM.EQ.INMIR)
      RETURN
C
C 9000-- MIRROR
C 9100  PANEL
C
 9100 IF(RM.EQ.FDOOR) RETURN
 9000 GHERE=((RM.GE.MRA).AND.(RM.LE.MRC)).OR.
     1((RM.GE.MRAE).AND.(RM.LE.MRCW))
      RETURN
C
C 10000-- MASTER
C
10000 GHERE=(RM.EQ.FDOOR).OR.(RM.EQ.NCORR).OR.(RM.EQ.PARAP).OR.
     1(RM.EQ.CELL).OR.(RM.EQ.PCELL).OR.(RM.EQ.NCELL)
      RETURN
C
C 11000-- LADDER
C
11000 GHERE=(RM.EQ.CPUZZ)
      RETURN
C
C 12000-- WELL
C
12000 GHERE=(RM.EQ.TWELL).OR.(RM.EQ.BWELL)
      RETURN
C
C 13000-- ROPE IN SLIDE
C
13000 GHERE=(RM.GE.SLID1).AND.(RM.LE.SLEDG)
      RETURN
C
C 14000-- SLIDE
C
14000 GHERE=(RM.GE.SLIDE).OR.((RM.GE.SLID1).AND.(RM.LE.SLEDG))
      RETURN
C
C 15000-- BUNCH PSEUDO OBJECT
C
15000 GHERE=.FALSE.
      RETURN
C
      END
C MRHERE-- IS MIRROR HERE?
C
C DECLARATIONS
C
      INTEGER FUNCTION MRHERE(RM)
      IMPLICIT INTEGER(A-Z)
*CALL DPARAM
C
      IF((RM.LT.MRAE).OR.(RM.GT.MRDW)) GO TO 100
C
C ROOM IS AN E-W ROOM, MIRROR MUST BE N-S (MDIR= 0 OR 180)
C
      MRHERE=1
      IF(MOD(RM-MRAE,2).EQ.(MDIR/180)) MRHERE=2
      RETURN
C
C ROOM IS NORTH OR SOUTH OF MIRROR.  IF MIRROR IS N-S OR NOT
C WITHIN ONE ROOM OF ROOM, LOSE.
C
  100 MRHERE=0
      IF((IABS(MLOC-RM).NE.1).OR.(MOD(MDIR,180).EQ.0)) RETURN
C
C ROOM IS WITHIN ONE OF MLOC, AND MDIR IS E-W
C
      MRHERE=1
      IF(((RM.LT.MLOC).AND.(MDIR.LT.180)).OR.
     1  ((RM.GT.MLOC).AND.(MDIR.GT.180))) MRHERE=2
      RETURN
C
      END
C ENCRYP-- ENCRYPT PASSWORD
C
C DECLARATIONS
C
      SUBROUTINE ENCRYP(INW,OUTW)
      IMPLICIT INTEGER(A-Z)
*CALL DPARAM
      CHARACTER*(WRDLNT) INW,OUTW,KEYW
      INTEGER UINW(8),UKEYW(8)
      DATA KEYW/'ECOVXRMS'/
C
      ICHARA=ICHAR('A')-1
      UINWS=0
      UKEYWS=0
      J=1
      DO 100 I=1,WRDLNT
        UKEYW(I)=ICHAR(KEYW(I:I))-ICHARA
C NOS: TEST FOR A LETTER BY COLLATING RANGE RATHER THAN BY ASCII CODE,
C SO THAT IT WORKS IN DISPLAY CODE TOO (BLANK SORTS ABOVE 'Z' THERE).
        IF((INW(J:J).LT.'A').OR.(INW(J:J).GT.'Z')) J=1
        UINW(I)=ICHAR(INW(J:J))-ICHARA
        UKEYWS=UKEYWS+UKEYW(I)
        UINWS=UINWS+UINW(I)
        J=J+1
  100 CONTINUE
C
      USUM=MOD(UINWS,8)+(8*MOD(UKEYWS,8))
      DO 200 I=1,8
        J=AND(XOR(XOR(UINW(I),UKEYW(I)),USUM),31)
        USUM=MOD(USUM+1,32)
        IF(J.GT.26) J=MOD(J,26)
        OUTW(I:I)=CHAR(MAX0(1,J)+ICHARA)
  200 CONTINUE
      RETURN
C
      END
C CPGOTO-- MOVE TO NEXT STATE IN PUZZLE ROOM
C
C DECLARATIONS
C
      SUBROUTINE CPGOTO(ST)
      IMPLICIT INTEGER(A-Z)
*CALL DPARAM
C
      RFLAG(CPUZZ)=RFLAG(CPUZZ).AND..NOT.RSEEN
      DO 100 I=1,OLNT
        IF((OROOM(I).EQ.CPUZZ).AND.
     1((OFLAG2(I).AND.(ACTRBT+VILLBT)).EQ.0))
     2CALL NEWSTA(I,0,CPHERE*HFACTR,0,0)
        IF(OROOM(I).EQ.(ST*HFACTR))
     1CALL NEWSTA(I,0,CPUZZ,0,0)
  100 CONTINUE
      CPHERE=ST
      RETURN
C
      END
C CPINFO-- DESCRIBE PUZZLE ROOM
C
C DECLARATIONS
C
      SUBROUTINE CPINFO(RMK,ST)
      IMPLICIT INTEGER(A-Z)
*CALL DPARAM
      INTEGER DGMOFT(8)
      CHARACTER*2 DGM(8),PICT(5),QMK
C
C FUNCTIONS AND LOCAL DATA
C
      DATA DGMOFT/-9,-8,-7,-1,1,7,8,9/
      DATA PICT/'SS','SS','SS','  ','MM'/
      DATA QMK/'??'/
C
      CALL RSPEAK(RMK)
      DO 100 I=1,8
        J=DGMOFT(I)
        DGM(I)=PICT(CPVEC(ST+J)+4)
        IF((IABS(J).EQ.1).OR.(IABS(J).EQ.8)) GO TO 100
        K=8
        IF(J.LT.0) K=-8
        L=J-K
        IF((CPVEC(ST+K).NE.0).AND.(CPVEC(ST+L).NE.0))
     1DGM(I)=QMK
  100 CONTINUE
      WRITE(OUTCH,10) DGM
C
      IF(ST.EQ.10) CALL RSPEAK(870)
      IF(ST.EQ.37) CALL RSPEAK(871)
      I=872
      IF(CPOUTF) I=873
      IF(ST.EQ.52) CALL RSPEAK(I)
      IF(CPVEC(ST+1).EQ.-2) CALL RSPEAK(874)
      IF(CPVEC(ST-1).EQ.-3) CALL RSPEAK(875)
      RETURN
C
   10 FORMAT('       |',A,1X,A,1X,A,'|'/,
     1' WEST  |',A,' .. ',A,'|  EAST',/
     2'       |',A,1X,A,1X,A,'|')
C
      END
C NBLEN- COMPUTE STRING LENGTH WITHOUT TRAILING BLANKS
C
C DECLARATIONS
C
      INTEGER FUNCTION NBLEN(STRING)
      IMPLICIT INTEGER(A-Z)
      CHARACTER*(*) STRING
C
      NBLEN=LEN(STRING)
  100 IF(NBLEN.LE.0) RETURN
      IF(STRING(NBLEN:NBLEN).NE.' ') RETURN
      NBLEN=NBLEN-1
      GO TO 100
C
      END
*DECK TIMEFNC
C CLOCK EVENTS, DEMONS, ACTORS FOR DUNGEON.
C
C COPYRIGHT 1980, 1990, INFOCOM COMPUTERS AND COMMUNICATIONS, CAMBRIDGE 
C ALL RIGHTS RESERVED, COMMERCIAL USAGE STRICTLY PROHIBITED
C WRITTEN BY R. M. SUPNIK
C
C CLOCKD- INTERMOVE CLOCK EVENTS DEMON
C
C DECLARATIONS
C
      LOGICAL FUNCTION CLOCKD(X)
      IMPLICIT INTEGER (A-Z)
*CALL DPARAM
C
      CLOCKD=.FALSE.
      DO 100 I=1,CLNT
        IF(.NOT.CFLAG(I) .OR.(CTICK(I).EQ.0)) GO TO 100
        IF(CTICK(I).LT.0) GO TO 50
        CTICK(I)=CTICK(I)-1
        IF(CTICK(I).NE.0) GO TO 100
   50   CLOCKD=.TRUE.
        CALL CEVAPP(CACTIO(I))
  100 CONTINUE
      RETURN
C
      END
C CEVAPP- CLOCK EVENT APPLICABLES
C
C DECLARATIONS
C
      SUBROUTINE CEVAPP(RI)
      IMPLICIT INTEGER (A-Z)
*CALL DPARAM
      INTEGER CNDTCK(10),LMPTCK(12)
      LOGICAL FINDXT,LIT,RMDESC,QOPEN,MOVETO
      LOGICAL F,QLEDGE,QVAIR,QHERE,PROB,WASLIT
C
C FUNCTIONS AND DATA
C
      QOPEN(R)=(OFLAG2(R).AND.OPENBT).NE.0
      QLEDGE(R)=(R.EQ.LEDG2).OR.(R.EQ.LEDG3).OR.(R.EQ.LEDG4).OR.
     1(R.EQ.VLBOT)
      QVAIR(R)=(R.EQ.VAIR1).OR.(R.EQ.VAIR2).OR.(R.EQ.VAIR3).OR.
     1 (R.EQ.VAIR4)
      DATA CNDTCK/50,20,10,5,0,156,156,156,157,0/
      DATA LMPTCK/50,30,20,10,4,0,154,154,154,154,155,0/
C
      IF(RI.EQ.0) RETURN
      WASLIT=LIT(HERE)
      GO TO (1000,2000,3000,4000,5000,6000,7000,8000,9000,10000,
     1 11000,12000,13000,14000,15000,16000,17000,18000,19000,
     2 20000,21000,22000,23000,24000,25000,26000,27000,28000,
     3 29000,30000),RI
      CALL BUG(3,RI)
C
C RETURN HERE TO TEST FOR CHANGE IN LIGHT.
C
   50 IF(WASLIT.AND..NOT.LIT(HERE)) CALL RSPEAK(406)
      RETURN
C CEVAPP, PAGE 2
C
C CEV1-- CURE CLOCK.  LET PLAYER SLOWLY RECOVER.
C
 1000 ASTREN(PLAYER)=MIN0(0,ASTREN(PLAYER)+1)
      IF(ASTREN(PLAYER).GE.0) RETURN
      CFLAG(CEVCUR)=.TRUE.
      CTICK(CEVCUR)=30
      RETURN
C
C CEV2-- MAINT-ROOM WITH LEAK.  RAISE THE WATER LEVEL.
C
 2000 IF(HERE.EQ.MAINT) CALL RSPEAK(71+(RVMNT/2))
      RVMNT=RVMNT+1
      IF(RVMNT.LE.16) RETURN
      CTICK(CEVMNT)=0
      RFLAG(MAINT)=RFLAG(MAINT).OR.RMUNG
      RDESC1(MAINT)=80
      IF(HERE.EQ.MAINT) CALL JIGSUP(81)
      RETURN
C
C CEV3-- LANTERN.  DESCRIBE GROWING DIMNESS.
C
 3000 CALL LITINT(LAMP,ORLAMP,CEVLNT,LMPTCK,12)
      GO TO 50
C
C CEV4-- MATCH.  OUT IT GOES.
C
 4000 CALL RSPEAK(153)
      OFLAG1(MATCH)=OFLAG1(MATCH).AND. .NOT.(ONBT+FLAMBT+LITEBT)
      GO TO 50
C
C CEV5-- CANDLE.  DESCRIBE GROWING DIMNESS.
C
 5000 CALL LITINT(CANDL,ORCAND,CEVCND,CNDTCK,10)
      GO TO 50
C CEVAPP, PAGE 3
C
C CEV6-- BALLOON.
C
 6000 CFLAG(CEVBAL)=.TRUE.
      CTICK(CEVBAL)=3
      F=AVEHIC(WINNER).EQ.BALLO
      IF(BLOC.EQ.VLBOT) GO TO 6800
      IF(QLEDGE(BLOC)) GO TO 6700
      IF(QOPEN(RECEP).AND.(BINFF.NE.0))
     1GO TO 6500
C
C BALLOON IS IN MIDAIR AND IS DEFLATED (OR HAS RECEPTACLE CLOSED).
C FALL TO NEXT ROOM.
C
      IF(BLOC.NE.VAIR1) GO TO 6300
      BLOC=VLBOT
      CALL NEWSTA(BALLO,0,BLOC,0,0)
      IF(F) GO TO 6200
      IF(QLEDGE(HERE).OR.(HERE.EQ.VLBOT))
     1CALL RSPEAK(530)
      RETURN
C
 6200 F=MOVETO(BLOC,WINNER)
      IF(BINFF.EQ.0) GO TO 6250
      CALL RSPEAK(531)
      F=RMDESC(0)
      RETURN
C
 6250 CALL NEWSTA(BALLO,532,0,0,0)
      CALL NEWSTA(DBALL,0,BLOC,0,0)
      AVEHIC(WINNER)=0
      CFLAG(CEVBAL)=.FALSE.
      CFLAG(CEVBRN)=.FALSE.
      BINFF=0
      BTIEF=0
      RETURN
C
 6300 BLOC=BLOC-1
      CALL NEWSTA(BALLO,0,BLOC,0,0)
      IF(F) GO TO 6400
      IF(QLEDGE(HERE).OR.(HERE.EQ.VLBOT))
     1CALL RSPEAK(533)
      RETURN
C
 6400 F=MOVETO(BLOC,WINNER)
      CALL RSPEAK(534)
      F=RMDESC(0)
      RETURN
C
C BALLOON IS IN MIDAIR AND IS INFLATED, UP-UP-AND-AWAY!
C
 6500 IF(BLOC.NE.VAIR4) GO TO 6600
      CFLAG(CEVBRN)=.FALSE.
      CFLAG(CEVBAL)=.FALSE.
      BINFF=0
      BTIEF=0
      BLOC=VLBOT
      CALL NEWSTA(BALLO,0,0,0,0)
      CALL NEWSTA(DBALL,0,BLOC,0,0)
      IF(F) GO TO 6550
      IF(QLEDGE(HERE)) CALL RSPEAK(535)
      IF(HERE.EQ.VLBOT) CALL RSPEAK(925)
      RETURN
C
 6550 CALL JIGSUP(536)
      RETURN
C
 6600 BLOC=BLOC+1
      CALL NEWSTA(BALLO,0,BLOC,0,0)
      IF(F) GO TO 6650
      IF(QLEDGE(HERE).OR.(HERE.EQ.VLBOT))
     1CALL RSPEAK(537)
      RETURN
C
 6650 F=MOVETO(BLOC,WINNER)
      CALL RSPEAK(538)
      F=RMDESC(0)
      RETURN
C
C ON LEDGE, GOES TO MIDAIR ROOM WHETHER INFLATED OR NOT.
C
 6700 BLOC=BLOC+(VAIR2-LEDG2)
      CALL NEWSTA(BALLO,0,BLOC,0,0)
      IF(F) GO TO 6750
      IF(QLEDGE(HERE).OR.(HERE.EQ.VLBOT))
     1CALL RSPEAK(539)
      CFLAG(CEVVLG)=.TRUE.
      CTICK(CEVVLG)=10
      RETURN
C
 6750 F=MOVETO(BLOC,WINNER)
      CALL RSPEAK(540)
      F=RMDESC(0)
      RETURN
C
C AT BOTTOM, GO UP IF INFLATED, DO NOTHING IF DEFLATED.
C
 6800 IF((BINFF.EQ.0).OR..NOT.QOPEN(RECEP)) RETURN
      BLOC=VAIR1
      CALL NEWSTA(BALLO,0,BLOC,0,0)
      IF(F) GO TO 6850
      IF(QLEDGE(HERE).OR.(HERE.EQ.VLBOT))
     1CALL RSPEAK(541)
      RETURN
C
 6850 F=MOVETO(BLOC,WINNER)
      CALL RSPEAK(542)
      F=RMDESC(0)
      RETURN
C CEVAPP, PAGE 4
C
C CEV7-- BALLOON BURNUP.
C
 7000 DO 7100 I=1,OLNT
        IF((RECEP.EQ.OCAN(I)).AND.((OFLAG1(I).AND.FLAMBT).NE.0))
     1GO TO 7200
 7100 CONTINUE
      CALL BUG(4,0)
C
 7200 CALL NEWSTA(I,0,0,0,0)
      BINFF=0
      IF(HERE.EQ.BLOC) CALL RSPSUB(292,ODESC2(I))
      RETURN
C
C CEV8-- FUSE FUNCTION.
C
 8000 IF(OCAN(FUSE).NE.BRICK) GO TO 8500
      BR=OROOM(BRICK)
      BC=OCAN(BRICK)
      IF((BR.EQ.0).AND.(BC.NE.0)) BR=OROOM(BC)
      IF(BR.EQ.0) BR=HERE
      CALL NEWSTA(FUSE,0,0,0,0)
      CALL NEWSTA(BRICK,0,0,0,0)
      IF(BR.NE.HERE) GO TO 8100
C
      RFLAG(HERE)=RFLAG(HERE).OR.RMUNG
      RDESC1(HERE)=114
      CALL JIGSUP(150)
      RETURN
C
 8100 CALL RSPEAK(151)
      MUNGRM=BR
      CFLAG(CEVSAF)=.TRUE.
      CTICK(CEVSAF)=5
      IF(BR.NE.MSAFE) GO TO 8200
      IF(BC.NE.SSLOT) RETURN
      CALL NEWSTA(SSLOT,0,0,0,0)
      OFLAG2(SAFE)=OFLAG2(SAFE).OR.OPENBT
      SAFEF=.TRUE.
      RETURN
C
 8200 DO 8250 I=1,OLNT
        IF(QHERE(I,BR) .AND. ((OFLAG1(I).AND.TAKEBT).NE.0))
     1CALL NEWSTA(I,0,0,0,0)
 8250 CONTINUE
      IF(BR.NE.LROOM) RETURN
      DO 8300 I=1,OLNT
        IF(OCAN(I).EQ.TCASE) CALL NEWSTA(I,0,0,0,0)
 8300 CONTINUE
      RETURN
C
 8500 IF(QHERE(FUSE,HERE).OR.(OADV(FUSE).EQ.WINNER))
     1CALL RSPEAK(152)
      CALL NEWSTA(FUSE,0,0,0,0)
      RETURN
C CEVAPP, PAGE 5
C
C CEV9-- LEDGE MUNGE.
C
 9000 RFLAG(LEDG4)=RFLAG(LEDG4).OR.RMUNG
      RDESC1(LEDG4)=109
      IF(HERE.EQ.LEDG4) GO TO 9100
      CALL RSPEAK(110)
      RETURN
C
 9100 IF(AVEHIC(WINNER).NE.0) GO TO 9200
      CALL JIGSUP(111)
      RETURN
C
 9200 IF(BTIEF.NE.0) GO TO 9300
      CALL RSPEAK(112)
      RETURN
C
 9300 BLOC=VLBOT
      CALL NEWSTA(BALLO,0,0,0,0)
      CALL NEWSTA(DBALL,0,BLOC,0,0)
      BTIEF=0
      BINFF=0
      CFLAG(CEVBAL)=.FALSE.
      CFLAG(CEVBRN)=.FALSE.
      CALL JIGSUP(113)
      RETURN
C
C CEV10-- SAFE MUNGE.
C
10000 RFLAG(MUNGRM)=RFLAG(MUNGRM).OR.RMUNG
      RDESC1(MUNGRM)=114
      IF(HERE.EQ.MUNGRM) GO TO 10100
      CALL RSPEAK(115)
      IF(MUNGRM.NE.MSAFE) RETURN
      CFLAG(CEVLED)=.TRUE.
      CTICK(CEVLED)=8
      RETURN
C
10100 I=116
      IF((RFLAG(HERE).AND.RHOUSE).NE.0) I=117
      CALL JIGSUP(I)
      RETURN
C CEVAPP, PAGE 6
C
C CEV11-- VOLCANO GNOME ENTRANCE.
C
11000 IF(QLEDGE(HERE)) GO TO 11100
      CFLAG(CEVVLG)=.TRUE.
      CTICK(CEVVLG)=1
      RETURN
C
11100 CALL NEWSTA(GNOME,118,HERE,0,0)
      RETURN
C
C CEV12-- VOLCANO GNOME EXIT.
C
12000 IF(OROOM(GNOME).EQ.HERE) CALL RSPEAK(149)
      CALL NEWSTA(GNOME,0,0,0,0)
      RETURN
C
C CEV13-- BUCKET.
C
13000 IF(OCAN(WATER).EQ.BUCKE)
     1CALL NEWSTA(WATER,0,0,0,0)
      RETURN
C
C CEV14-- SPHERE.  IF EXPIRES, HE'S TRAPPED.
C
14000 RFLAG(CAGER)=RFLAG(CAGER).OR.RMUNG
      RDESC1(CAGER)=147
      WINNER=PLAYER
      CALL JIGSUP(148)
      RETURN
C
C CEV15-- END GAME HERALD.
C
15000 ENDGMF=.TRUE.
      CALL RSPEAK(119)
      RETURN
C CEVAPP, PAGE 7
C
C CEV16-- FOREST MURMURS.
C
16000 CFLAG(CEVFOR)=(HERE.EQ.MTREE).OR.
     1((HERE.GE.FORE1).AND.(HERE.LT.CLEAR))
      IF(CFLAG(CEVFOR).AND.PROB(10,10)) CALL RSPEAK(635)
      RETURN
C
C CEV17-- SCOL ALARM.
C
17000 IF(HERE.EQ.BKVAU) CALL JIGSUP(636)
      IF(ZGNOMF.OR.(HERE.NE.BKTWI)) RETURN
      ZGNOMF=.TRUE.
      CFLAG(CEVZGI)=.TRUE.
      CTICK(CEVZGI)=5
      RETURN
C
C CEV18-- GNOME OF ZURICH ENTRANCE.
C
18000 IF(HERE.NE.BKTWI) RETURN
      CFLAG(CEVZGO)=.TRUE.
      CTICK(CEVZGO)=12
      CALL NEWSTA(ZGNOM,637,BKTWI,0,0)
      RETURN
C
C CEV19-- GNOME OF ZURICH EXITS.
C
19000 CALL NEWSTA(ZGNOM,0,0,0,0)
      IF(HERE.EQ.BKTWI) CALL RSPEAK(638)
      RETURN
C CEVAPP, PAGE 8
C
C CEV20-- START OF ENDGAME.
C
20000 IF(SPELLF) GO TO 20200
      IF(HERE.NE.CRYPT) RETURN
      IF(.NOT.LIT(HERE)) GO TO 20100
      CFLAG(CEVSTE)=.TRUE.
      CTICK(CEVSTE)=3
      RETURN
C
20100 CALL RSPEAK(727)
20200 DO 20300 I=1,OLNT
        CALL NEWSTA(I,0,OROOM(I),OCAN(I),0)
20300 CONTINUE
      CALL NEWSTA(LAMP,0,0,0,PLAYER)
      CALL NEWSTA(SWORD,0,0,0,PLAYER)
C
      OFLAG1(LAMP)=(OFLAG1(LAMP).OR.LITEBT).AND. .NOT.ONBT
      OFLAG2(LAMP)=OFLAG2(LAMP).OR.TCHBT
      CFLAG(CEVLNT)=.FALSE.
      CTICK(CEVLNT)=350
      ORLAMP=0
      OFLAG2(SWORD)=OFLAG2(SWORD).OR.TCHBT
      SWDACT=.TRUE.
      SWDSTA=0
C
      THFACT=.FALSE.
      ENDGMF=.TRUE.
      CFLAG(CEVMAT)=.FALSE.
      CFLAG(CEVCND)=.FALSE.
C
      CALL SCRUPD(RVAL(CRYPT))
      RVAL(CRYPT)=0
      F=MOVETO(TSTRS,WINNER)
      F=RMDESC(3)
      RETURN
C
C CEV21-- MIRROR CLOSES.
C
21000 MRPSHF=.FALSE.
      MROPNF=.FALSE.
      IF(HERE.EQ.MRANT) CALL RSPEAK(728)
      IF((HERE.EQ.INMIR).OR.(MRHERE(HERE).EQ.1))
     1CALL RSPEAK(729)
      RETURN
C CEVAPP, PAGE 9
C
C CEV22-- DOOR CLOSES.
C
22000 IF(WDOPNF) CALL RSPEAK(730)
      WDOPNF=.FALSE.
      RETURN
C
C CEV23-- INQUISITOR'S QUESTION.
C
23000 IF(AROOM(PLAYER).NE.FDOOR) RETURN
      CALL RSPEAK(769)
      CALL RSPEAK(770+QUESNO)
      CFLAG(CEVINQ)=.TRUE.
      CTICK(CEVINQ)=2
      RETURN
C
C CEV24-- MASTER FOLLOWS.
C
24000 IF(AROOM(AMASTR).EQ.HERE) RETURN
      IF((HERE.NE.CELL).AND.(HERE.NE.PCELL)) GO TO 24100
      IF(FOLLWF) CALL RSPEAK(811)
      FOLLWF=.FALSE.
      RETURN
C
24100 FOLLWF=.TRUE.
      I=812
      DO 24200 J=XMIN,XMAX,XMIN
        IF(FINDXT(J,AROOM(AMASTR)).AND.(XROOM1.EQ.HERE))
     1I=813
24200 CONTINUE
      CALL RSPEAK(I)
      CALL NEWSTA(MASTER,0,HERE,0,0)
      AROOM(AMASTR)=HERE
      RETURN
C
C CEV25-- BROCHURE ARRIVES.
C
25000 CALL NEWSTA(BROCH,948,0,MAILB,0)
      BROC2F=.TRUE.
      RETURN
C CEVAPP, PAGE 10
C
C CEV26-- CYCLOPS.
C
26000 IF(HERE.NE.MCYCL.OR.MAGICF) GO TO 26500
      IF(CYCLOF) RETURN
      IF(IABS(RVCYC).LE.5) GO TO 26200
      CFLAG(CEVCYC)=.FALSE.
      CALL JIGSUP(188)
      RETURN
C
26200 IF(RVCYC.LT.0) RVCYC=RVCYC-1
      IF(RVCYC.GE.0) RVCYC=RVCYC+1
      CALL RSPEAK(193+IABS(RVCYC))
      RETURN
C
26500 CFLAG(CEVCYC)=.FALSE.
      RETURN
C
C CEV27-- SLIPPERY SLIDE.
C
27000 IF((HERE.LT.SLID1).OR.(HERE.GE.SLEDG)) RETURN
      CALL RSPEAK(1034)
      F=MOVETO(CELLA,WINNER)
      F=RMDESC(3)
      RETURN
C
C CEV28-- EXORCISM BELL.
C
28000 IF(.NOT.EXORCF.AND.(HERE.EQ.LLD1)) CALL RSPEAK(970)
      EXORBF=.FALSE.
      RETURN
C
C CEV29-- EXORCISM CANDLES.
C
29000 EXORCF=.FALSE.
      GO TO 28000
C
C CEV30-- HOT BELL COOLS DOWN.
C
30000 CALL NEWSTA(HBELL,0,0,0,0)
      CALL NEWSTA(BELL,0,LLD1,0,0)
      IF(HERE.EQ.LLD1) CALL RSPEAK(971)
      RETURN
C
      END
C LITINT- LIGHT INTERRUPT PROCESSOR
C
C DECLARATIONS
C
      SUBROUTINE LITINT(OBJ,CTR,CEV,TICKS,TICKLN)
      IMPLICIT INTEGER (A-Z)
*CALL DPARAM
      INTEGER TICKS(TICKLN)
C
      CTR=CTR+1
      CTICK(CEV)=TICKS(CTR)
      IF(CTICK(CEV).NE.0) GO TO 100
      OFLAG1(OBJ)=OFLAG1(OBJ).AND. .NOT.(LITEBT+FLAMBT+ONBT)
      IF((OROOM(OBJ).EQ.HERE).OR.(OADV(OBJ).EQ.WINNER))
     1CALL RSPSUB(293,ODESC2(OBJ))
      RETURN
C
  100 CFLAG(CEV)=.TRUE.
      IF((OROOM(OBJ).EQ.HERE).OR.(OADV(OBJ).EQ.WINNER))
     1CALL RSPEAK(TICKS(CTR+(TICKLN/2)))
      RETURN
C
      END
C FIGHTD- INTERMOVE FIGHT DEMON
C
C DECLARATIONS
C
      SUBROUTINE FIGHTD
      IMPLICIT INTEGER (A-Z)
*CALL DPARAM
      LOGICAL PROB,OAPPLI,F
C
C FUNCTIONS AND DATA
C
      DATA ROUT/1/
C FIGHTD, PAGE 2
C
      DO 2400 I=1,VLNT
        VOPPS(I)=0
        OBJ=VILLNS(I)
        RA=OACTIO(OBJ)
        IF(HERE.NE.OROOM(OBJ)) GO TO 2200
        IF((OBJ.EQ.THIEF).AND.THFENF) GO TO 2400
        IF(OCAPAC(OBJ).GE.0) GO TO 2050
        IF((VPROB(I).EQ.0).OR..NOT.PROB(VPROB(I),VPROB(I)))
     1GO TO 2025
        OCAPAC(OBJ)=IABS(OCAPAC(OBJ))
        VPROB(I)=0
        IF(RA.EQ.0) GO TO 2400
        PRSA=INXW
        F=OAPPLI(RA,0)
        GO TO 2400
C
 2025   VPROB(I)=VPROB(I)+10
        GO TO 2400
C
 2050   IF((OFLAG2(OBJ).AND.FITEBT).EQ.0) GO TO 2100
        VOPPS(I)=OBJ
        GO TO 2400
C
 2100   IF(RA.EQ.0) GO TO 2400
        PRSA=FRSTQW
        IF(.NOT.OAPPLI(RA,0)) GO TO 2400
        OFLAG2(OBJ)=OFLAG2(OBJ).OR.FITEBT
        VOPPS(I)=OBJ
        PRSCON=0
        GO TO 2400
C
 2200   IF(((OFLAG2(OBJ).AND.FITEBT).EQ.0).OR.(RA.EQ.0))
     1GO TO 2300
        PRSA=FIGHTW
        F=OAPPLI(RA,0)
 2300   IF(OBJ.EQ.THIEF) THFENF=.FALSE.
        AFLAG(PLAYER)=AFLAG(PLAYER).AND. .NOT.ASTAG
        OFLAG2(OBJ)=OFLAG2(OBJ).AND. .NOT.(STAGBT+FITEBT)
        IF((OCAPAC(OBJ).GE.0).OR.(RA.EQ.0))
     1GO TO 2400
        PRSA=INXW
        F=OAPPLI(RA,0)
        OCAPAC(OBJ)=IABS(OCAPAC(OBJ))
 2400 CONTINUE
C FIGHTD, PAGE 3
C
C NOW DO ACTUAL COUNTERBLOWS.
C
      OUT=0
 2600 DO 2700 I=1,VLNT
        J=VOPPS(I)
        IF(J.EQ.0) GO TO 2700
        PRSCON=0
        RA=OACTIO(J)
        IF(RA.EQ.0) GO TO 2650
        PRSA=FIGHTW
        IF(OAPPLI(RA,0)) GO TO 2700
 2650   RES=BLOW(PLAYER,J,VMELEE(I),.FALSE.,OUT)
        IF(RES.LT.0) RETURN
        IF(RES.EQ.ROUT) OUT=2+RND(3)
 2700 CONTINUE
      OUT=OUT-1
      IF(OUT.GT.0) GO TO 2600
      RETURN
C
      END
C BLOW- STRIKE BLOW
C
C DECLARATIONS
C
      INTEGER FUNCTION BLOW(H,V,RMK,HFLG,OUT)
      IMPLICIT INTEGER (A-Z)
*CALL DPARAM
      LOGICAL HFLG,OAPPLI,PROB,F
      INTEGER DEF1R(3),DEF2R(4),DEF3R(5)
      INTEGER RVECTR(66),RSTATE(45)
C
C FUNCTIONS AND DATA
C
      DATA RMISS/0/,ROUT/1/,RKILL/2/,RXXX/3/
      DATA RSER/4/,RSTAG/5/,RLOSE/6/,RHES/7/,RSIT/8/
      DATA DEF1R/1,2,3/
      DATA DEF2R/13,23,24,25/
      DATA DEF3R/35,36,46,47,57/
C
      DATA RVECTR/0,0,0,0,5,5,1,1,2,2,2,2,
     10,0,0,0,0,5,5,3,3,1,
     20,0,0,5,5,3,3,3,1,2,2,2,
     30,0,0,0,0,5,5,3,3,4,4,
     40,0,0,5,5,3,3,3,4,4,4,
     50,5,5,3,3,3,3,4,4,4/
      DATA RSTATE/5000,3005,3008,4011,3015,3018,1021,0,0,
     15022,3027,3030,4033,3037,3040,1043,0,0,
     24044,2048,4050,4054,5058,4063,4067,3071,1074,
     34075,1079,4080,4084,4088,4092,4096,4100,1104,
     44105,2109,4111,4115,4119,4123,4127,3131,3134/
C BLOW, PAGE 2
C
      RA=OACTIO(V)
      DV=ODESC2(V)
      BLOW=RMISS
C DEBUG:  TYPE 10,H,V,RMK,HFLG,OUT
C DEBUG: 10 FORMAT(' BLOW 10-- ',3I7,L7,I7)
      IF(.NOT.HFLG) GO TO 1000
C
C HERO IS ATTACKER, VILLAIN IS DEFENDER.
C
      PBLOSE=10
      OFLAG2(V)=OFLAG2(V).OR.FITEBT
      IF((AFLAG(H).AND.ASTAG).EQ.0) GO TO 100
      CALL RSPEAK(591)
      AFLAG(H)=AFLAG(H).AND. .NOT.ASTAG
      RETURN
C
  100 ATT=MAX0(1,FIGHTS(H,.TRUE.))
      OA=ATT
      DEF=VILSTR(V)
      OD=DEF
      DWEAP=0
      DO 200 I=1,OLNT
        IF((OCAN(I).EQ.V).AND.((OFLAG2(I).AND.WEAPBT).NE.0))
     1DWEAP=I
  200 CONTINUE
      IF(V.EQ.AOBJ(PLAYER)) GO TO 300
      IF(DEF.NE.0) GO TO 2000
      CALL RSPSUB(592,DV)
      RETURN
C
  300 CALL JIGSUP(593)
      RETURN
C
C VILLAIN IS ATTACKER, HERO IS DEFENDER.
C
 1000 PRSCON=0
      PBLOSE=50
      AFLAG(H)=AFLAG(H).AND..NOT.ASTAG
      IF((OFLAG2(V).AND.STAGBT).EQ.0) GO TO 1200
      OFLAG2(V)=OFLAG2(V).AND. .NOT.STAGBT
      CALL RSPSUB(594,DV)
      RETURN
C
 1200 ATT=VILSTR(V)
      OA=ATT
      DEF=FIGHTS(H,.TRUE.)
      IF(DEF.LE.0) RETURN
      OD=FIGHTS(H,.FALSE.)
      DWEAP=IABS(FWIM(0,WEAPBT,0,0,H,.TRUE.))
C BLOW, PAGE 3
C
C PARTIES ARE NOW EQUIPPED.  DEF CANNOT BE ZERO.
C ATT MUST BE > 0.
C
 2000 CONTINUE
C DEBUG:  TYPE 2050,ATT,OA,DEF,OD,DWEAP
C DEBUG: 2050 FORMAT(' BLOW 2050-- ',5I7)
      IF(DEF.GT.0) GO TO 2100
      RES=RKILL
      IF(HFLG) CALL RSPSUB(595,DV)
      GO TO 3000
C
 2100 IF(DEF-2) 2200,2300,2400
 2200 ATT=MIN0(ATT,3)
      TBL=DEF1R(ATT)
      GO TO 2500
C
 2300 ATT=MIN0(ATT,4)
      TBL=DEF2R(ATT)
      GO TO 2500
C
 2400 ATT=ATT-DEF
      ATT=MIN0(2,MAX0(-2,ATT))+3
      TBL=DEF3R(ATT)
C
 2500 RES=RVECTR(TBL+RND(10))
      IF(OUT.EQ.0) GO TO 2600
      IF(RES.EQ.RSTAG) GO TO 2550
      RES=RSIT
      GO TO 2600
 2550 RES=RHES
 2600 IF((RES.EQ.RSTAG).AND.(DWEAP.NE.0).AND.PROB(25,PBLOSE))
     1RES=RLOSE
C
      MI=RSTATE(((RMK-1)*9)+RES+1)
      IF(MI.EQ.0) GO TO 3000
      I=(MOD(MI,1000)+RND(MI/1000))+MBASE+1
      J=DV
      IF(.NOT.HFLG .AND.(DWEAP.NE.0)) J=ODESC2(DWEAP)
C DEBUG:  TYPE 2650,RES,MI,I,J,MBASE
C DEBUG: 2650 FORMAT(' BLOW 2650-- ',5I7)
      CALL RSPSUB(I,J)
C BLOW, PAGE 4
C
C NOW APPLY RESULT.
C
 3000 GO TO (4000,3100,3200,3300,3400,3500,3600,4000,3200),RES+1
C
 3100 IF(HFLG) DEF=-DEF
      GO TO 4000
C
 3200 DEF=0
      GO TO 4000
C
 3300 DEF=MAX0(0,DEF-1)
      GO TO 4000
C
 3400 DEF=MAX0(0,DEF-2)
      GO TO 4000
C
 3500 IF(HFLG) GO TO 3550
      AFLAG(H)=AFLAG(H).OR.ASTAG
      GO TO 4000
C
 3550 OFLAG2(V)=OFLAG2(V).OR.STAGBT
      GO TO 4000
C
 3600 CALL NEWSTA(DWEAP,0,HERE,0,0)
      DWEAP=0
      IF(HFLG) GO TO 4000
      DWEAP=IABS(FWIM(0,WEAPBT,0,0,H,.TRUE.))
      IF(DWEAP.NE.0) CALL RSPSUB(605,ODESC2(DWEAP))
C BLOW, PAGE 5
C
 4000 BLOW=RES
      IF(.NOT.HFLG) GO TO 4500
      OCAPAC(V)=DEF
      IF(DEF.NE.0) GO TO 4100
      OFLAG2(V)=OFLAG2(V).AND. .NOT.FITEBT
      CALL RSPSUB(572,DV)
      CALL NEWSTA(V,0,0,0,0)
      IF(RA.EQ.0) RETURN
      PRSA=DEADXW
      F=OAPPLI(RA,0)
      RETURN
C
 4100 IF((RES.NE.ROUT).OR.(RA.EQ.0)) RETURN
      PRSA=OUTXW
      F=OAPPLI(RA,0)
      RETURN
C
 4500 ASTREN(H)=-10000
      IF(DEF.NE.0) ASTREN(H)=DEF-OD
      IF(DEF.GE.OD) GO TO 4600
      CTICK(CEVCUR)=30
      CFLAG(CEVCUR)=.TRUE.
 4600 IF(FIGHTS(H,.TRUE.).GT.0) RETURN
      ASTREN(H)=1-FIGHTS(H,.FALSE.)
      CALL JIGSUP(596)
      BLOW=-1
      RETURN
C
      END
C SWORDD- INTERMOVE SWORD DEMON
C
C DECLARATIONS
C
      SUBROUTINE SWORDD
      IMPLICIT INTEGER(A-Z)
*CALL DPARAM
      LOGICAL INFEST,FINDXT
C
      IF(OADV(SWORD).NE.PLAYER) GO TO 500
      NG=2
      IF(INFEST(HERE)) GO TO 300
      NG=1
      DO 200 I=XMIN,XMAX,XMIN
        IF(.NOT.FINDXT(I,HERE)) GO TO 200
        GO TO (50,200,50,50),XTYPE
   50   IF(INFEST(XROOM1)) GO TO 300
  200 CONTINUE
      NG=0
C
  300 IF(NG.EQ.SWDSTA) RETURN
      CALL RSPEAK(NG+495)
      SWDSTA=NG
      RETURN
C
  500 SWDACT=.FALSE.
      RETURN
      END
C INFEST- SUBROUTINE TO TEST FOR INFESTED ROOM
C
C DECLARATIONS
C
      LOGICAL FUNCTION INFEST(R)
      IMPLICIT INTEGER(A-Z)
*CALL DPARAM
C
      IF(.NOT.ENDGMF) INFEST=(OROOM(CYCLO).EQ.R).OR.
     1(OROOM(TROLL).EQ.R).OR.
     2((OROOM(THIEF).EQ.R).AND.THFACT)
      IF(ENDGMF) INFEST=(R.EQ.MRG).OR.(R.EQ.MRGE).OR.
     1(R.EQ.MRGW).OR.
     2((R.EQ.INMIR).AND.(MLOC.EQ.MRG))
      RETURN
      END
C AAPPLI- APPLICABLES FOR ADVENTURERS
C
C DECLARATIONS
C
      LOGICAL FUNCTION AAPPLI(RI)
      IMPLICIT INTEGER (A-Z)
*CALL DPARAM
      LOGICAL F,MOVETO,QHERE,FINDXT
C
      IF(RI.EQ.0) GO TO 10
      AAPPLI=.TRUE.
      GO TO (1000,2000,3000),RI
      CALL BUG(11,RI)
C
C COMMON FALSE RETURN.
C
   10 AAPPLI=.FALSE.
      RETURN
C AAPPLI, PAGE 2
C
C A1-- DEAD PLAYER.
C
 1000 IF((PRSA.NE.ATTACW).AND.(PRSA.NE.MUNGW).AND.
     1  (PRSA.NE.KILLW).AND.(PRSA.NE.SWINGW).AND.
     2  (PRSA.NE.KICKW).AND.(PRSA.NE.BLASTW)) GO TO 1050
      CALL RSPEAK(949)
      RETURN
C
 1050 IF((PRSA.NE.OPENW).AND.(PRSA.NE.CLOSEW).AND.
     1  (PRSA.NE.EATW).AND.(PRSA.NE.DRINKW).AND.
     2  (PRSA.NE.INFLAW).AND.(PRSA.NE.DEFLAW).AND.
     3  (PRSA.NE.TURNW).AND.(PRSA.NE.TIEW).AND.
     4  (PRSA.NE.BURNW).AND.(PRSA.NE.UNTIEW)) GO TO 1100
      CALL RSPEAK(950)
      RETURN
C
 1100 IF(PRSA.NE.TRNONW) GO TO 1150
      CALL RSPEAK(951)
      RETURN
C
 1150 IF(PRSA.NE.SCOREW) GO TO 1200
      CALL RSPEAK(952)
      RETURN
C
 1200 IF(PRSA.NE.TELLW) GO TO 1250
      CALL RSPEAK(953)
      RETURN
C
 1250 IF(PRSA.NE.TAKEW) GO TO 1300
      CALL RSPEAK(954)
      RETURN
C
 1300 IF((PRSA.NE.DROPW).AND.(PRSA.NE.THROWW).AND.
     1  (PRSA.NE.INVENW)) GO TO 1350
      CALL RSPEAK(955)
      RETURN
C
 1350 IF(PRSA.NE.DIAGNW) GO TO 1400
      CALL RSPEAK(956)
      RETURN
C
 1400 IF(PRSA.NE.LOOKW) GO TO 1500
      I=957
      DO 1450 J=1,OLNT
        IF(QHERE(J,HERE)) I=958
 1450 CONTINUE
      CALL RSPEAK(I)
      IF((RFLAG(HERE).AND.RLIGHT).NE.0) CALL RSPEAK(959)
      GO TO 10
C
 1500 IF(PRSA.NE.PRAYW) GO TO 1600
      IF(HERE.EQ.TEMP2) GO TO 1550
      CALL RSPEAK(960)
      RETURN
C
 1550 OFLAG1(LAMP)=OFLAG1(LAMP).OR.VISIBT
      OACTIO(PLAYER)=0
      DEADF=.FALSE.
      F=MOVETO(FORE1,WINNER)
      CALL RSPEAK(9)
      RETURN
C
 1600 IF(PRSA.NE.WALKW) GO TO 1700
      IF(.NOT.FINDXT(PRSO,HERE)) GO TO 10
      IF(XROOM1.NE.BSHAF) GO TO 10
      CALL RSPEAK(962)
      RETURN
C
 1700 IF(PRSA.EQ.QUITW) GO TO 10
      CALL RSPEAK(963)
      RETURN
C
C A2-- ROBOT.  PROCESS MOST COMMANDS GIVEN TO ROBOT.
C
 2000 IF((PRSA.NE.RAISEW).OR.(PRSO.NE.RCAGE)) GO TO 2200
      CFLAG(CEVSPH)=.FALSE.
      WINNER=PLAYER
      F=MOVETO(CAGER,WINNER)
      CALL NEWSTA(CAGE,567,CAGER,0,0)
      CALL NEWSTA(ROBOT,0,CAGER,0,0)
      AROOM(AROBOT)=CAGER
      CAGESF=.TRUE.
      OFLAG1(ROBOT)=OFLAG1(ROBOT).AND..NOT.NDSCBT
      OFLAG1(SPHER)=OFLAG1(SPHER).OR.TAKEBT
      PRSCON=0
      RETURN
C
 2200 IF((PRSA.NE.DRINKW).AND.(PRSA.NE.EATW)) GO TO 2300
      CALL RSPEAK(568)
      RETURN
C
 2300 IF(PRSA.NE.READW) GO TO 2400
      CALL RSPEAK(569)
      RETURN
C
 2400 IF((PRSA.EQ.WALKW).OR.(PRSA.EQ.TAKEW).OR.(PRSA.EQ.DROPW)
     1 .OR.(PRSA.EQ.PUTW).OR.(PRSA.EQ.PUSHW).OR.(PRSA.EQ.THROWW)
     2 .OR.(PRSA.EQ.TURNW).OR.(PRSA.EQ.LEAPW)) GO TO 2500
      CALL RSPEAK(570)
      RETURN
C
 2500 CALL RSPEAK(930)
      GO TO 10
C AAPPLI, PAGE 3
C
C A3-- MASTER.  PROCESS MOST COMMANDS GIVEN TO MASTER.
C
 3000 IF((OFLAG2(QDOOR).AND.OPENBT).NE.0) GO TO 3100
      CALL RSPEAK(783)
      RETURN
C
 3100 IF(PRSA.NE.WALKW) GO TO 3200
      I=784
      IF(((HERE.EQ.SCORR).AND.
     1((PRSO.EQ.XNORTH).OR.(PRSO.EQ.XENTER))).OR.
     2  ((HERE.EQ.NCORR).AND.
     3((PRSO.EQ.XSOUTH).OR.(PRSO.EQ.XENTER))))
     4I=785
      CALL RSPEAK(I)
      RETURN
C
 3200 IF((PRSA.EQ.TAKEW).OR.(PRSA.EQ.DROPW).OR.(PRSA.EQ.PUTW).OR.
     1  (PRSA.EQ.THROWW).OR.(PRSA.EQ.PUSHW).OR.(PRSA.EQ.TURNW).OR.
     2  (PRSA.EQ.SPINW).OR.(PRSA.EQ.TRNTOW).OR.(PRSA.EQ.FOLLOW).OR.
     3  (PRSA.EQ.STAYW).OR.(PRSA.EQ.OPENW).OR.(PRSA.EQ.CLOSEW).OR.
     4  (PRSA.EQ.KILLW)) GO TO 10
      CALL RSPEAK(786)
      RETURN
C
      END
C THIEFD- INTERMOVE THIEF DEMON
C
C DECLARATIONS
C
      SUBROUTINE THIEFD
      IMPLICIT INTEGER (A-Z)
*CALL DPARAM
      LOGICAL DFLAG,ONCE,PROB,QHERE,QSTILL,LIT,WINNIN,WASLIT
C
C FUNCTIONS AND DATA
C
      QSTILL(R)=(QHERE(STILL,R).OR.(OADV(STILL).EQ.-THIEF))
C THIEFD, PAGE 2
C
      DFLAG=(PRSFLG.AND.32).NE.0
      ONCE=.FALSE.
 1025 WASLIT=LIT(HERE)
      RHERE=OROOM(THIEF)
      IF(RHERE.NE.0) THFPOS=RHERE
C
      IF((THFPOS.EQ.HERE).AND..NOT.DEADF) GO TO 1100
      IF(THFPOS.NE.TREAS) GO TO 1400
C
C THIEF IS IN TREASURE ROOM, AND WINNER IS NOT.
C
      IF(DFLAG) PRINT 10
   10 FORMAT(' THIEFD-- IN TREASURE ROOM')
      IF(RHERE.EQ.0) GO TO 1050
      CALL NEWSTA(THIEF,0,0,0,0)
      RHERE=0
      IF(QSTILL(TREAS)) CALL NEWSTA(STILL,0,0,THIEF,0)
      DO 1040 I=1,OLNT
        IF(QHERE(I,THFPOS))
     1OFLAG1(I)=OFLAG1(I).OR.VISIBT
 1040 CONTINUE
 1050 I=ROBADV(-THIEF,THFPOS,0,0)
      IF(QHERE(EGG,THFPOS)) OFLAG2(EGG)=OFLAG2(EGG).OR.OPENBT
      GO TO 1700
C
C THIEF AND (LIVE) WINNER IN SAME ROOM.
C
 1100 IF(THFPOS.EQ.TREAS) GO TO 1700
      IF((RFLAG(THFPOS).AND.RLIGHT).NE.0) GO TO 1400
      IF(DFLAG) PRINT 20
   20 FORMAT(' THIEFD-- IN ADV ROOM')
      IF(THFFLG) GO TO 1300
      IF((RHERE.NE.0).OR.PROB(70,70)) GO TO 1150
      IF(OCAN(STILL).NE.THIEF) GO TO 1700
      CALL NEWSTA(THIEF,583,THFPOS,0,0)
      THFFLG=.TRUE.
      RETURN
C
 1150 IF((RHERE.EQ.0).OR.((OFLAG2(THIEF).AND.FITEBT).EQ.0))
     1GO TO 1200
      IF(WINNIN(THIEF,PLAYER)) GO TO 1175
      CALL NEWSTA(THIEF,584,0,0,0)
      OFLAG2(THIEF)=OFLAG2(THIEF).AND. .NOT.FITEBT
      IF(QSTILL(THFPOS)) CALL NEWSTA(STILL,0,0,THIEF,0)
      RETURN
C
 1175 IF(PROB(90,90)) GO TO 1700
C
 1200 IF((RHERE.EQ.0).OR.PROB(70,70)) GO TO 1250
      CALL NEWSTA(THIEF,585,0,0,0)
      IF(QSTILL(THFPOS)) CALL NEWSTA(STILL,0,0,THIEF,0)
      RETURN
C
 1300 IF(RHERE.EQ.0) GO TO 1700
 1250 IF(PROB(70,70)) RETURN
      THFFLG=.TRUE.
      NR=ROBRM(THFPOS,100,0,0,-THIEF)+ROBADV(PLAYER,0,0,-THIEF)
      I=586
      IF(RHERE.NE.0) I=588
      CALL NEWSTA(THIEF,I+MIN0(1,NR),0,0,0)
      IF(QSTILL(THFPOS))
     1CALL NEWSTA(STILL,0,0,THIEF,0)
      IF(WASLIT.AND..NOT.LIT(HERE).AND.(HERE.EQ.AROOM(PLAYER)))
     1CALL RSPEAK(915)
      RHERE=0
      GO TO 1700
C
C NOT IN ADVENTURERS ROOM, OR ADVENTURER DEAD, OR ROOM LIT.
C
 1400 CALL NEWSTA(THIEF,0,0,0,0)
      RHERE=0
      IF(DFLAG) PRINT 30,THFPOS
   30 FORMAT(' THIEFD-- IN ROOM ',I4)
      IF(QSTILL(THFPOS))
     1CALL NEWSTA(STILL,0,0,THIEF,0)
      IF((RFLAG(THFPOS).AND.RSEEN).EQ.0) GO TO 1700
      I=ROBRM(THFPOS,75,0,0,-THIEF)
      IF((THFPOS.LT.MAZE1).OR.(THFPOS.GT.MAZ15).OR.
     1(HERE.LT.MAZE1).OR.(HERE.GT.MAZ15)) GO TO 1500
      DO 1450 I=1,OLNT
        IF(.NOT.QHERE(I,THFPOS).OR.PROB(60,60).OR.
     1((OFLAG1(I).AND.(VISIBT+TAKEBT)).NE.(VISIBT+TAKEBT)))
     2GO TO 1450
        CALL RSPSUB(590,ODESC2(I))
        IF(PROB(40,20)) GO TO 1700
        CALL NEWSTA(I,0,0,0,-THIEF)
        OFLAG2(I)=OFLAG2(I).OR.TCHBT
        GO TO 1700
 1450 CONTINUE
      GO TO 1700
C
 1500 DO 1550 I=1,OLNT
        IF(.NOT.QHERE(I,THFPOS).OR.(OTVAL(I).NE.0).OR.PROB(80,60).OR.
     1((OFLAG1(I).AND.(VISIBT+TAKEBT)).NE.(VISIBT+TAKEBT)))
     2GO TO 1550
        CALL NEWSTA(I,0,0,0,-THIEF)
        OFLAG2(I)=OFLAG2(I).OR.TCHBT
        IF((THFPOS.EQ.HERE).AND..NOT.DEADF)
     1CALL RSPSUB(1045,ODESC2(I))
        GO TO 1700
 1550 CONTINUE
C
C NOW MOVE TO NEW ROOM.
C
 1700 IF(OADV(ROPE).NE.-THIEF) GO TO 1725
      DOMEF=.FALSE.
      TTIE=0
 1725 IF(ONCE) GO TO 1800
      ONCE=.NOT.ONCE
 1750 THFPOS=THFPOS-1
      IF(THFPOS.LE.0) THFPOS=RLNT
      IF((RFLAG(THFPOS).AND.(RLAND+RSACRD+REND)).NE.RLAND)
     1GO TO 1750
      THFFLG=.FALSE.
      GO TO 1025
C
C ALL DONE.
C
 1800 IF(THFPOS.EQ.TREAS) RETURN
      J=591
      IF(THFPOS.NE.HERE) J=0
      DO 1850 I=1,OLNT
        IF((OADV(I).NE.-THIEF).OR.PROB(70,30).OR.
     1(OTVAL(I).GT.0)) GO TO 1850
        CALL NEWSTA(I,J,THFPOS,0,0)
        J=0
 1850 CONTINUE
      RETURN
C
      END
*DECK VERBS
C VERB PROCESSORS FOR DUNGEON
C
C COPYRIGHT 1980, 1990, INFOCOM COMPUTERS AND COMMUNICATIONS, CAMBRIDGE 
C ALL RIGHTS RESERVED, COMMERCIAL USAGE STRICTLY PROHIBITED
C WRITTEN BY R. M. SUPNIK
C
C VAPPLI- MAIN VERB PROCESSING ROUTINE
C
C DECLARATIONS
C
      LOGICAL FUNCTION VAPPLI(RI)
      IMPLICIT INTEGER (A-Z)
*CALL DPARAM
      LOGICAL LIT,OBJACT,WASLIT
      LOGICAL QEMPTY,RMDESC,CLOCKD
      LOGICAL MOVETO,YESNO
      LOGICAL QOPEN,EDIBLE,DRKBLE
      LOGICAL TAKE,PUT,DROP,WALK
      LOGICAL QHERE,FINDXT,OAPPLI,F
      CHARACTER*8 HRS,MNS
      INTEGER JOKES(25),ANSWER(28)
      CHARACTER*81 ANSSTR
      CHARACTER*(WRDLNT) PW(2),CH
      PARAMETER (MXNOP=39,MXJOKE=64,MXSMP=99)
C
C FUNCTIONS AND DATA
C
      QOPEN(R)=(OFLAG2(R).AND.OPENBT).NE.0
      EDIBLE(R)=(OFLAG1(R).AND.FOODBT).NE.0
      DRKBLE(R)=(OFLAG1(R).AND.DRNKBT).NE.0
      DATA JOKES/4,5,3,304,305,306,307,308,309,310,311,312,
     1313,5314,5319,324,325,883,884,120,120,0,0,0,0/
      DATA ANSWER/0,6,1,6,2,5,3,5,4,3,4,6,4,7,
     14,5,5,5,5,4,5,8,6,11,7,4,7,6/
      DATA ANSSTR/'TEMPLEFOREST30003FLASKRUBFONDLECARRESS
     1TOUCHBONESBODYSKELETONRUSTY KNIFENONENOWHERE'/
C VAPPLI, PAGE 2
C
      VAPPLI=.TRUE.
      IF(PRSO.NE.0) ODO2=ODESC2(PRSO)
      IF(PRSI.NE.0) ODI2=ODESC2(PRSI)
      AV=AVEHIC(WINNER)
      RMK=372+RND(6)
      IF(RI.EQ.0) GO TO 10
      IF(RI.LE.MXNOP) RETURN
      IF(RI.LE.MXJOKE) GO TO 20
      IF(RI.LE.MXSMP) GO TO 30
      WASLIT=LIT(HERE)
      GO TO (
     1   500, 1000, 2000, 3000, 4000, 5000, 6000, 7000, 8000, 9000,
     2 10000,11000,12000,13000,14000,15000,16000,17000,18000,19000,
     3 20000,21000,22000,23000,24000,25000,26000,27000,28000,29000,
     4 30000,31000,32000,33000,34000,35000,36000,37000,38000,39000,
     5 40000,41000,42000,43000,44000,45000,46000,47000,48000,49000,
     6 50000,51000,52000,53000,54000,55000,56000,57000,58000,59000,
     7 60000,61000,62000,63000,64000,65000,66000,67000,68000,69000),
     8(RI-MXSMP)
      CALL BUG(7,RI)
C
C ALL VERB PROCESSORS RETURN HERE TO DECLARE FAILURE.
C
   10 VAPPLI=.FALSE.
      RETURN
C
C JOKE PROCESSOR.
C FIND PROPER ENTRY IN JOKES, USE IT TO SELECT STRING TO PRINT.
C
   20 I=JOKES(RI-MXNOP)
      J=I/1000
      IF(J.NE.0) I=MOD(I,1000)+RND(J)
      CALL RSPEAK(I)
      RETURN
C
C 'SIMPLE' VERBS.
C
   30 GO TO (65001,66001,67001,68001,69001,
     1 70000,71000,72000,73000,74000,75000,76000,77000,78000,79000,
     2 80000,81000,82000,83000,84000,85000,86000,87000,88000,89000,
     3 90000,91000,92000,93000,94000,95000,96000),
     4(RI-MXJOKE)
      CALL BUG(7,RI)
C
C HERE TO TEST FOR CHANGE IN LIGHT.
C
   50 IF(WASLIT.AND..NOT.LIT(HERE)) CALL RSPEAK(406)
      RETURN
C VAPPLI, PAGE 3
C
C V100-- READ
C
  500 IF(LIT(HERE)) GO TO 600
      CALL RSPEAK(356)
      RETURN
C
  600 IF(PRSI.EQ.0) GO TO 700
      IF((OFLAG1(PRSI).AND.TRANBT).NE.0) GO TO 700
      CALL RSPSUB(357,ODI2)
      RETURN
C
  700 IF(OBJACT(X)) RETURN
      IF((OFLAG1(PRSO).AND.READBT).NE.0) GO TO 800
      CALL RSPSUB(358,ODO2)
      RETURN
C
  800 CALL RSPEAK(OREAD(PRSO))
      RETURN
C
C V101-- MELT
C
 1000 IF(.NOT.OBJACT(X)) CALL RSPSUB(361,ODO2)
      RETURN
C
C V102-- INFLATE
C
 2000 IF(.NOT.OBJACT(X)) CALL RSPEAK(368)
      RETURN
C
C V103-- DEFLATE.
C
 3000 IF(.NOT.OBJACT(X)) CALL RSPEAK(369)
      RETURN
C VAPPLI, PAGE 4
C
C V104-- ALARM
C
 4000 IF((OFLAG2(PRSO).AND.SLEPBT).EQ.0) GO TO 4100
      VAPPLI=OBJACT(X)
      RETURN
C
 4100 CALL RSPSUB(370,ODO2)
      RETURN
C
C V105-- EXORCISE
C
 5000 F=OBJACT(X)
      RETURN
C
C V106-- PLUG
C
 6000 IF(.NOT.OBJACT(X)) CALL RSPEAK(371)
      RETURN
C
C V107-- KICK
C
 7000 IF(.NOT.OBJACT(X)) CALL RSPSB2(378,ODO2,RMK)
      RETURN
C
C V108-- WAVE
C
 8000 IF(.NOT.OBJACT(X)) CALL RSPSB2(379,ODO2,RMK)
      RETURN
C
C V109,V110-- RAISE, LOWER
C
 9000 CONTINUE
10000 IF(.NOT.OBJACT(X)) CALL RSPSB2(380,ODO2,RMK)
      RETURN
C
C V111-- RUB
C
11000 IF(.NOT.OBJACT(X)) CALL RSPSB2(381,ODO2,RMK)
      RETURN
C
C V112-- PUSH
C
12000 IF(.NOT.OBJACT(X)) CALL RSPSB2(382,ODO2,RMK)
      RETURN
C VAPPLI, PAGE 5
C
C V113-- UNTIE
C
13000 IF(OBJACT(X)) RETURN
      I=383
      IF((OFLAG2(PRSO).AND.TIEBT).EQ.0) I=384
      CALL RSPEAK(I)
      RETURN
C
C V114-- TIE
C
14000 IF((OFLAG2(PRSO).AND.TIEBT).NE.0) GO TO 14100
      CALL RSPEAK(385)
      RETURN
C
14100 IF(OBJACT(X)) RETURN
      I=386
      IF(PRSI.EQ.OPLAY) I=919
      CALL RSPSUB(386,ODO2)
      RETURN
C
C V115-- TIE UP
C
15000 IF((OFLAG2(PRSI).AND.TIEBT).NE.0) GO TO 15100
      CALL RSPSUB(387,ODO2)
      RETURN
C
15100 I=388
      IF((OFLAG2(PRSO).AND.VILLBT).EQ.0) I=389
      CALL RSPSUB(I,ODO2)
      RETURN
C
C V116-- TURN
C
16000 IF((OFLAG1(PRSO).AND.TURNBT).NE.0) GO TO 16100
      CALL RSPEAK(390)
      RETURN
C
16100 IF((OFLAG1(PRSI).AND.TOOLBT).NE.0) GO TO 16200
      CALL RSPSUB(391,ODI2)
      RETURN
C
16200 VAPPLI=OBJACT(X)
      RETURN
C
C V117-- BREATHE
C
17000 PRSA=INFLAW
      PRSI=LUNGS
      GO TO 2000
C VAPPLI, PAGE 5A.
C
C V118-- KNOCK
C
18000 IF(OBJACT(X)) RETURN
      I=394
      IF((OFLAG1(PRSO).AND.DOORBT).EQ.0) I=395
      CALL RSPSUB(I,ODO2)
      RETURN
C
C V119-- LOOK
C
19000 IF(PRSO.NE.0) GO TO 20500
      VAPPLI=RMDESC(3)
      RETURN
C
C V120-- EXAMINE
C
20000 IF(PRSO.NE.0) GO TO 20500
      VAPPLI=RMDESC(0)
      RETURN
C
20500 IF(OBJACT(X)) RETURN
      I=OREAD(PRSO)
      IF(I.NE.0) CALL RSPEAK(I)
      IF(I.EQ.0) CALL RSPSUB(429,ODO2)
      PRSA=FOOW
      RETURN
C
C V121-- SHAKE
C
21000 IF(OBJACT(X)) RETURN
      IF((OFLAG2(PRSO).AND.VILLBT).EQ.0) GO TO 21100
      CALL RSPEAK(371)
      RETURN
C
21100 IF((OFLAG1(PRSO).AND.TAKEBT).NE.0) GO TO 21200
      CALL RSPEAK(923)
      RETURN
C
21200 IF(QEMPTY(PRSO)) GO TO 10
      IF(QOPEN(PRSO)) GO TO 21300
      CALL RSPSUB(396,ODO2)
      RETURN
C
21300 CALL RSPSUB(397,ODO2)
      DO 21500 I=1,OLNT
        IF(OCAN(I).NE.PRSO) GO TO 21500
        OFLAG2(I)=OFLAG2(I).OR.TCHBT
        IF(AV.EQ.0) GO TO 21400
        CALL NEWSTA(I,0,0,AV,0)
        GO TO 21500
C
21400   CALL NEWSTA(I,0,HERE,0,0)
        IF(I.EQ.WATER) CALL NEWSTA(I,133,0,0,0)
21500 CONTINUE
      RETURN
C VAPPLI, PAGE 6
C
C V122-- MOVE
C
22000 IF(.NOT.QHERE(PRSO,HERE)) GO TO 22100
      IF(OBJACT(X)) RETURN
      I=399
      IF((OFLAG1(PRSO).AND.TAKEBT).NE.0) I=887
      CALL RSPSUB(I,ODO2)
      RETURN
C
22100 CALL RSPEAK(398)
      RETURN
C
C V123-- TURN ON
C
23000 IF(OBJACT(X)) RETURN
      IF(((OFLAG1(PRSO).AND.LITEBT).NE.0).AND.
     1(OADV(PRSO).EQ.WINNER)) GO TO 23100
      CALL RSPEAK(400)
      RETURN
C
23100 IF((OFLAG1(PRSO).AND.ONBT).EQ.0) GO TO 23200
      CALL RSPEAK(401)
      RETURN
C
23200 OFLAG1(PRSO)=OFLAG1(PRSO).OR.ONBT
      CALL RSPSUB(404,ODO2)
      RETURN
C
C V124-- TURN OFF
C
24000 IF(OBJACT(X)) RETURN
      IF(((OFLAG1(PRSO).AND.LITEBT).NE.0).AND.
     1(OADV(PRSO).EQ.WINNER)) GO TO 24100
      CALL RSPEAK(402)
      RETURN
C
24100 IF((OFLAG1(PRSO).AND.ONBT).NE.0) GO TO 24200
      CALL RSPEAK(403)
      RETURN
C
24200 OFLAG1(PRSO)=OFLAG1(PRSO).AND. .NOT.ONBT
      CALL RSPSUB(405,ODO2)
      GO TO 50
C
C V125-- OPEN
C
25000 IF(OBJACT(X)) RETURN
      IF((OFLAG1(PRSO).AND.DOORBT).NE.0) GO TO 25150
      IF((OFLAG1(PRSO).AND.CONTBT).NE.0) GO TO 25100
25050 CALL RSPSUB(407,ODO2)
      RETURN
C
25100 IF(OCAPAC(PRSO).NE.0) GO TO 25200
25150 CALL RSPSUB(408,ODO2)
      RETURN
C
25200 IF(.NOT.QOPEN(PRSO)) GO TO 25225
      CALL RSPEAK(412)
      RETURN
C
25225 OFLAG2(PRSO)=OFLAG2(PRSO).OR.OPENBT
      IF(((OFLAG1(PRSO).AND.TRANBT).NE.0).OR.QEMPTY(PRSO))
     1GO TO 25300
      CALL PRINCO(PRSO,410,.FALSE.)
      RETURN
C
25300 CALL RSPEAK(409)
      RETURN
C
C V126-- CLOSE
C
26000 IF(OBJACT(X)) RETURN
      IF((OFLAG1(PRSO).AND.DOORBT).NE.0) GO TO 26050
      IF((OFLAG1(PRSO).AND.CONTBT).EQ.0) GO TO 25050
      IF(OCAPAC(PRSO).NE.0) GO TO 26100
26050 CALL RSPSUB(411,ODO2)
      RETURN
C
26100 IF(QOPEN(PRSO)) GO TO 26200
      CALL RSPEAK(413)
      RETURN
C
26200 OFLAG2(PRSO)=OFLAG2(PRSO).AND. .NOT.OPENBT
      CALL RSPEAK(414)
      GO TO 50
C VAPPLI, PAGE 7
C
C V127-- FIND
C
27000 IF(OBJACT(X)) RETURN
      I=415
      IF(QHERE(PRSO,HERE)) GO TO 27200
      I=416
      IF(OADV(PRSO).EQ.WINNER) GO TO 27200
      J=OCAN(PRSO)
      IF(J.EQ.0) GO TO 10
      IF((((OFLAG1(J).AND.TRANBT).EQ.0).AND.
     1 (.NOT.QOPEN(J).OR.((OFLAG1(J).AND.(DOORBT+CONTBT)).EQ.0))))
     2GO TO 10
      I=417
      IF(QHERE(J,HERE)) GO TO 27100
      I=418
      IF(OADV(J).NE.WINNER) GO TO 10
27100 CALL RSPSUB(I,ODESC2(J))
      RETURN
C
27200 CALL RSPSUB(I,ODO2)
      RETURN
C
C V128-- WAIT
C
28000 CALL RSPEAK(419)
      DO 28100 I=1,3
        IF(CLOCKD(X)) RETURN
        IF(.NOT.DEADF) CALL FIGHTD
        IF(PRSCON.EQ.0) RETURN
28100 CONTINUE
      RETURN
C
C V129-- SPIN
C V159-- TURN TO
C
29000 CONTINUE
59000 IF(.NOT.OBJACT(X)) CALL RSPEAK(663)
      RETURN
C
C V130-- BOARD
C
30000 IF((OFLAG2(PRSO).AND.VEHBT).NE.0) GO TO 30100
      CALL RSPSUB(421,ODO2)
      PRSCON=0
      RETURN
C
30100 IF(QHERE(PRSO,HERE)) GO TO 30200
      CALL RSPSUB(420,ODO2)
      PRSCON=0
      RETURN
C
30200 IF(AV.EQ.0) GO TO 30300
      CALL RSPSUB(422,ODO2)
      PRSCON=0
      RETURN
C
30300 IF(OBJACT(X)) RETURN
      CALL RSPSUB(423,ODO2)
      AVEHIC(WINNER)=PRSO
      IF(WINNER.NE.PLAYER) CALL NEWSTA(AOBJ(WINNER),0,0,PRSO,0)
      RETURN
C
C V131-- DISEMBARK
C
31000 IF(AV.EQ.PRSO) GO TO 31100
      CALL RSPEAK(424)
      PRSCON=0
      RETURN
C
31100 IF(OBJACT(X)) RETURN
      IF((RFLAG(HERE).AND.RLAND).NE.0) GO TO 31200
      CALL RSPEAK(425)
      PRSCON=0
      RETURN
C
31200 AVEHIC(WINNER)=0
      CALL RSPEAK(426)
      IF(WINNER.NE.PLAYER) CALL NEWSTA(AOBJ(WINNER),0,HERE,0,0)
      RETURN
C
C V132-- TAKE
C
32000 VAPPLI=TAKE(.TRUE.)
      RETURN
C
C V133-- INVENTORY
C
33000 CALL INVENT(WINNER)
      RETURN
C VAPPLI, PAGE 8
C
C V134-- FILL
C
34000 IF(PRSI.NE.0) GO TO 34050
      IF((RFLAG(HERE).AND.(RWATER+RFILL)).NE.0) GO TO 34025
      CALL RSPEAK(516)
      PRSWON=.FALSE.
      CALL ORPHAN(-1,ACT,PREP1,PRSO,2,' ',0,0)
      GO TO 10
C
34025 PRSI=GWATE
34050 IF(OBJACT(X)) RETURN
      IF((PRSI.NE.GWATE).AND.(PRSI.NE.WATER))
     1CALL RSPSB2(444,ODO2,ODI2)
      RETURN
C
C V135,V136-- EAT/DRINK
C
35000 CONTINUE
36000 IF(OBJACT(X)) RETURN
      IF(PRSO.EQ.GWATE) GO TO 36500
      IF(.NOT.EDIBLE(PRSO)) GO TO 36400
      IF(OADV(PRSO).EQ.WINNER) GO TO 36200
36100 CALL RSPSUB(454,ODO2)
      RETURN
C
36200 IF(PRSA.EQ.DRINKW) GO TO 36300
      CALL NEWSTA(PRSO,455,0,0,0)
      RETURN
C
36300 CALL RSPEAK(456)
      RETURN
C
36400 IF(.NOT.DRKBLE(PRSO)) GO TO 36600
      IF(OCAN(PRSO).EQ.0) GO TO 36100
      IF(OADV(OCAN(PRSO)).NE.WINNER) GO TO 36100
      IF(QOPEN(OCAN(PRSO))) GO TO 36500
      CALL RSPEAK(457)
      RETURN
C
36500 CALL NEWSTA(PRSO,458,0,0,0)
      RETURN
C
36600 CALL RSPSUB(453,ODO2)
      RETURN
C
C V137-- BURN
C
37000 IF((OFLAG1(PRSI).AND.(FLAMBT+LITEBT+ONBT)).NE.
     1(FLAMBT+LITEBT+ONBT)) GO TO 37400
      IF(OBJACT(X)) RETURN
      IF(OCAN(PRSO).NE.RECEP) GO TO 37050
      VAPPLI=OAPPLI(OACTIO(BALLO),0)
      RETURN
37050 IF((OFLAG1(PRSO).AND.BURNBT).EQ.0) GO TO 37300
      IF(OADV(PRSO).NE.WINNER) GO TO 37100
      CALL RSPSUB(459,ODO2)
      CALL JIGSUP(460)
      RETURN
C
37100 J=OCAN(PRSO)
      IF(QHERE(PRSO,HERE).OR. ((AV.NE.0).AND.(J.EQ.AV)))
     1GO TO 37200
      IF(J.EQ.0) GO TO 37150
      IF(.NOT.QOPEN(J)) GO TO 37150
      IF(QHERE(J,HERE).OR.((AV.NE.0).AND.(OCAN(J).EQ.AV)))
     1GO TO 37200
37150 CALL RSPEAK(461)
      RETURN
C
37200 CALL RSPSUB(462,ODO2)
      CALL NEWSTA(PRSO,0,0,0,0)
      RETURN
C
37300 CALL RSPSUB(463,ODO2)
      RETURN
C
37400 CALL RSPSUB(301,ODI2)
      RETURN
C VAPPLI, PAGE 9
C
C V138-- MUNG
C
38000 I=466
      IF((OFLAG2(PRSO).AND.VILLBT).NE.0) GO TO 41100
      IF(.NOT.OBJACT(X)) CALL RSPSB2(466,ODO2,RMK)
      RETURN
C
C V139-- KILL
C
39000 I=467
      GO TO 41100
C
C V140-- SWING
C
40000 J=PRSO
      PRSO=PRSI
      PRSI=J
      J=ODO2
      ODO2=ODI2
      ODI2=J
      PRSA=ATTACW
C
C V141-- ATTACK
C
41000 I=468
C
C COMMON MUNG/ATTACK/SWING/KILL CODE.
C
41100 IF(PRSO.NE.0) GO TO 41200
      CALL RSPEAK(469)
      RETURN
C
41200 IF(OBJACT(X)) RETURN
      IF((OFLAG2(PRSO).AND.VILLBT).NE.0) GO TO 41300
      IF((OFLAG1(PRSO).AND.VICTBT).EQ.0)
     1CALL RSPSUB(470,ODO2)
      RETURN
C
41300 J=471
      IF(PRSI.EQ.0) GO TO 41500
      IF((OFLAG2(PRSI).AND.WEAPBT).EQ.0) GO TO 41400
      MELEE=1
      IF(PRSI.NE.SWORD) MELEE=2
      I=BLOW(PLAYER,PRSO,MELEE,.TRUE.,0)
      RETURN
C
41400 J=472
41500 CALL RSPSB2(I,ODO2,J)
      RETURN
C VAPPLI, PAGE 10
C
C V142-- WALK
C
42000 VAPPLI=WALK(X)
      RETURN
C
C V143-- TELL
C
43000 CALL RSPEAK(603)
      PRSCON=0
      RETURN
C
C V144-- PUT
C
44000 VAPPLI=PUT(.TRUE.)
      RETURN
C
C V145,V146,V147,V148-- DROP/GIVE/POUR/THROW
C
45000 CONTINUE
46000 CONTINUE
47000 CONTINUE
48000 VAPPLI=DROP(.TRUE.)
      RETURN
C
C V149-- SAVE
C
49000 IF((RFLAG(TSTRS).AND.RSEEN).EQ.0) GO TO 49100
      CALL RSPEAK(828)
      RETURN
C
49100 CALL SAVEGM
      PRSWON=.FALSE.
      PRSCON=0
      RETURN
C
C V150-- RESTORE
C
50000 IF((RFLAG(TSTRS).AND.RSEEN).EQ.0) GO TO 50100
      CALL RSPEAK(829)
      RETURN
C
50100 CALL RSTRGM
      PRSWON=.FALSE.
      PRSCON=0
      RETURN
C VAPPLI, PAGE 11
C
C V151-- HELLO
C
51000 IF(PRSO.NE.0) GO TO 51100
      CALL RSPEAK(346+RND(4))
      RETURN
C
51100 IF(PRSO.NE.AVIAT) GO TO 51200
      CALL RSPEAK(350)
      RETURN
C
51200 IF(PRSO.NE.SAILO) GO TO 51300
      HS=HS+1
      I=351
      IF(MOD(HS,10).EQ.0) I=352
      IF(MOD(HS,20).EQ.0) I=353
      CALL RSPEAK(I)
      RETURN
C
51300 IF(OBJACT(X)) RETURN
      I=354
      IF((OFLAG2(PRSO).AND.(VILLBT+ACTRBT)).EQ.0) I=355
      CALL RSPSUB(I,ODO2)
      RETURN
C
C V152-- LOOK INTO
C
52000 IF(OBJACT(X)) RETURN
      IF((OFLAG1(PRSO).AND.DOORBT).EQ.0) GO TO 52300
      IF(.NOT.QOPEN(PRSO)) GO TO 52200
      CALL RSPSUB(628,ODO2)
      RETURN
C
52200 CALL RSPSUB(525,ODO2)
      RETURN
C
52300 IF((OFLAG1(PRSO).AND.CONTBT).NE.0) GO TO 52500
      IF(QOPEN(PRSO)) GO TO 52400
      CALL RSPSUB(630,ODO2)
      RETURN
C
52400 IF(.NOT.QEMPTY(PRSO)) GO TO 52700
      CALL RSPSUB(1054,ODO2)
      RETURN
C
52500 IF(QOPEN(PRSO).OR.((OFLAG1(PRSO).AND.TRANBT).NE.0))
     1GO TO 52600
      CALL RSPSUB(525,ODO2)
      RETURN
C
52600 IF(QEMPTY(PRSO)) GO TO 52800
52700 CALL PRINCO(PRSO,573,.TRUE.)
      RETURN
C
52800 CALL RSPSUB(629,ODO2)
      RETURN
C VAPPLI, PAGE 12
C
C V153-- LOOK UNDER
C
53000 IF(.NOT.OBJACT(X)) CALL RSPEAK(631)
      RETURN
C
C V154-- PUMP
C
54000 IF((OROOM(PUMP).EQ.HERE).OR.(OADV(PUMP).EQ.WINNER))
     1GO TO 54100
      CALL RSPEAK(632)
      RETURN
C
54100 PRSI=PUMP
      PRSA=INFLAW
      GO TO 2000
C
C V155-- WIND
C
55000 IF(.NOT.OBJACT(X)) CALL RSPSUB(634,ODO2)
      RETURN
C
C V156-- CLIMB
C V157-- CLIMB UP
C V158-- CLIMB DOWN
C
56000 CONTINUE
57000 CONTINUE
58000 IF(OBJACT(X)) RETURN
      I=XUP
      IF(PRSA.EQ.CLMBDW) I=XDOWN
      F=(OFLAG2(PRSO).AND.CLMBBT).NE.0
      IF(F.AND.FINDXT(I,HERE)) GO TO 58500
      I=657
      IF(F) I=524
      IF(.NOT.F .AND.((PRSO.EQ.WALL).OR.(PRSO.EQ.GRWAL).OR.
     1((PRSO.GE.WNORT).AND.(PRSO.LE.WNORT+3))))
     2I=656
      CALL RSPEAK(I)
      RETURN
C
58500 PRSA=WALKW
      PRSO=I
      GO TO 42000
C VAPPLI, PAGE 13
C
C V160-- POUR ON
C
60000 IF(PRSO.NE.WATER) GO TO 60500
      IF(OBJACT(X)) RETURN
      CALL NEWSTA(WATER,0,0,0,0)
      IF(OCAN(PRSI).NE.RECEP) GO TO 60100
      CALL RSPSUB(977,ODI2)
      RETURN
C
60100 IF((OFLAG1(PRSI).AND.(LITEBT+FLAMBT+ONBT)).NE.
     1(LITEBT+FLAMBT+ONBT)) GO TO 60300
      IF(PRSO.NE.TORCH) GO TO 60200
      CALL RSPEAK(978)
      RETURN
C
60200 OFLAG1(PRSI)=OFLAG1(PRSI).AND..NOT.ONBT
      CALL RSPSUB(979,ODI2)
      IF(PRSI.EQ.CANDL) CFLAG(CEVCND)=.FALSE.
      IF(PRSI.EQ.MATCH) CTICK(CEVMAT)=0
      GO TO 50
C
60300 CALL RSPSUB(980,ODI2)
      RETURN
C
60500 CALL RSPEAK(981)
      RETURN
C
C V161-- PUT UNDER
C
61000 IF(OBJACT(X)) RETURN
      I=1037
      IF((OFLAG1(PRSO).AND.DOORBT).NE.0) I=982
      CALL RSPEAK(I)
      RETURN
C
C V162-- UNTIE FROM
C
62000 IF(((PRSO.EQ.BROPE).AND.(BTIEF.NE.0)).OR.
     1  ((PRSO.EQ.ROPE).AND.(DOMEF.OR.(TTIE.EQ.PRSI))))
     2  GO TO 62100
      CALL RSPEAK(1006)
      RETURN
C
62100 PRSA=UNTIEW
      GO TO 13000
C VAPPLI, PAGE 14
C
C V163-- MAKE
C V169-- WISH
C
63000 IF(PRSO.NE.GWISH) GO TO 10
69000 IF(HERE.NE.BWELL) GO TO 63100
      IF(OROOM(BAGCO).EQ.HERE) GO TO 63200
      IF(OROOM(ZORKM).EQ.HERE) GO TO 63300
63100 CALL RSPEAK(937)
      RETURN
C
63200 CALL NEWSTA(BAGCO,938,0,0,0)
      RETURN
C
63300 CALL NEWSTA(ZORKM,938,0,0,0)
      RETURN
C
C V164-- OIL
C
64000 IF(PRSI.NE.PUTTY) GO TO 64100
      IF(OBJACT(X)) RETURN
      CALL RSPEAK(904)
      RETURN
C
64100 CALL RSPEAK(905)
      RETURN
C
C V165-- PLAY
C
65000 IF(PRSO.NE.STRAD) GO TO 65200
      IF((OFLAG2(PRSI).AND.WEAPBT).EQ.0) GO TO 65100
      OTVAL(STRAD)=0
      CALL RSPEAK(933)
      RETURN
C
65100 CALL RSPEAK(934)
      RETURN
C
65200 IF((OFLAG2(PRSO).AND.VILLBT).EQ.0) GO TO 10
      CALL RSPSUB(935,ODO2)
      CALL JIGSUP(0)
      RETURN
C
C V166-- SEND
C
66000 IF(OBJACT(X)) RETURN
      I=940
      IF((OFLAG2(PRSO).AND.VILLBT).NE.0) I=941
      CALL RSPSUB(I,ODO2)
      RETURN
C VAPPLI, PAGE 15
C
C V167-- ENTER
C
67000 PRSA=WALKW
      PRSO=XENTER
      GO TO 42000
C
C V168-- LEAVE
C
68000 PRSA=WALKW
      PRSO=XEXIT
      GO TO 42000
C
C V65-- ROOM
C
65001 VAPPLI=RMDESC(2)
      RETURN
C
C V66-- OBJECTS
C
66001 VAPPLI=RMDESC(1)
      IF(.NOT.TELFLG) CALL RSPEAK(138)
      RETURN
C
C V67-- RNAME
C
67001 CALL RSPEAK(RDESC2-HERE)
      RETURN
C
C V68-- SQUEEZE
C
68001 IF(OBJACT(X)) RETURN
      I=901
      IF((OFLAG2(PRSO).AND.VILLBT).NE.0) I=902
      CALL RSPSUB(I,ODO2)
      RETURN
C
C V69-- SMELL
C
69001 CALL RSPSUB(903,ODO2)
      RETURN
C VAPPLI, PAGE 16
C
C V70-- BRIEF
C
70000 BRIEFF=.TRUE.
      SUPERF=.FALSE.
      CALL RSPEAK(326)
      RETURN
C
C V71-- VERBOSE
C
71000 BRIEFF=.FALSE.
      SUPERF=.FALSE.
      CALL RSPEAK(327)
      RETURN
C
C V72-- SUPERBRIEF
C
72000 SUPERF=.TRUE.
      CALL RSPEAK(328)
      RETURN
C
C V73-- STAY (USED IN ENDGAME)
C
73000 IF(WINNER.NE.AMASTR) GO TO 73100
      CALL RSPEAK(781)
      CTICK(CEVFOL)=0
      RETURN
C
73100 IF(WINNER.EQ.PLAYER) CALL RSPEAK(664)
      RETURN
C
C V74-- VERSION
C
74000 WRITE(OUTCH,74010) VMAJ,VMIN,VEDIT
74010 FORMAT(' V',I1,'.',I2,A)
      TELFLG=.TRUE.
      RETURN
C
C V75-- SWIM
C
75000 I=330
      IF((RFLAG(HERE).AND.(RWATER+RFILL)).EQ.0)
     1I=331+RND(3)
      CALL RSPEAK(I)
      RETURN
C
C V76-- GERONIMO
C
76000 IF(AVEHIC(WINNER).EQ.BARRE) GO TO 76100
      CALL RSPEAK(334)
      RETURN
C
76100 CALL JIGSUP(335)
      RETURN
C
C V77-- SINBAD ET AL
C
77000 IF((HERE.EQ.MCYCL).AND.QHERE(CYCLO,HERE)) GO TO 77100
      CALL RSPEAK(336)
      RETURN
C
77100 CALL NEWSTA(CYCLO,337,0,0,0)
      CYCLOF=.TRUE.
      MAGICF=.TRUE.
      OFLAG2(CYCLO)=OFLAG2(CYCLO).AND. .NOT.FITEBT
      RETURN
C
C V78-- UNUSED
C
78000 GO TO 10
C
C V79-- PRAY
C
79000 IF(HERE.NE.TEMP2) GO TO 79050
      IF(MOVETO(FORE1,WINNER)) GO TO 79100
79050 CALL RSPEAK(340)
      RETURN
C
79100 F=RMDESC(3)
      RETURN
C
C V80-- TREASURE
C
80000 IF(HERE.NE.TEMP1) GO TO 80050
      IF(MOVETO(TREAS,WINNER)) GO TO 79100
80050 CALL RSPEAK(341)
      RETURN
C
C V81-- TEMPLE
C
81000 IF(HERE.NE.TREAS) GO TO 81050
      IF(MOVETO(TEMP1,WINNER)) GO TO 79100
81050 CALL RSPEAK(341)
      RETURN
C
C V82-- BLAST
C
82000 I=342
      IF(PRSO.EQ.SAFE) I=252
      CALL RSPEAK(I)
      RETURN
C
C V83-- SCORE
C
83000 CALL SCORE(.FALSE.)
      RETURN
C
C V84-- QUIT
C
84000 CALL SCORE(.TRUE.)
      IF(.NOT.YESNO(343,10,0)) RETURN
      CALL EXIT
C VAPPLI, PAGE 17
C
C V85-- FOLLOW (USED IN ENDGAME)
C
85000 IF(WINNER.NE.AMASTR) GO TO 85100
      CALL RSPEAK(782)
      CFLAG(CEVFOL)=.TRUE.
      CTICK(CEVFOL)=-1
      RETURN
C
85100 I=10
      IF(PRSO.EQ.0) GO TO 85200
      I=964
      IF((OFLAG2(PRSO).AND.VILLBT).NE.0) I=965
85200 CALL RSPEAK(I)
      RETURN
C
C V86-- WALK THROUGH
C
86000 IF(OBJACT(X)) RETURN
      IF((SCOLRM.EQ.0).OR.((PRSO.NE.SCOL).AND.
     1((PRSO.NE.WNORT).OR.(HERE.NE.BKBOX)))) GO TO 86100
      SCOLAC=SCOLRM
      PRSO=0
      CFLAG(CEVSCL)=.TRUE.
      CTICK(CEVSCL)=6
      CALL RSPEAK(668)
      F=MOVETO(SCOLRM,WINNER)
      F=RMDESC(0)
      RETURN
C
86100 IF(HERE.NE.SCOLAC) GO TO 86300
      DO 86200 I=1,12,3
        IF((SCOLWL(I).EQ.HERE).AND.(SCOLWL(I+1).EQ.PRSO))
     1GO TO 86500
86200 CONTINUE
C
86300 IF((OFLAG1(PRSO).AND.TAKEBT).NE.0) GO TO 86400
      I=669
      IF(PRSO.EQ.SCOL) I=670
      CALL RSPSUB(I,ODO2)
      RETURN
C
86400 I=671
      IF(OROOM(PRSO).NE.0) I=552+RND(6)
      CALL RSPEAK(I)
      RETURN
C
86500 PRSO=SCOLWL(I+2)
      DO 86600 I=1,8,2
        IF(PRSO.EQ.SCOLDR(I)) SCOLRM=SCOLDR(I+1)
86600 CONTINUE
      CTICK(CEVSCL)=0
      CALL RSPEAK(668)
      F=MOVETO(BKBOX,WINNER)
      F=RMDESC(0)
      RETURN
C
C V87-- RING
C
87000 IF(OBJACT(X)) RETURN
      I=359
      IF(PRSO.EQ.BELL) I=360
      CALL RSPEAK(I)
      RETURN
C
C V88-- BRUSH
C
88000 IF(PRSO.EQ.TEETH) GO TO 88100
      CALL RSPEAK(362)
      RETURN
C
88100 IF(PRSI.NE.0) GO TO 88200
      CALL RSPEAK(363)
      RETURN
C
88200 IF((PRSI.EQ.PUTTY).AND.(OADV(PUTTY).EQ.WINNER))
     1GO TO 88300
      CALL RSPSUB(364,ODI2)
      RETURN
C
88300 CALL JIGSUP(365)
      RETURN
C VAPPLI, PAGE 18
C
C V89-- DIG
C
89000 IF(PRSI.NE.SHOVE) GO TO 89100
      VAPPLI=OBJACT(X)
      RETURN
C
89100 I=392
      IF((OFLAG1(PRSO).AND.TOOLBT).EQ.0) I=393
      CALL RSPSUB(I,ODO2)
      RETURN
C
C V90-- TIME
C
90000 CALL GTTIME(K)
      I=K/60
      J=MOD(K,60)
C NOS: ONE WRITE PER CASE, SINCE FTN5 HAS NO "$" EDIT DESCRIPTOR.
      HRS='HOURS'
      IF(I.EQ.1) HRS='HOUR'
      MNS='MINUTES.'
      IF(J.EQ.1) MNS='MINUTE.'
      IF(I.EQ.0) WRITE(OUTCH,90010) J,MNS(1:NBLEN(MNS))
      IF(I.NE.0) WRITE(OUTCH,90011) I,HRS(1:NBLEN(HRS)),J,
     1MNS(1:NBLEN(MNS))
      TELFLG=.TRUE.
      RETURN
C
90010 FORMAT(' YOU HAVE BEEN PLAYING DUNGEON FOR ',I2,1X,A)
90011 FORMAT(' YOU HAVE BEEN PLAYING DUNGEON FOR ',I3,1X,A,' AND ',
     1I2,1X,A)
C
C V91-- LEAP
C
91000 IF(PRSO.EQ.0) GO TO 91200
      IF(QHERE(PRSO,HERE)) GO TO 91100
      CALL RSPEAK(447)
      RETURN
C
91100 IF((OFLAG2(PRSO).AND.VILLBT).EQ.0) GO TO 91300
      CALL RSPSUB(448,ODO2)
      RETURN
C
91200 IF(.NOT.FINDXT(XDOWN,HERE)) GO TO 91300
      IF((XTYPE.EQ.XNO).OR.((XTYPE.EQ.XCOND).AND.
     1.NOT.FLAGS(XFLAG))) GO TO 91400
91300 CALL RSPEAK(314+RND(5))
      RETURN
C
91400 CALL JIGSUP(449+RND(4))
      RETURN
C VAPPLI, PAGE 19
C
C V92-- LOCK
C
92000 IF(OBJACT(X)) RETURN
      IF((PRSO.EQ.GRATE).AND..NOT.QOPEN(GRATE).AND.(HERE.EQ.MGRAT))
     1GO TO 92200
92100 CALL RSPEAK(464)
      RETURN
C
92200 GRUNLF=.FALSE.
      CALL RSPEAK(214)
      TRAVEL(REXIT(HERE)+1)=214
      RETURN
C
C V93-- UNLOCK
C
93000 IF(OBJACT(X)) RETURN
      IF((PRSO.NE.GRATE).OR.(HERE.NE.MGRAT))
     1GO TO 92100
      IF(PRSI.EQ.KEYS) GO TO 93200
      CALL RSPSUB(465,ODI2)
      RETURN
C
93200 GRUNLF=.TRUE.
      CALL RSPEAK(217)
      TRAVEL(REXIT(HERE)+1)=1041
      RETURN
C
C V94-- DIAGNOSE
C
94000 I=FIGHTS(WINNER,.FALSE.)
      J=ASTREN(WINNER)
      K=MIN0(I+J,4)
      IF(.NOT.CFLAG(CEVCUR)) J=0
      L=MIN0(4,IABS(J))
      CALL RSPEAK(473+L)
      I=(30*(-J-1))+CTICK(CEVCUR)
      IF(J.NE.0) WRITE(OUTCH,94100) I
94100 FORMAT(' YOU WILL BE CURED AFTER ',I3,' MOVES.')
      CALL RSPEAK(478+K)
      IF(DEATHS.NE.0) CALL RSPEAK(482+DEATHS)
      RETURN
C VAPPLI, PAGE 20
C
C V95-- INCANT
C
95000 IF(WINNER.NE.PLAYER) GO TO 10
      IF(SUBLNT.EQ.0) GO TO 95350
      PW(1)=' '
      PW(2)=' '
      WP=1
      CP=1
      DO 95200 I=1,SUBLNT
        IF(SUBBUF(I:I).NE.' ') GO TO 95150
        IF(CP.EQ.1) GO TO 95200
        WP=MIN0(2,WP+1)
        CP=1
        GO TO 95200
95150   IF(CP.LE.WRDLNT) PW(WP)(CP:CP)=SUBBUF(I:I)
        CP=CP+1
95200 CONTINUE
C
      IF(PW(1).NE.' ') GO TO 95400
95350 CALL RSPEAK(856)
95375 PRSCON=0
      RETURN
C
95400 CALL ENCRYP(PW(1),CH)
      IF(PW(2).NE.' ') GO TO 95600
C
      IF(SPELLF) GO TO 95550
      IF((RFLAG(TSTRS).AND.RSEEN).EQ.0) GO TO 95575
      SPELLF=.TRUE.
      TELFLG=.TRUE.
      WRITE(OUTCH,95510) PW(1),CH
95510 FORMAT(' A HOLLOW VOICE REPLIES:  "',A,1X,A,'".')
      RETURN
C
95550 CALL RSPEAK(857)
      GO TO 95375
C
95575 CALL RSPEAK(858)
      GO TO 95375
C
95600 IF((RFLAG(TSTRS).AND.RSEEN).NE.0) GO TO 95800
      IF(PW(2).NE.CH) GO TO 95900
      SPELLF=.TRUE.
      CALL RSPEAK(859)
      CFLAG(CEVSTE)=.TRUE.
      CTICK(CEVSTE)=1
      RETURN
C
95800 CALL RSPEAK(855)
      GO TO 95375
C
95900 CALL RSPEAK(1052)
      GO TO 95375
C VAPPLI, PAGE 21
C
C V96-- ANSWER
C
96000 IF(WINNER.NE.PLAYER) GO TO 10
      IF(SUBLNT.EQ.0) GO TO 96050
      IF((HERE.EQ.RIDDL).AND..NOT.RIDDLF) GO TO 96700
      IF((HERE.EQ.FDOOR).AND.INQSTF) GO TO 96100
96050 CALL RSPEAK(799)
      PRSCON=0
      RETURN
C
96100 K=1
      DO 96300 J=1,28,2
        NEWK=K+ANSWER(J+1)
        IF(QUESNO.NE.ANSWER(J)) GO TO 96300
        IF(SUBBUF.EQ.ANSSTR(K:NEWK-1)) GO TO 96500
96300 K=NEWK
C
      PRSCON=0
      NQATT=NQATT+1
      IF(NQATT.GE.5) GO TO 96400
      CALL RSPEAK(800+NQATT)
      RETURN
C
96400 CALL RSPEAK(826)
      CFLAG(CEVINQ)=.FALSE.
      RETURN
C
96500 CORRCT=CORRCT+1
      CALL RSPEAK(800)
      IF(CORRCT.GE.3) GO TO 96600
      CFLAG(CEVINQ)=.TRUE.
      CTICK(CEVINQ)=2
      QUESNO=MOD(QUESNO+3,8)
      NQATT=0
      CALL RSPEAK(769)
      CALL RSPEAK(770+QUESNO)
      RETURN
C
96600 CALL RSPEAK(827)
      CFLAG(CEVINQ)=.FALSE.
      OFLAG2(QDOOR)=OFLAG2(QDOOR).OR.OPENBT
      RETURN
C
96700 IF(SUBBUF.NE.'WELL') GO TO 96050
      RIDDLF=.TRUE.
      CALL RSPEAK(338)
      RETURN
C
      END
C TAKE-- BASIC TAKE SEQUENCE
C
C TAKE AN OBJECT (FOR VERBS TAKE, PUT, DROP, READ, ETC.)
C
      LOGICAL FUNCTION TAKE(FLG)
C
C DECLARATIONS
C
      IMPLICIT INTEGER (A-Z)
      LOGICAL FLG,OBJACT,OAPPLI,QOPEN,QHERE
*CALL DPARAM
C
C FUNCTIONS AND DATA
C
      QOPEN(O)=(OFLAG2(O).AND.OPENBT).NE.0
C TAKE, PAGE 2
C
      IF((PRSO.LE.STRBIT).AND.
     1 ((OFLAG2(PRSO).AND.NOCHBT).EQ.0)) GO TO 100
      TAKE=OBJACT(X)
      RETURN
C
  100 TAKE=.FALSE.
      X=OCAN(PRSO)
      IF((PRSI.EQ.0).OR.(PRSI.EQ.X)) GO TO 200
      CALL RSPEAK(1038)
      RETURN
C
  200 IF(PRSO.NE.AVEHIC(WINNER)) GO TO 400
      CALL RSPEAK(672)
      RETURN
C
  400 OA=OACTIO(PRSO)
      IF((OFLAG1(PRSO).AND.TAKEBT).NE.0) GO TO 500
      IF(.NOT.OAPPLI(OA,0)) CALL RSPEAK(552+RND(6))
      RETURN
C
C OBJECT IS TAKEABLE AND IN POSITION TO BE TAKEN.
C
  500 IF((X.NE.0).OR. QHERE(PRSO,HERE)) GO TO 600
      IF(OADV(PRSO).EQ.WINNER) CALL RSPEAK(103)
      RETURN
C
  600 IF(((X.NE.0).AND.(OADV(X).EQ.WINNER)).OR.
     1((WEIGHT(0,PRSO,WINNER)+OSIZE(PRSO)).LE.MXLOAD))
     2GO TO 700
      CALL RSPEAK(558)
      PRSCON=0
      RETURN
C
  700 TAKE=.TRUE.
      IF(OAPPLI(OA,0)) RETURN
      CALL NEWSTA(PRSO,0,0,0,WINNER)
      OFLAG2(PRSO)=OFLAG2(PRSO).OR.TCHBT
      CALL SCRUPD(OFVAL(PRSO))
      OFVAL(PRSO)=0
      IF(FLG) CALL RSPEAK(559)
      RETURN
C
      END
C DROP- DROP VERB PROCESSOR
C
C DECLARATIONS
C
      LOGICAL FUNCTION DROP(FLG)
      IMPLICIT INTEGER (A-Z)
*CALL DPARAM
      LOGICAL F,PUT,OBJACT,FLG
C
      IF((OFLAG2(PRSO).AND.NOCHBT).EQ.0) GO TO 100
      DROP=OBJACT(X)
      RETURN
C
  100 DROP=.TRUE.
      X=OCAN(PRSO)
      IF(X.EQ.0) GO TO 200
      IF(OADV(X).NE.WINNER) GO TO 1000
      IF((OFLAG2(X).AND.OPENBT).NE.0) GO TO 300
      CALL RSPSUB(525,ODESC2(X))
      RETURN
C
  200 IF(OADV(PRSO).NE.WINNER) GO TO 1000
  300 IF(AVEHIC(WINNER).EQ.0) GO TO 400
      PRSI=AVEHIC(WINNER)
      F=PUT(.TRUE.)
      PRSI=0
      RETURN
C
  400 CALL NEWSTA(PRSO,0,HERE,0,0)
      CALL SCRUPD(OFVAL(PRSO))
      OFVAL(PRSO)=0
      OFLAG2(PRSO)=OFLAG2(PRSO).OR.TCHBT
C
      IF(OBJACT(X)) RETURN
      IF(PRSA.EQ.DROPW) CALL RSPEAK(528)
      IF(PRSA.EQ.THROWW) CALL RSPEAK(529)
      RETURN
C
 1000 CALL RSPEAK(527)
      RETURN
C
      END
C PUT- PUT VERB PROCESSOR
C
C DECLARATIONS
C
      LOGICAL FUNCTION PUT(FLG)
      IMPLICIT INTEGER (A-Z)
*CALL DPARAM
      LOGICAL QOPEN,QHERE,OBJACT,FLG,TAKE
C
C FUNCTIONS AND DATA
C
      QOPEN(R)=(OFLAG2(R).AND.OPENBT).NE.0
C PUT, PAGE 2
C
      IF((OFLAG2(PRSO).AND.NOCHBT).EQ.0) GO TO 100
      PUT=OBJACT(X)
      RETURN
C
  100 PUT=.FALSE.
      IF((PRSO.LE.STRBIT).AND.(PRSI.LE.STRBIT)) GO TO 200
      IF(.NOT.OBJACT(X)) CALL RSPEAK(560)
      PUT=.TRUE.
      RETURN
C
  200 IF(QOPEN(PRSI).OR.((OFLAG1(PRSI).AND.(DOORBT+CONTBT)).NE.0)
     1.OR.((OFLAG2(PRSI).AND.VEHBT).NE.0)) GO TO 300
      CALL RSPEAK(561)
      RETURN
C
  300 IF(QOPEN(PRSI)) GO TO 400
      CALL RSPEAK(562)
      RETURN
C
  400 IF(PRSO.NE.PRSI) GO TO 500
      CALL RSPEAK(563)
      RETURN
C
  500 IF(OCAN(PRSO).NE.PRSI) GO TO 600
      CALL RSPSB2(564,ODESC2(PRSO),ODESC2(PRSI))
      PUT=.TRUE.
      RETURN
C
  600 IF((WEIGHT(0,PRSO,0)+WEIGHT(0,PRSI,0)+OSIZE(PRSO))
     1.LE.OCAPAC(PRSI)) GO TO 700
      IF(PRSI.NE.AVEHIC(WINNER)) GO TO 650
      CALL RSPSUB(889,ODESC2(PRSI))
      RETURN
C
  650 CALL RSPEAK(565)
      RETURN
C
C NOW SEE IF OBJECT (OR ITS CONTAINER) IS IN ROOM
C
  700 J=PRSO
  725 IF(QHERE(J,HERE)) GO TO 750
      J=OCAN(J)
      IF(J.NE.0) GO TO 725
      GO TO 800
C
  750 IF((PRSO.EQ.WATER).OR.(PRSO.EQ.GWATE)) GO TO 800
      SVO=PRSO
      SVI=PRSI
      PRSA=TAKEW
      PRSI=0
      IF(.NOT.TAKE(.FALSE.)) RETURN
      PRSA=PUTW
      PRSO=SVO
      PRSI=SVI
      GO TO 1000
C
C NOW SEE IF OBJECT IS ON PERSON.
C
  800 IF(OCAN(PRSO).EQ.0) GO TO 1000
      IF(QOPEN(OCAN(PRSO))) GO TO 900
      CALL RSPSUB(566,ODESC2(PRSO))
      RETURN
C
  900 CALL SCRUPD(OFVAL(PRSO))
      OFVAL(PRSO)=0
      OFLAG2(PRSO)=OFLAG2(PRSO).OR.TCHBT
      CALL NEWSTA(PRSO,0,0,0,WINNER)
C
 1000 IF(OBJACT(X)) RETURN
      CALL NEWSTA(PRSO,2,0,PRSI,0)
      PUT=.TRUE.
      RETURN
C
      END
C VALUAC- HANDLES VALUABLES/EVERYTHING/POSSESSIONS/BUNCH OBJECT
C
C DECLARATIONS
C
      SUBROUTINE VALUAC(V)
      IMPLICIT INTEGER (A-Z)
*CALL DPARAM
      LOGICAL LIT,F,F1,TAKE,PUT,DROP,NOTHIS,QHERE,QBUNCH
C
C FUNCTIONS AND DATA
C
      NOTHIS(R)=((SAVEP.EQ.BUNOBJ).AND.QBUNCH(R)) .OR.
     1  ((OTVAL(R).LE.0).AND.((SAVEP.EQ.VALUA).OR.
     2   ((SAVEP.EQ.BUNOBJ).AND.(BUNSUB.EQ.VALUA)))) .OR.
     3  ((OADV(R).NE.WINNER).AND.((SAVEP.EQ.POSSE).OR.
     4   ((SAVEP.EQ.BUNOBJ).AND.(BUNSUB.EQ.POSSE))))
C VALUAC, PAGE 2
C
      SAVEP=PRSO
      SAVEH=HERE
      F=.TRUE.
      I=579
      IF(.NOT.LIT(HERE)) GO TO 4000
      I=677
C
  100 IF(PRSA.NE.TAKEW) GO TO 1000
      IF((PRSO.NE.BUNOBJ).OR.(BUNSUB.NE.0)) GO TO 400
      DO 300 I=1,BUNLNT
        PRSO=BUNVEC(I)
        F=.FALSE.
        CALL RSPSUB(580,ODESC2(PRSO))
        F1=TAKE(.TRUE.)
        IF(SAVEH.NE.HERE) GO TO 4500
  300 CONTINUE
      GO TO 3000
C
  400 DO 500 PRSO=1,OLNT
        IF((((OFLAG1(PRSO).AND.TAKEBT).EQ.0).AND.
     1((OFLAG2(PRSO).AND.TRYBT).EQ.0)).OR.
     2((OFLAG1(PRSO).AND.VISIBT).EQ.0).OR.
     3((OFLAG2(PRSO).AND.ACTRBT).NE.0).OR.
     4NOTHIS(PRSO)) GO TO 500
        IF(QHERE(PRSO,HERE)) GO TO 450
        J=OCAN(PRSO)
        IF(J.EQ.0) GO TO 500
        IF(((OFLAG2(J).AND.OPENBT).EQ.0).OR.
     1    (.NOT.QHERE(J,HERE).AND.(OADV(J).NE.WINNER)))
     2    GO TO 500
  450   F=.FALSE.
        CALL RSPSUB(580,ODESC2(PRSO))
        F1=TAKE(.TRUE.)
        IF(SAVEH.NE.HERE) GO TO 4500
  500 CONTINUE
      GO TO 3000
C
 1000 IF(PRSA.NE.DROPW) GO TO 2000
      IF((PRSO.NE.BUNOBJ).OR.(BUNSUB.NE.0)) GO TO 1400
      DO 1300 I=1,BUNLNT
        PRSO=BUNVEC(I)
        F=.FALSE.
        CALL RSPSUB(580,ODESC2(PRSO))
        F1=DROP(.TRUE.)
        IF(SAVEH.NE.HERE) GO TO 4500
 1300 CONTINUE
      GO TO 3000
C
 1400 DO 1500 PRSO=1,OLNT
        IF((OADV(PRSO).NE.WINNER).OR.NOTHIS(PRSO))
     1GO TO 1500
        F=.FALSE.
        CALL RSPSUB(580,ODESC2(PRSO))
        F1=DROP(.TRUE.)
        IF(SAVEH.NE.HERE) GO TO 4500
 1500 CONTINUE
      GO TO 3000
C VALUAC, PAGE 2
C
 2000 IF(PRSA.NE.PUTW) GO TO 4000
      IF((PRSO.NE.BUNOBJ).OR.(BUNSUB.NE.0)) GO TO 2400
      DO 2300 I=1,BUNLNT
        PRSO=BUNVEC(I)
        F=.FALSE.
        CALL RSPSUB(580,ODESC2(PRSO))
        F1=PUT(.TRUE.)
        IF(SAVEH.NE.HERE) GO TO 4500
 2300 CONTINUE
      GO TO 3000
C
 2400 DO 2500 PRSO=1,OLNT
        IF(((OADV(PRSO).NE.WINNER).AND.
     1(.NOT.QHERE(PRSO,HERE).OR.
     2(((OFLAG1(PRSO).AND.TAKEBT).EQ.0).AND.
     3 ((OFLAG2(PRSO).AND.TRYBT).EQ.0)))).OR.
     4(PRSO.EQ.PRSI).OR.NOTHIS(PRSO).OR.
     5((OFLAG1(PRSO).AND.VISIBT).EQ.0)) GO TO 2500
        F=.FALSE.
        CALL RSPSUB(580,ODESC2(PRSO))
        F1=PUT(.TRUE.)
        IF(SAVEH.NE.HERE) GO TO 4500
 2500 CONTINUE
C
 3000 I=581
      IF(SAVEP.EQ.VALUA) I=582
 4000 IF(F) CALL RSPEAK(I)
 4500 PRSO=SAVEP
      BUNSUB=0
      RETURN
      END
C QBUNCH- IS OBJECT IN BUNCH VECTOR?
C
C DECLARATIONS
C
      LOGICAL FUNCTION QBUNCH(OBJ)
      IMPLICIT INTEGER(A-Z)
*CALL DPARAM
C
      IF(BUNLNT.EQ.0) GO TO 200
      QBUNCH=.TRUE.
      DO 100 I=1,BUNLNT
        IF(OBJ.EQ.BUNVEC(I)) RETURN
  100 CONTINUE
  200 QBUNCH=.FALSE.
      RETURN
C
      END
C SAVE- SAVE GAME STATE
C
C DECLARATIONS
C
      SUBROUTINE SAVEGM
      IMPLICIT INTEGER (A-Z)
*CALL DPARAM
      CHARACTER*7 FNAME
      LOGICAL SVNAME
C
      IF(.NOT.SVNAME(FNAME)) GO TO 100
      OPEN (UNIT=1,FILE=FNAME(1:NBLEN(FNAME)),ACCESS='SEQUENTIAL',
     1STATUS='UNKNOWN',FORM='UNFORMATTED',ERR=100)
      REWIND 1
C
      CALL GTTIME(I)
      WRITE(1) VMAJ,VMIN
      WRITE(1) WINNER,HERE,THFPOS,TELFLG,THFFLG,THFACT,
     1SWDACT,SWDSTA,CPVEC
      WRITE(1) I,MOVES,DEATHS,RWSCOR,EGSCOR,MXLOAD,
     1LTSHFT,BLOC,MUNGRM,HS,FROMDR,SCOLRM,SCOLAC
      WRITE(1) ODESC1,ODESC2,OFLAG1,OFLAG2,OFVAL,OTVAL,
     1OSIZE,OCAPAC,OROOM,OADV,OCAN
      WRITE(1) RDESC1,RVAL,RFLAG,TRAVEL
      WRITE(1) AROOM,ASCORE,AVEHIC,ASTREN,AFLAG
      WRITE(1) FLAGS,SWITCH,VPROB,CFLAG,CTICK,CCNCEL
C
      REWIND 1
      CLOSE(UNIT=1,STATUS='KEEP')
C NOS: KEEP THE SAVE IN THE PLAYER'S PERMANENT FILE CATALOG, SO IT
C OUTLIVES THE SESSION LIKE A FILE ON VMS WOULD.  NA AND RC MAKE PF
C RETURN A CODE INSTEAD OF ABORTING THE GAME (FTN5 MANUAL TABLE 8-1).
      CALL PF('REPLACE',FNAME(1:NBLEN(FNAME)),FNAME(1:NBLEN(FNAME)),
     1'NA','N','RC',RC)
      IF(RC.NE.0) GO TO 100
      CALL RSPEAK(597)
      RETURN
C
  100 CALL RSPEAK(598)
      RETURN
      END
C RESTORE- RESTORE GAME STATE
C
C DECLARATIONS
C
      SUBROUTINE RSTRGM
      IMPLICIT INTEGER (A-Z)
*CALL DPARAM
      CHARACTER*7 FNAME
      LOGICAL SVNAME
C
      IF(.NOT.SVNAME(FNAME)) GO TO 100
C NOS: FETCH THE SAVE FROM THE PLAYER'S CATALOG (SEE SAVEGM).  A
C NONZERO CODE MEANS THERE IS NO SUCH FILE, OR IT CAN'T BE READ.
      CALL PF('GET',FNAME(1:NBLEN(FNAME)),FNAME(1:NBLEN(FNAME)),
     1'NA','N','RC',RC)
      IF(RC.NE.0) GO TO 100
      OPEN (UNIT=1,FILE=FNAME(1:NBLEN(FNAME)),ACCESS='SEQUENTIAL',
     1STATUS='OLD',FORM='UNFORMATTED',ERR=100)
      REWIND 1
C
      READ(1,ERR=100,END=100) I,J
      IF((I.NE.VMAJ).OR.(J.NE.VMIN)) GO TO 200
C
      READ(1) WINNER,HERE,THFPOS,TELFLG,THFFLG,THFACT,
     1SWDACT,SWDSTA,CPVEC
      READ(1) PLTIME,MOVES,DEATHS,RWSCOR,EGSCOR,MXLOAD,
     1LTSHFT,BLOC,MUNGRM,HS,FROMDR,SCOLRM,SCOLAC
      READ(1) ODESC1,ODESC2,OFLAG1,OFLAG2,OFVAL,OTVAL,
     1OSIZE,OCAPAC,OROOM,OADV,OCAN
      READ(1) RDESC1,RVAL,RFLAG,TRAVEL
      READ(1) AROOM,ASCORE,AVEHIC,ASTREN,AFLAG
      READ(1) FLAGS,SWITCH,VPROB,CFLAG,CTICK,CCNCEL
C
      CALL RSPEAK(599)
      CLOSE(UNIT=1,STATUS='KEEP')
      RETURN
C
  100 CALL RSPEAK(598)
      RETURN
C
  200 CALL RSPEAK(600)
      CLOSE(UNIT=1,STATUS='KEEP')
      RETURN
      END
C SVNAME- NOS: PICK THE SAVE FILE NAME
C
C THE PLAYER MAY GIVE A FILE NAME WITH SAVE OR RESTORE (IT ARRIVES IN
C SUBBUF).  IT IS USED AS BOTH THE LOCAL AND THE PERMANENT FILE NAME,
C SO IT MUST BE 1 TO 7 LETTERS AND DIGITS STARTING WITH A LETTER;
C ANYTHING ELSE IS REFUSED.  THE DEFAULT IS DSAVE.
C
      LOGICAL FUNCTION SVNAME(FNAME)
      IMPLICIT INTEGER (A-Z)
*CALL DPARAM
      CHARACTER*(*) FNAME
      CHARACTER*1 C
C
      SVNAME=.TRUE.
      FNAME='DSAVE'
      IF(SUBLNT.EQ.0) RETURN
      SVNAME=.FALSE.
      IF(SUBLNT.GT.7) RETURN
      DO 100 I=1,SUBLNT
        C=SUBBUF(I:I)
        IF((C.GE.'A').AND.(C.LE.'Z')) GO TO 100
        IF(I.EQ.1) RETURN
        IF((C.LT.'0').OR.(C.GT.'9')) RETURN
  100 CONTINUE
      FNAME=SUBBUF(1:SUBLNT)
      SVNAME=.TRUE.
      RETURN
      END
C WALK- MOVE IN SPECIFIED DIRECTION
C
C DECLARATIONS
C
      LOGICAL FUNCTION WALK(X)
      IMPLICIT INTEGER(A-Z)
*CALL DPARAM
      LOGICAL FINDXT,QOPEN,LIT,PROB,MOVETO,RMDESC
C
C FUNCTIONS AND DATA
C
      QOPEN(O)=(OFLAG2(O).AND.OPENBT).NE.0
C WALK, PAGE 2
C
      WALK=.TRUE.
      IF((WINNER.NE.PLAYER).OR.LIT(HERE).OR.PROB(25,25))
     1GO TO 500
      IF(.NOT.FINDXT(PRSO,HERE)) GO TO 450
      GO TO (400,200,100,300),XTYPE
      CALL BUG(9,XTYPE)
C
  100 IF(CXAPPL(XACTIO).NE.0) GO TO 400
      IF(FLAGS(XFLAG)) GO TO 400
  200 CALL JIGSUP(523)
      RETURN
C
  300 IF(CXAPPL(XACTIO).NE.0) GO TO 400
      IF(QOPEN(XOBJ)) GO TO 400
      CALL JIGSUP(523)
      RETURN
C
  400 IF(LIT(XROOM1)) GO TO 900
  450 CALL JIGSUP(522)
      RETURN
C
C ROOM IS LIT, OR WINNER IS NOT PLAYER (NO GRUE).
C
  500 IF(FINDXT(PRSO,HERE)) GO TO 550
  525 XSTRNG=678
      IF(PRSO.EQ.XUP) XSTRNG=679
      IF(PRSO.EQ.XDOWN) XSTRNG=680
      IF((RFLAG(HERE).AND.RNWALL).NE.0) XSTRNG=524
      CALL RSPEAK(XSTRNG)
      PRSCON=0
      RETURN
C
  550 GO TO (900,600,700,800),XTYPE
      CALL BUG(9,XTYPE)
C
  700 IF(CXAPPL(XACTIO).NE.0) GO TO 900
      IF(FLAGS(XFLAG)) GO TO 900
  600 IF(XSTRNG.EQ.0) GO TO 525
      CALL RSPEAK(XSTRNG)
      PRSCON=0
      RETURN
C
  800 IF(CXAPPL(XACTIO).NE.0) GO TO 900
      IF(QOPEN(XOBJ)) GO TO 900
      IF(XSTRNG.EQ.0) XSTRNG=525
      CALL RSPSUB(XSTRNG,ODESC2(XOBJ))
      PRSCON=0
      RETURN
C
  900 WALK=MOVETO(XROOM1,WINNER)
      IF(WALK) WALK=RMDESC(0)
      RETURN
      END
C CXAPPL- CONDITIONAL EXIT PROCESSORS
C
C DECLARATIONS
C
      INTEGER FUNCTION CXAPPL(RI)
      IMPLICIT INTEGER (A-Z)
*CALL DPARAM
C
      CXAPPL=0
      IF(RI.EQ.0) RETURN
      GO TO (1000,2000,3000,4000,5000,6000,7000,8000,
     19000,10000,11000,12000,13000,14000,15000),RI
      CALL BUG(5,RI)
C CXAPPL, PAGE 2
C
C C1- COFFIN-CURE
C
 1000 EGYPTF=OADV(COFFI).NE.WINNER
      RETURN
C
C C2- CAROUSEL EXIT
C C5- CAROUSEL OUT
C
 2000 IF(CAROFF) RETURN
 2500 CALL RSPEAK(121)
 5000 I=XELNT(XCOND)*RND(8)
      XROOM1=(TRAVEL(REXIT(HERE)+I)).AND.XRMASK
      CXAPPL=XROOM1
      RETURN
C
C C3- CHIMNEY FUNCTION
C
 3000 LITLDF=.FALSE.
      IF(DEADF) GO TO 3300
      J=0
      DO 3100 I=1,OLNT
        IF(OADV(I).EQ.WINNER) J=J+1
 3100 CONTINUE
C
      IF(J.GT.2) RETURN
      IF(J.NE.0) GO TO 3200
      XSTRNG=890
      RETURN
C
 3200 IF(OADV(LAMP).NE.WINNER) GO TO 3300
      XSTRNG=446
      RETURN
C
 3300 LITLDF=.TRUE.
      IF((OFLAG2(DOOR).AND.OPENBT).EQ.0)
     1OFLAG2(DOOR)=OFLAG2(DOOR).AND. .NOT.TCHBT
      RETURN
C
C C4- FROBOZZ FLAG (MAGNET ROOM, FAKE EXIT)
C C6- FROBOZZ FLAG (MAGNET ROOM, REAL EXIT)
C
 4000 IF(CAROFF) GO TO 2500
      FROBZF=.FALSE.
      RETURN
C
 6000 IF(CAROFF) GO TO 2500
      FROBZF=.TRUE.
      RETURN
C CXAPPL, PAGE 3
C
C C7- FROBOZZ FLAG (BANK ALARM)
C
 7000 FROBZF=.FALSE.
      J=BILLS
 7100 IF(OADV(J).EQ.WINNER) RETURN
      J=OCAN(J)
      IF(J.NE.0) GO TO 7100
      J=PORTR
 7200 IF(OADV(J).EQ.WINNER) RETURN
      J=OCAN(J)
      IF(J.NE.0) GO TO 7200
      FROBZF=.TRUE.
      RETURN
C
C C8- FROBOZZ FLAG (MRGO)
C
 8000 FROBZF=.FALSE.
      IF(MLOC.NE.XROOM1) GO TO 8100
      IF((PRSO.EQ.XNORTH).OR.(PRSO.EQ.XSOUTH)) GO TO 8200
      IF(MOD(MDIR,180).NE.0) GO TO 8300
      XROOM1=((XROOM1-MRA)*2)+MRAE
      IF(PRSO.GT.XSOUTH) XROOM1=XROOM1+1
 8100 CXAPPL=XROOM1
      RETURN
C
 8200 XSTRNG=814
      IF(MOD(MDIR,180).EQ.0) RETURN
 8300 LDIR=MDIR
      IF(PRSO.EQ.XSOUTH) LDIR=180
      XSTRNG=815
      IF(((LDIR.GT.180).AND..NOT.MR1F).OR.
     1  ((LDIR.LT.180).AND..NOT.MR2F)) XSTRNG=816
      RETURN
C
C C9- FROBOZZ FLAG (MIRIN)
C
 9000 IF(MRHERE(HERE).NE.1) GO TO 9100
      IF(MR1F) XSTRNG=805
      FROBZF=MROPNF
      RETURN
C
 9100 FROBZF=.FALSE.
      XSTRNG=817
      RETURN
C CXAPPL, PAGE 4
C
C C10- FROBOZZ FLAG (MIRROR EXIT)
C
10000 FROBZF=.FALSE.
      LDIR=((PRSO-XNORTH)/XNORTH)*45
      IF(.NOT.MROPNF .OR.
     1((MOD(MDIR+270,360).NE.LDIR).AND.(PRSO.NE.XEXIT)))
     2GO TO 10200
      XROOM1=((MLOC-MRA)*2)+MRAE+1-(MDIR/180)
      IF(MOD(MDIR,180).EQ.0) GO TO 10100
      XROOM1=MLOC+1
      IF(MDIR.GT.180) XROOM1=MLOC-1
10100 CXAPPL=XROOM1
      RETURN
C
10200 IF(.NOT.WDOPNF .OR.
     1((MOD(MDIR+180,360).NE.LDIR).AND.(PRSO.NE.XEXIT)))
     2RETURN
      XROOM1=MLOC+1
      IF(MDIR.EQ.0) XROOM1=MLOC-1
      CALL RSPEAK(818)
      WDOPNF=.FALSE.
      CXAPPL=XROOM1
      RETURN
C
C C11- MAYBE DOOR.  NORMAL MESSAGE IS THAT DOOR IS CLOSED.
C BUT IF LCELL.NE.4, DOOR ISN'T THERE.
C
11000 IF(LCELL.NE.4) XSTRNG=678
      RETURN
C
C C12- FROBOZZ FLAG (PUZZLE ROOM MAIN ENTRANCE)
C
12000 FROBZF=.TRUE.
      CPHERE=10
      RETURN
C
C C13- CPOUTF (PUZZLE ROOM SIZE ENTRANCE)
C
13000 CPHERE=52
      RETURN
C CXAPPL, PAGE 5
C
C C14- FROBOZZ FLAG (PUZZLE ROOM TRANSITIONS)
C
14000 FROBZF=.FALSE.
      IF(PRSO.NE.XUP) GO TO 14100
      IF(CPHERE.NE.10) RETURN
      XSTRNG=881
      IF(CPVEC(CPHERE+1).NE.-2) RETURN
      CALL RSPEAK(882)
      RFLAG(CPUZZ)=RFLAG(CPUZZ).AND..NOT.RSEEN
      FROBZF=.TRUE.
      RETURN
C
14100 IF((CPHERE.NE.52).OR.(PRSO.NE.XWEST).OR..NOT.CPOUTF)
     1GO TO 14200
      RFLAG(CPUZZ)=RFLAG(CPUZZ).AND..NOT.RSEEN
      FROBZF=.TRUE.
      RETURN
C
14200 IF((CPHERE.NE.52).OR.(PRSO.NE.XWEST)) GO TO 14250
      XSTRNG=932
      RETURN
C
14250 DO 14300 I=1,16,2
        IF(PRSO.EQ.CPDR(I)) GO TO 14400
14300 CONTINUE
      RETURN
C
14400 J=CPDR(I+1)
      NXT=CPHERE+J
      K=8
      IF(J.LT.0) K=-8
      IF((((IABS(J).EQ.1).OR.(IABS(J).EQ.8)).OR.
     1   ((CPVEC(CPHERE+K).EQ.0).OR.(CPVEC(NXT-K).EQ.0))).AND.
     2    (CPVEC(NXT).EQ.0)) GO TO 14500
      RETURN
C
14500 CALL CPGOTO(NXT)
      XROOM1=CPUZZ
      CXAPPL=XROOM1
      RETURN
C
C C15- FROBOZZ FLAG (SLIDE EXIT)
C
15000 FROBZF=.TRUE.
      IF((TTIE.EQ.0).OR.DEADF) RETURN
      IF(OROOM(TTIE).NE.HERE) RETURN
      CALL RSPEAK(1014)
      CFLAG(CEVSLI)=.TRUE.
      CTICK(CEVSLI)=MAX0(2,100/WEIGHT(0,0,WINNER))
      XROOM1=SLID1
      CXAPPL=XROOM1
      RETURN
C
      END
*DECK VMSSUBR
C OPERATING SYSTEM DEPENDENT SUBROUTINES -- NOS 2 / FTN5 VERSION.
C
C COPYRIGHT 1980, 1990, INFOCOM COMPUTERS AND COMMUNICATIONS, CAMBRIDGE 
C ALL RIGHTS RESERVED, COMMERCIAL USAGE STRICTLY PROHIBITED
C WRITTEN BY R. M. SUPNIK
C
C THE VMS ORIGINAL USED SYS$NUMTIM AND RAN.  HERE THE FTN5 CLOCK AND
C DATE SUBROUTINES SUPPLY THE TIME AND DATE AS 10 CHARACTER STRINGS
C ("HH.MM.SS." AND "YY/MM/DD.", POSSIBLY WITH A LEADING BLANK), AND THE
C RANF/RANSET INTRINSICS SUPPLY RANDOM NUMBERS.
C
C ITIME - RETURN SYSTEM TIME IN COMPONENT FORM
C
      SUBROUTINE ITIME (H, M, S)
      IMPLICIT INTEGER (A-Z)
      CHARACTER*10 T
      CALL CLOCK (T)
      CALL DIGIT3 (T, H, M, S)
      RETURN
      END
C
C IDATE - RETURN SYSTEM DATE IN COMPONENT FORM (MONTH, DAY, YEAR)
C
      SUBROUTINE IDATE (M, D, Y)
      IMPLICIT INTEGER (A-Z)
      CHARACTER*10 T
      CALL DATE (T)
      CALL DIGIT3 (T, Y, M, D)
      RETURN
      END
C
C DIGIT3 - PICK THE FIRST THREE NUMBERS OUT OF A STRING
C
      SUBROUTINE DIGIT3 (STR, A, B, C)
      IMPLICIT INTEGER (A-Z)
      CHARACTER*(*) STR
      INTEGER V(3)
      V(1) = 0
      V(2) = 0
      V(3) = 0
      N = 0
      CUR = -1
      DO 100 I = 1, LEN(STR)+1
        D = -1
        IF (I .LE. LEN(STR)) D = INDEX('0123456789', STR(I:I)) - 1
        IF (D .GE. 0) THEN
          IF (CUR .LT. 0) CUR = 0
          CUR = CUR*10 + D
        ELSE IF (CUR .GE. 0) THEN
          N = N + 1
          IF (N .LE. 3) V(N) = CUR
          CUR = -1
        END IF
  100 CONTINUE
      A = V(1)
      B = V(2)
      C = V(3)
      RETURN
      END
C
C RND - RETURN A RANDOM INTEGER MOD N
C
      INTEGER FUNCTION RND (N)
      IMPLICIT INTEGER (A-Z)
      RND = RANF()*FLOAT(N)
      RETURN
      END
C
C INIRND - INITIALIZE RANDOM NUMBER SEED
C
      SUBROUTINE INIRND (LOW, HIGH)
      IMPLICIT INTEGER (A-Z)
      RNSEED = OR(SHIFT(HIGH,16)+LOW, 1)
      CALL RANSET (RNSEED)
      RETURN
      END
