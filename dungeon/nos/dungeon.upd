     1 XEAST,XEAST,XWEST,XWEST,
     2 XSE,XSW,XNE,XNW,
     3 XUP,XUP,XDOWN,XDOWN,
     4 XLAUN,XLAND,XEXIT,XEXIT,
     5 XCROSS,XENTER,XCROSS,0,0/
