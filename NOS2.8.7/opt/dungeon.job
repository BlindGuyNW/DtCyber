~*
~*  This job builds DUNGEON (the FORTRAN Zork, V3.0A) from the source
~*  converted in ../../dungeon. It creates an UPDATE program library
~*  from the creation deck, compiles all decks with FTN5, links the
~*  absolute program, saves the program, program library and the two
~*  data files in INSTALL's catalog (dungeon.post moves the program and
~*  data files to LIBRARY), plays a few moves from INPUT as a smoke
~*  test (its SAVE leaves a DSAVE in INSTALL's catalog, purged after),
~*  edits the DUNGEON startup procedure into the PRODUCT file,
~*  and adds a directive to DIRFILE specifying that PROC/DUNGEON should
~*  be inserted into the deadstart file library number associated with
~*  other games.
~*
DUNGEON.
$USER,INSTALL,${../site.cfg:PASSWORDS:INSTALL:INSTALL}.
$NORERUN.
$SETTL,*.
$SETASL,*.
$SETJSL,*.
$COPYBR,INPUT,DIR.
$COPYBR,INPUT,PROC.
$COPYBR,INPUT,SOURCE.
$COPYBR,INPUT,DINDX.
$COPYBR,INPUT,DTEXT.
$REWIND,DIR,PROC,SOURCE,DINDX,DTEXT.
$UPDATE,P=0,N=DUNGPL,C=COMPILE,F,I=SOURCE.
$REWIND,COMPILE.
$FTN5,I=COMPILE,L=OUTPUT,B=LGO.
$REWIND,LGO.
$LOAD,LGO.
$NOGO,DUNGEON.
$PURGE,DUNGEON,DUNGPL,DINDX,DTEXT/NA.
$SAVE,DUNGEON,DUNGPL,DINDX,DTEXT.
$REWIND,DUNGEON,DINDX,DTEXT.
DUNGEON.
$PURGE,DSAVE/NA.
$ATTACH,PRODUCT,DIRFILE/M=W,WB.
$LIBEDIT,P=PRODUCT,B=PROC,I=0,C.
$LIBEDIT,P=DIRFILE,B=DIR,I=0,C.
***
*** DUNGEON COMPLETE
***
EXIT.
***
*** DUNGEON FAILED
***
~eor
DUNGEON
*ADD LIB${1},PROC/DUNGEON
~eor
~include dungeon.proc
~eor
~include ../../dungeon/nos/dungeon.upd
~eor
~include ../../dungeon/nos/dindx.txt
~eor
~include ../../dungeon/nos/dtext.txt
~eor
LOOK
INVENTORY
OPEN MAILBOX
TAKE LEAFLET
READ LEAFLET
HELLO
TAKE MAILBOX
SAVE
DROP LEAFLET
INVENTORY
RESTORE
INVENTORY
SCORE
TIME
QUIT
Y
