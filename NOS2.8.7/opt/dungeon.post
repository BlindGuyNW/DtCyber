#!/usr/bin/env node
//
// Copy the DUNGEON program and its data files to the LIBRARY catalog
//

const DtCyber = require("../../automation/DtCyber");

const dtc = new DtCyber();

dtc.connect()
.then(() => dtc.expect([ {re:/Operator> $/} ]))
.then(() => dtc.dis([
  "GET,DUNGEON,DINDX,DTEXT.",
  "PURGE,DUNGEON,DINDX,DTEXT.",
  "SUI,377776.",
  "PURGE,DUNGEON,DINDX,DTEXT/NA.",
  "SAVE,DUNGEON,DINDX,DTEXT/CT=PU,AC=Y."
], 1))
.then(() => {
  process.exit(0);
})
.catch(err => {
  console.log(err);
  process.exit(1);
});
