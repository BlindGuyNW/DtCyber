#!/usr/bin/env node
//
// Copy the CHESS 4.9 openings library to the LIBRARY catalog
//

const DtCyber = require("../../automation/DtCyber");

const dtc = new DtCyber();

dtc.connect()
.then(() => dtc.expect([ {re:/Operator> $/} ]))
.then(() => dtc.dis([
  "GET,CHESBK.",
  "PURGE,CHESBK.",
  "SUI,377776.",
  "PURGE,CHESBK/NA.",
  "SAVE,CHESBK/CT=PU,AC=Y."
], 1))
.then(() => {
  process.exit(0);
})
.catch(err => {
  console.log(err);
  process.exit(1);
});
